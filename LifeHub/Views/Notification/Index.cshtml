@model LifeHub.Models.ViewModels.SystemManagement.NotificationPageViewModel
@{
    ViewData["Title"] = "Thông báo";
    ViewData["ActivePage"] = "Notification";
}

<section class="notification-page">
    <header class="notification-heading">
        <div>
            <p class="notification-eyebrow">CẬP NHẬT</p>
            <h1>Thông báo</h1>
            <p>Bạn có @Model.UnreadCount thông báo chưa đọc.</p>
        </div>
        @if (Model.UnreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                <button type="submit" class="notification-secondary">Đánh dấu tất cả đã đọc</button>
            </form>
        }
    </header>

    @if (Model.Items.Count == 0)
    {
        <div class="notification-empty">
            <span aria-hidden="true">🔔</span>
            <h2>Chưa có thông báo</h2>
            <p>Khi có lời mời hoặc cập nhật mới, thông báo sẽ xuất hiện ở đây.</p>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var item in Model.Items)
            {
                <article class="notification-card @(item.IsRead ? "is-read" : "is-unread")">
                    <div class="notification-dot" aria-hidden="true"></div>
                    <div class="notification-content">
                        <div class="notification-title-row">
                            <span class="notification-type type-@item.Group"><span aria-hidden="true">@item.TypeIcon</span>@item.TypeLabel</span>
                            <h2>@item.Title</h2>
                            @if (!item.IsRead)
                            {
                                <span class="notification-new">Mới</span>
                            }
                        </div>
                        <p>@item.Message</p>
                        <time datetime="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time>

                        @if (item.InvitationId.HasValue)
                        {
                            <div class="notification-actions">
                                <form asp-controller="Project" asp-action="AcceptInvitation" method="post">
                                    <input type="hidden" name="projectId" value="@item.ProjectId" />
                                    <input type="hidden" name="invitationId" value="@item.InvitationId.Value" />
                                    <button type="submit" class="notification-primary">Chấp nhận lời mời</button>
                                </form>
                                <form asp-controller="Project" asp-action="DeclineInvitation" method="post">
                                    <input type="hidden" name="projectId" value="@item.ProjectId" />
                                    <input type="hidden" name="invitationId" value="@item.InvitationId.Value" />
                                    <button type="submit" class="notification-secondary">Từ chối</button>
                                </form>
                                <a class="notification-link" href="@Url.Action("Details", "Project", new { id = item.ProjectId })">Xem dự án</a>
                            </div>
                        }
                        else if (item.InvitationStatus != null)
                        {
                            var invitationState = item.InvitationStatus switch
                            {
                                "pending" => "Lời mời này đã hết hạn.",
                                "accepted" => "Lời mời đã được chấp nhận.",
                                "declined" => "Lời mời đã bị từ chối.",
                                "cancelled" => "Lời mời đã được người quản lý hủy.",
                                _ => "Lời mời không còn hiệu lực."
                            };
                            <p class="notification-expired">@invitationState</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(item.LinkUrl))
                        {
                            <a class="notification-link" href="@item.LinkUrl">Mở nội dung</a>
                        }
                    </div>
                    @if (!item.IsRead)
                    {
                        <form asp-action="MarkRead" method="post" class="notification-read-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="notification-read-button">Đánh dấu đã đọc</button>
                        </form>
                    }
                </article>
            }
        </div>
    }
</section>

<style>
    .notification-page{max-width:1050px;margin:0 auto;padding:32px 28px 56px;color:#1e293b}
    .notification-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}
    .notification-heading h1{font-size:30px;margin:0 0 6px;font-weight:750}
    .notification-heading p{margin:0;color:#64748b}
    .notification-eyebrow{font-size:11px;letter-spacing:.16em;color:#e11d48!important;font-weight:700;margin-bottom:7px!important}
    .notification-list{display:grid;gap:12px}
    .notification-card{display:flex;align-items:flex-start;gap:14px;background:#fff;border:1px solid #e8edf4;border-radius:16px;padding:20px;box-shadow:0 5px 20px #0f172a08}
    .notification-card.is-unread{border-color:#fecdd3;background:#fffafb}
    .notification-dot{width:9px;height:9px;border-radius:50%;background:#e11d48;margin-top:7px;flex:none}
    .is-read .notification-dot{background:#cbd5e1}
    .notification-content{flex:1;min-width:0}
    .notification-title-row{display:flex;align-items:center;gap:10px}
    .notification-title-row h2{font-size:16px;margin:0;font-weight:700}
    .notification-type{display:inline-flex;align-items:center;gap:6px;flex:none;border-radius:999px;padding:5px 9px;font-size:11px;font-weight:700;white-space:nowrap}
    .notification-type.type-project{color:#6d28d9;background:#ede9fe}
    .notification-type.type-reminder{color:#0369a1;background:#e0f2fe}
    .notification-type.type-finance{color:#047857;background:#d1fae5}
    .notification-type.type-system{color:#475569;background:#f1f5f9}
    .notification-content p{margin:8px 0;color:#475569;line-height:1.5}
    .notification-content time{font-size:12px;color:#94a3b8}
    .notification-new{font-size:10px;text-transform:uppercase;letter-spacing:.06em;color:#be123c;background:#ffe4e6;padding:4px 7px;border-radius:999px;font-weight:700}
    .notification-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:14px}
    .notification-actions form,.notification-heading form{margin:0}
    .notification-primary,.notification-secondary{border:0;border-radius:9px;padding:9px 13px;font:inherit;font-size:13px;font-weight:650;cursor:pointer}
    .notification-primary{background:#e11d48;color:white}
    .notification-secondary{background:#f1f5f9;color:#334155}
    .notification-link{color:#be123c;font-size:13px;font-weight:650;text-decoration:none;padding:8px}
    .notification-read-form{margin-left:auto;flex:none}
    .notification-read-button{border:0;background:transparent;color:#64748b;font:inherit;font-size:12px;cursor:pointer;padding:4px}
    .notification-expired{font-size:12px!important;color:#94a3b8!important;margin-top:10px!important}
    .notification-empty{text-align:center;background:#fff;border:1px dashed #cbd5e1;border-radius:18px;padding:60px 20px;color:#64748b}
    .notification-empty>span{font-size:32px}.notification-empty h2{color:#1e293b;margin:12px 0 6px;font-size:20px}.notification-empty p{margin:0}
    @@media(max-width:640px){.notification-page{padding:24px 16px}.notification-heading{align-items:flex-start;flex-direction:column}.notification-card{padding:16px;flex-wrap:wrap}.notification-read-form{width:100%;margin-left:23px}.notification-read-button{padding-left:0}}
</style>
