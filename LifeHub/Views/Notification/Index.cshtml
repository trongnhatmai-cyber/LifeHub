    @@media(max-width:640px){.notification-page{padding:24px 16px}.notification-heading{align-items:flex-start;flex-direction:column}.notification-card{padding:16px;flex-wrap:wrap}.notification-read-form{width:100%;margin-left:23px}.notification-read-button{padding-left:0}}
</style>



















































