@model LifeHub.Models.ViewModels.SystemManagement.NotificationPageViewModel
@{
    ViewData["Title"] = "Thông báo";
    ViewData["ActivePage"] = "Notification";
}

<section class="notification-page">
    <header class="notification-heading">
        <div>
            <p class="notification-eyebrow">CẬP NHẬT</p>
            <h1>Thông báo</h1>
            <p>Bạn có @Model.UnreadCount thông báo chưa đọc.</p>
        </div>
        @if (Model.UnreadCount > 0)
        {
            <form asp-action="MarkAllRead" method="post">
                <button type="submit" class="notification-secondary">Đánh dấu tất cả đã đọc</button>
            </form>
        }
    </header>

    @if (Model.Items.Count == 0)
    {
        <div class="notification-empty">
            <span aria-hidden="true">🔔</span>
            <h2>Chưa có thông báo</h2>
            <p>Khi có lời mời hoặc cập nhật mới, thông báo sẽ xuất hiện ở đây.</p>
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var item in Model.Items)
            {
                <article class="notification-card @(item.IsRead ? "is-read" : "is-unread")">
                    <div class="notification-dot" aria-hidden="true"></div>
                    <div class="notification-content">
                        <div class="notification-title-row">
                            <span class="notification-type type-@item.Group"><span aria-hidden="true">@item.TypeIcon</span>@item.TypeLabel</span>
                            <h2>@item.Title</h2>
                            @if (!item.IsRead)
                            {
                                <span class="notification-new">Mới</span>
                            }
                        </div>
                        <p>@item.Message</p>
                        <time datetime="@item.CreatedAt.ToString("O")">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</time>

                        @if (item.InvitationId.HasValue)
                        {
                            <div class="notification-actions">
                                <form asp-controller="Project" asp-action="AcceptInvitation" method="post">
                                    <input type="hidden" name="projectId" value="@item.ProjectId" />
                                    <input type="hidden" name="invitationId" value="@item.InvitationId.Value" />
                                    <button type="submit" class="notification-primary">Chấp nhận lời mời</button>
                                </form>
                                <form asp-controller="Project" asp-action="DeclineInvitation" method="post">
                                    <input type="hidden" name="projectId" value="@item.ProjectId" />
                                    <input type="hidden" name="invitationId" value="@item.InvitationId.Value" />
                                    <button type="submit" class="notification-secondary">Từ chối</button>
                                </form>
                                <a class="notification-link" href="@Url.Action("Details", "Project", new { id = item.ProjectId })">Xem dự án</a>
                            </div>
                        }
                        else if (item.InvitationStatus != null)
                        {
                            var invitationState = item.InvitationStatus switch
                            {
                                "pending" => "Lời mời này đã hết hạn.",
                                "accepted" => "Lời mời đã được chấp nhận.",
                                "declined" => "Lời mời đã bị từ chối.",
                                "cancelled" => "Lời mời đã được người quản lý hủy.",
                                _ => "Lời mời không còn hiệu lực."
                            };
                            <p class="notification-expired">@invitationState</p>
                        }
                        else if (!string.IsNullOrWhiteSpace(item.LinkUrl))
                        {
                            <a class="notification-link" href="@item.LinkUrl">Mở nội dung</a>
                        }
                    </div>
                    @if (!item.IsRead)
                    {
                        <form asp-action="MarkRead" method="post" class="notification-read-form">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="notification-read-button">Đánh dấu đã đọc</button>
                        </form>
                    }
                </article>
            }
        </div>
    }
</section>

<style>
    .notification-page{max-width:1050px;margin:0 auto;padding:32px 28px 56px;color:#1e293b}
    .notification-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:24px}
