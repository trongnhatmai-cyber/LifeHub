<!-- MODAL: TẠO DỰ ÁN (dùng ở Index và All) -->
<div class="project-modal" id="createProjectModal" role="dialog" aria-modal="true" aria-labelledby="createProjectTitle" hidden>
    <div class="project-modal-box">
        <div class="project-modal-head">
            <div>
                <h3 id="createProjectTitle">Tạo dự án mới</h3>
                <p class="project-sub">Bạn sẽ là Manager (trưởng nhóm) của dự án này.</p>
            </div>
            <button type="button" class="project-modal-close" data-modal-close aria-label="Đóng">×</button>
        </div>

        <form method="post" asp-controller="Project" asp-action="Create" data-reset-on-open>
            <div class="field">
                <label for="newProjectName">Tên dự án *</label>
                <input type="text" id="newProjectName" name="name" class="project-input" maxlength="80" required placeholder="VD: Website nhóm NET108" />
            </div>

            <div class="field">
                <label for="newProjectKey">Mã dự án (2–6 ký tự, bỏ trống để tự tạo)</label>
                <input type="text" id="newProjectKey" name="key" class="project-input" maxlength="6" placeholder="VD: NET" />
            </div>

            <div class="field">
                <label for="newProjectDesc">Mô tả</label>
                <textarea id="newProjectDesc" name="description" class="project-input" rows="3" maxlength="300" placeholder="Mục tiêu và phạm vi của dự án"></textarea>
            </div>

            <div class="project-form-row">
                <div class="field">
                    <label for="newProjectStart">Ngày bắt đầu *</label>
                    <input type="date" id="newProjectStart" name="startDate" class="project-input" required data-date-start />
                </div>
                <div class="field">
                    <label for="newProjectDue">Hạn chót *</label>
                    <input type="date" id="newProjectDue" name="dueDate" class="project-input" required data-date-end />
                </div>
            </div>

            <div class="field">
                <label for="newProjectStatus">Trạng thái ban đầu</label>
                <select id="newProjectStatus" name="status" class="project-input">
                    <option value="Lên kế hoạch">Lên kế hoạch</option>
                    <option value="Đang chạy">Đang chạy</option>
                </select>
            </div>

            <p class="project-note" data-form-note hidden></p>

            <div class="project-modal-foot">
                <button type="button" class="project-btn" data-modal-close>Hủy</button>
                <button type="submit" class="project-btn primary">Tạo dự án</button>
            </div>
        </form>
    </div>
</div>