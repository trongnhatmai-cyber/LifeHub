@model LifeHub.Models.ViewModels.ProjectManagement.ProjectDetailViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.Name;
    ViewData["ActivePage"] = "ProjectList";

    var d = Model;
    var assignable = d.Members.Where(x => x.Role != "Viewer").ToList();
    var allTasks = d.Columns.SelectMany(c => c.Tasks).ToList();
    var priorities = new[] { ("low", "Thấp"), ("medium", "Trung bình"), ("high", "Cao"), ("urgent", "Khẩn cấp") };
    var dragTask = d.CanEdit ? "true" : "false";
    var canEditText = d.CanEdit ? "true" : "false";
    var canManageText = d.CanManage ? "true" : "false";
    var nextMilestone = d.Milestones.Where(x => !x.IsCompleted).OrderBy(x => x.DueDate).FirstOrDefault();
    var attentionTasks = allTasks.Where(t => t.StatusKey != "done" && (t.IsOverdue || t.PriorityKey == "urgent")).Take(5).ToList();
    var msDoneCount = d.Milestones.Count(x => x.IsCompleted);
    var timeAgo = new Func<DateTime, string>(LifeHub.Models.ViewModels.ProjectManagement.ProjectDisplay.TimeAgo);
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" asp-append-version="true" />
}

<div class="project-page" id="projectDetail"
     data-project-id="@d.Id" data-user-id="@d.CurrentUserId" data-user-name="@d.CurrentUserName"
     data-can-manage="@canManageText" data-can-edit="@canEditText">

    <partial name="_Flash" />

    <nav class="project-breadcrumb" aria-label="Điều hướng">
        <a asp-action="Index">Dự án</a><span>/</span><span>@d.Name</span>
    </nav>

    <!-- TIÊU ĐỀ -->
    <header class="project-heading">
        <div>
            <span class="project-label">@d.Key · Vai trò @d.CurrentRole</span>
            <h1>@d.Name</h1>
            <p>@d.Description</p>
        </div>

        <div class="heading-actions">
            @if (d.CanManage)
            {
                <form method="post" asp-action="UpdateStatus" class="inline-form">
                    <input type="hidden" name="projectId" value="@d.Id" />
                    <select name="status" class="project-input project-select" aria-label="Trạng thái dự án" data-autosubmit>
                        @foreach (var st in new[] { "Đang chạy", "Lên kế hoạch", "Tạm dừng", "Hoàn thành" })
                        {
                            <option value="@st" selected="@(st == d.Status)">@st</option>
                        }
                    </select>
                </form>
                <button type="button" class="project-btn" data-modal-open="inviteModal">+ Mời thành viên</button>
            }
            @if (d.CanEdit)
            {
                <button type="button" class="project-btn primary" data-modal-open="createTaskModal" data-prefill-status="todo">+ Tạo nhiệm vụ</button>
            }
        </div>
    </header>

    <!-- TIẾN ĐỘ (tự cập nhật khi kéo thả) -->
    <section class="detail-stats">
        <div class="summary-card">
            <div class="summary-top"><span>Tiến độ</span><span class="status st-@d.StatusKey">@d.Status</span></div>
            <h2 id="statProgress">@d.ProgressPercent%</h2>
            <div class="project-progress"><div class="bar"><i id="statProgressBar" style="width:@d.ProgressPercent%;"></i></div></div>
        </div>
        <div class="summary-card">
            <div class="summary-top"><span>Nhiệm vụ hoàn thành</span><span class="summary-badge">TASKS</span></div>
            <h2><span id="statDone">@d.CompletedTasks</span>/<span id="statTotal">@d.TotalTasks</span></h2>
            <p>Nhiệm vụ cấp cao nhất</p>
        </div>
        <div class="summary-card">
            <div class="summary-top"><span>Hạn chót</span><span class="summary-badge">DEADLINE</span></div>
            <h2>@d.DueDate.ToString("dd/MM/yyyy")</h2>
            <p>@d.DueText</p>
        </div>
    </section>

    <!-- TAB WORKSPACE -->
    <div class="ws-tabs" role="tablist" aria-label="Khu vực làm việc của dự án">
        <button type="button" role="tab" class="ws-tab" id="tab-overview" aria-controls="panel-overview" aria-selected="true" data-ws-tab="overview">Tổng quan</button>
        <button type="button" role="tab" class="ws-tab" id="tab-board" aria-controls="panel-board" aria-selected="false" tabindex="-1" data-ws-tab="board">Bảng</button>
        <button type="button" role="tab" class="ws-tab" id="tab-list" aria-controls="panel-list" aria-selected="false" tabindex="-1" data-ws-tab="list">Danh sách <span class="chip-count">@allTasks.Count</span></button>
        <button type="button" role="tab" class="ws-tab" id="tab-milestones" aria-controls="panel-milestones" aria-selected="false" tabindex="-1" data-ws-tab="milestones">Cột mốc <span class="chip-count">@msDoneCount/@d.Milestones.Count</span></button>
        <button type="button" role="tab" class="ws-tab" id="tab-members" aria-controls="panel-members" aria-selected="false" tabindex="-1" data-ws-tab="members">Thành viên <span class="chip-count">@d.Members.Count</span></button>
        <button type="button" role="tab" class="ws-tab" id="tab-activity" aria-controls="panel-activity" aria-selected="false" tabindex="-1" data-ws-tab="activity">Hoạt động</button>
    </div>

    <div class="ws-panel" role="tabpanel" id="panel-overview" aria-labelledby="tab-overview" data-ws-panel="overview">
        <div class="project-overview-grid">
            <section class="project-card">
                <div class="section-heading">
                    <div>
                        <h3>Tiến độ công việc</h3>
                        <p>@d.CompletedTasks/@d.TotalTasks nhiệm vụ đã hoàn thành.</p>
                    </div>
                    <a href="#" class="project-link" data-ws-go="board">Mở bảng →</a>
                </div>
                <div class="project-progress-head"><span>Tiến độ dự án</span><span class="project-progress-value">@d.ProgressPercent%</span></div>
                <div class="bar"><i style="width:@d.ProgressPercent%;"></i></div>

                <div class="project-meta-pair">
                    <div><strong>@d.StartDate.ToString("dd/MM/yyyy")</strong>Ngày bắt đầu</div>
                    <div><strong>@d.DueDate.ToString("dd/MM/yyyy")</strong>Hạn chót · @d.DueText</div>
                </div>

                <h3 class="project-subhead">Nhiệm vụ cần chú ý</h3>
                @if (attentionTasks.Count == 0)
                {
                    <p class="project-attn-empty">Không có nhiệm vụ quá hạn hoặc khẩn cấp.</p>
                }
                else
                {
                    <ul class="project-feed">
                        @foreach (var t in attentionTasks)
                        {
                            <li>
                                <a href="#" data-modal-open="taskModal-@t.Id"><strong>@t.Title</strong><div class="project-sub">@t.Key · @t.AssigneeName</div></a>
                                <small class="@(t.IsOverdue ? "is-overdue" : "")">@(t.IsOverdue ? "Quá hạn" : t.PriorityLabel)</small>
                            </li>
                        }
                    </ul>
                }
            </section>

            <div class="project-stack">
                <section class="project-card">
                    <div class="section-heading">
                        <div><h3>Milestone tiếp theo</h3></div>
                        <a href="#" class="project-link" data-ws-go="milestones">Xem tất cả →</a>
                    </div>
                    @if (nextMilestone == null)
                    {
                        <p class="project-attn-empty">Chưa có milestone nào đang chờ.</p>
                    }
                    else
                    {
                        <div class="project-meta-pair" style="margin:0">
                            <div><strong>@nextMilestone.Title</strong>@nextMilestone.DueDate.ToString("dd/MM/yyyy") · @nextMilestone.DueText</div>
                        </div>
                    }
                </section>

                <section class="project-card">
                    <div class="section-heading">
                        <div><h3>Thành viên</h3><p>@d.Members.Count thành viên trong dự án</p></div>
                        <a href="#" class="project-link" data-ws-go="members">Xem tất cả →</a>
                    </div>
                    <div class="project-avatars">
                        @foreach (var mb in d.Members.Take(5))
                        {
                            <span title="@mb.Name">@mb.Initial</span>
                        }
                        @if (d.Members.Count > 5)
                        {
                            <span class="project-avatars-more">+@(d.Members.Count - 5)</span>
                        }
                    </div>
                </section>
            </div>
        </div>
    </div>

    <div class="ws-panel" role="tabpanel" id="panel-board" aria-labelledby="tab-board" data-ws-panel="board" hidden>
    @if (d.CanManage)
    {
        <section class="project-card project-block" aria-label="Giao việc bằng kéo thả">
            <div class="section-heading">
                <div>
                    <h3>Giao việc</h3>
                    <p>Kéo thành viên thả vào thẻ nhiệm vụ để giao việc.</p>
                </div>
            </div>
            <div class="member-chips">
                @foreach (var mb in assignable)
                {
                    <div class="member-chip" data-member-chip data-user-id="@mb.UserId" data-name="@mb.Name" draggable="true" title="@mb.Email">
                        <span class="member-chip-avatar">@mb.Initial</span>
                        <span class="member-chip-info">
                            <strong>@mb.Name@(mb.IsCurrentUser ? " (bạn)" : "")</strong>
                            <small>@mb.Role · <span data-open-count>@mb.OpenTaskCount</span> việc đang mở</small>
                        </span>
                    </div>
                }
            </div>
        </section>
    }

    <!-- THANH LỌC BẢNG KANBAN -->
    <section class="board-toolbar" aria-label="Bộ lọc bảng nhiệm vụ">
        <input type="search" id="boardSearch" class="project-input board-search" placeholder="Tìm nhiệm vụ..." autocomplete="off" aria-label="Tìm nhiệm vụ" />
        <div class="board-avatars" role="group" aria-label="Lọc theo người thực hiện">
            @foreach (var mb in assignable)
            {
                <button type="button" class="filter-avatar" data-filter-user="@mb.UserId" title="@mb.Name" aria-pressed="false">@mb.Initial</button>
            }
        </div>
        <button type="button" class="project-btn small" id="boardClear" hidden>Xóa bộ lọc</button>
    </section>

    <!-- BẢNG KANBAN -->
    <section class="kanban" id="kanbanBoard" aria-label="Bảng nhiệm vụ">
        @foreach (var col in d.Columns)
        {
            <div class="kanban-col" data-column data-status="@col.Key">
                <div class="kanban-col-head">
                    <h3>
                        <span>
                            @col.Title
                            @if (col.Key == "review")
                            {
                                <small class="kanban-hint">Chờ trưởng nhóm duyệt</small>
                            }
                        </span>
                        <span class="chip-count">@col.Tasks.Count</span>
                    </h3>
                    @if (d.CanEdit)
                    {
                        <button type="button" class="project-btn small" data-modal-open="createTaskModal" data-prefill-status="@col.Key" aria-label="Thêm nhiệm vụ vào cột @col.Title">+</button>
                    }
                </div>

                <div class="kanban-col-body">
                    @foreach (var t in col.Tasks)
                    {
                        var dueClass = t.IsOverdue ? "task-due is-overdue" : "task-due";
                        var assigneeAttr = t.AssigneeId?.ToString() ?? "";
                        var searchAttr = t.Key + " " + t.Title;
                        var assigneeClass = string.IsNullOrEmpty(t.AssigneeInitial) ? "task-assignee task-assignee-empty" : "task-assignee";

                        <article class="task-card" data-task-card data-task-id="@t.Id" data-status="@t.StatusKey"
                                 data-assignee="@assigneeAttr" data-search="@searchAttr" draggable="@dragTask"
                                 data-modal-open="taskModal-@t.Id" tabindex="0">
                            <div class="task-card-top">
                                <span class="task-key">@t.Key</span>
                                <span class="task-prio task-prio-@t.PriorityKey">@t.PriorityLabel</span>
                            </div>
                            <h4>@t.Title</h4>
                            @if (t.SubTasks.Count > 0)
                            {
                                <div class="task-sub" data-card-sub>☑ @t.SubTaskDone/@t.SubTasks.Count việc con</div>
                            }
                            <div class="task-card-foot">
                                <div class="task-meta-group">
                                    <span class="@dueClass">@(t.IsOverdue ? "Quá hạn · " : "")@(t.DueDate.HasValue ? t.DueDate.Value.ToString("dd/MM") : "Không hạn")</span>
                                    <span class="task-meta" data-comment-count hidden="@(t.Comments.Count == 0)">💬 @t.Comments.Count</span>
                                </div>
                                <span class="@assigneeClass" title="@(string.IsNullOrEmpty(t.AssigneeName) ? "Chưa giao" : t.AssigneeName)">@(string.IsNullOrEmpty(t.AssigneeInitial) ? "?" : t.AssigneeInitial)</span>
                            </div>
                        </article>
                    }

                    @if (col.Tasks.Count == 0)
                    {
                        <p class="kanban-empty">Chưa có nhiệm vụ</p>
                    }
                </div>
            </div>
        }
    </section>

    </div>

    <div class="ws-panel" role="tabpanel" id="panel-list" aria-labelledby="tab-list" data-ws-panel="list" hidden>
        <div class="project-list-toolbar" aria-label="Bộ lọc danh sách nhiệm vụ">
            <input type="search" id="listSearch" class="project-input project-search" placeholder="Tìm nhiệm vụ..." autocomplete="off" aria-label="Tìm nhiệm vụ" />
            <select id="listStatus" class="project-input project-select" aria-label="Lọc theo trạng thái">
                <option value="">Mọi trạng thái</option>
                @foreach (var col in d.Columns)
                {
                    <option value="@col.Key">@col.Title</option>
                }
            </select>
            <select id="listPriority" class="project-input project-select" aria-label="Lọc theo mức ưu tiên">
                <option value="">Mọi mức ưu tiên</option>
                @foreach (var pr in priorities)
                {
                    <option value="@pr.Item1">@pr.Item2</option>
                }
            </select>
            <select id="listAssignee" class="project-input project-select" aria-label="Lọc theo người thực hiện">
                <option value="">Mọi người thực hiện</option>
                <option value="none">Chưa giao</option>
                @foreach (var mb in assignable)
                {
                    <option value="@mb.UserId">@mb.Name</option>
                }
            </select>
        </div>

        <div class="table-wrap">
            <table class="project-table">
                <thead>
                    <tr>
                        <th scope="col">Nhiệm vụ</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col">Ưu tiên</th>
                        <th scope="col">Người thực hiện</th>
                        <th scope="col">Hạn chót</th>
                        <th scope="col">Cập nhật</th>
                    </tr>
                </thead>
                <tbody id="listBody">
                    @foreach (var t in allTasks)
                    {
                        var rowAssignee = t.AssigneeId?.ToString() ?? "none";
                        <tr data-list-row data-task-id="@t.Id" data-status="@t.StatusKey" data-priority="@t.PriorityKey"
                            data-assignee="@rowAssignee" data-search="@(t.Key + " " + t.Title)"
                            data-modal-open="taskModal-@t.Id" tabindex="0">
                            <td class="cell-title"><strong>@t.Title</strong><small>@t.Key</small></td>
                            <td><span class="project-pill" data-status="@t.StatusKey" data-list-status>@t.StatusLabel</span></td>
                            <td><span class="task-prio task-prio-@t.PriorityKey">@t.PriorityLabel</span></td>
                            <td>
                                @if (string.IsNullOrEmpty(t.AssigneeInitial))
                                {
                                    <span class="project-muted-text">Chưa giao</span>
                                }
                                else
                                {
                                    <span class="project-who"><span class="task-assignee">@t.AssigneeInitial</span>@t.AssigneeName</span>
                                }
                            </td>
                            <td>
                                @if (t.DueDate.HasValue)
                                {
                                    <span class="@(t.IsOverdue ? "task-due is-overdue" : "task-due")">@(t.IsOverdue ? "Quá hạn · " : "")@t.DueDate.Value.ToString("dd/MM/yyyy")</span>
                                }
                                else
                                {
                                    <span class="project-muted-text">Không hạn</span>
                                }
                            </td>
                            <td class="project-muted-text">@timeAgo(t.UpdatedAt)</td>
                        </tr>
                    }
                    <tr class="project-list-empty" id="listEmpty" @(allTasks.Count == 0 ? "" : "hidden")>
                        <td colspan="6">@(allTasks.Count == 0 ? "Dự án chưa có nhiệm vụ nào." : "Không có nhiệm vụ khớp bộ lọc.")</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="project-sub">Bấm vào một dòng để mở chi tiết và cập nhật nhiệm vụ.</p>
    </div>

    <div class="ws-panel" role="tabpanel" id="panel-milestones" aria-labelledby="tab-milestones" data-ws-panel="milestones" hidden>
        <section class="project-card project-milestones" data-ms-scope>
            @{
                var msDone = d.Milestones.Count(x => x.IsCompleted);
                var msPct = d.Milestones.Count == 0 ? 0 : (int)Math.Round(msDone * 100.0 / d.Milestones.Count);
            }

            <div class="project-top project-milestones-head">
                <div>
                    <h3>Cột mốc dự án</h3>
                    <p class="project-sub"><strong data-ms-progress>@msDone/@d.Milestones.Count</strong> cột mốc đã hoàn thành. Bấm vào vòng tròn để đánh dấu.</p>
                </div>
                @if (d.CanManage)
                {
                    <button type="button" class="project-btn small" data-modal-open="createMilestoneModal">+ Cột mốc</button>
                }
            </div>

            <div class="project-progress ms-progress"><div class="bar"><i data-ms-bar style="width:@msPct%;"></i></div></div>

            <ol class="ms-timeline">
                @foreach (var ms in d.Milestones)
                {
                    var nodeClass = "ms-node" + (ms.IsCompleted ? " is-done" : "") + (ms.IsOverdue ? " is-overdue" : "");
                    var pastDue = ms.DueDate.Date < DateTime.Today ? "true" : "false";
                    var toggleLabel = ms.IsCompleted ? "Mở lại cột mốc" : "Đánh dấu hoàn thành";

                    <li class="@nodeClass" data-ms-item data-past-due="@pastDue" data-open-text="@ms.OpenDueText">
                        @if (ms.CanToggle)
                        {
                                <form method="post" asp-action="ToggleMilestone">
                                <input type="hidden" name="milestoneId" value="@ms.Id" />
                                <input type="hidden" name="projectId" value="@d.Id" />
                                <input type="hidden" name="returnTo" value="details" />
                                <button type="submit" class="ms-toggle" title="@toggleLabel" aria-label="@toggleLabel">@(ms.IsCompleted ? "✓" : "○")</button>
                            </form>
                        }
                        else
                        {
                            <span class="ms-toggle ms-toggle-static">@(ms.IsCompleted ? "✓" : "○")</span>
                        }

                        <div class="ms-node-body">
                            <div class="ms-node-top">
                                <span class="ms-node-title">@ms.Title</span>
                                <span class="ms-date">@ms.DueDate.ToString("dd/MM/yyyy")</span>
                            </div>
                            <small class="ms-node-meta" data-ms-meta>@ms.DueText</small>
                        </div>
                    </li>
                }
            </ol>

            @if (d.Milestones.Count == 0)
            {
                <p class="project-sub">Chưa có cột mốc nào.</p>
            }
        </section>

    </div>

    <div class="ws-panel" role="tabpanel" id="panel-members" aria-labelledby="tab-members" data-ws-panel="members" hidden>
    <!-- THÀNH VIÊN: trưởng nhóm kéo chip thả vào thẻ nhiệm vụ để giao việc -->
    <section class="project-card detail-members">
        <div class="project-top">
            <div>
                <h3>Thành viên (@d.Members.Count)</h3>
                @if (d.CanManage)
                {
                    <p class="project-sub">Kéo thành viên thả vào thẻ nhiệm vụ để giao việc. Hoặc mở nhiệm vụ rồi chọn người ở mục "Người thực hiện".</p>
                }
            </div>
        </div>

        <div class="member-chips">
            @foreach (var mb in d.Members)
            {
                var canDragChip = d.CanManage && mb.Role != "Viewer";
                var dragChip = canDragChip ? "true" : "false";

                <div class="member-chip" data-member-chip data-user-id="@mb.UserId" data-name="@mb.Name" draggable="@dragChip" title="@mb.Email">
                    <span class="member-chip-avatar">@mb.Initial</span>
                    <span class="member-chip-info">
                        <strong>@mb.Name@(mb.IsCurrentUser ? " (bạn)" : "")</strong>
                        <small>@mb.Role · <span data-open-count>@mb.OpenTaskCount</span> việc đang mở</small>
                    </span>
                    @if (d.CanManage && !mb.IsCurrentUser)
                    {
                        <form method="post" asp-action="RemoveMember" data-confirm="Xóa @mb.Name khỏi dự án? Các nhiệm vụ của họ sẽ chuyển về chưa giao.">
                            <input type="hidden" name="projectId" value="@d.Id" />
                            <input type="hidden" name="userId" value="@mb.UserId" />
                            <button type="submit" class="chip-remove" aria-label="Xóa @mb.Name khỏi dự án" title="Xóa khỏi dự án">×</button>
                        </form>
                    }
                </div>
            }
        </div>

        @if (d.Invitations.Count > 0)
        {
            <div class="invite-list">
                <h4>Lời mời đang chờ (@d.Invitations.Count)</h4>
                @foreach (var inv in d.Invitations)
                {
                    <div class="invite-row">
                        <div>
                            <strong>@inv.Email</strong>
                            <span class="summary-badge">@inv.Role</span>
                            <small>Mời bởi @inv.InvitedByName · @inv.TimeText</small>
                        </div>
                        @if (inv.CanAccept || d.CanManage)
                        {
                            <div class="invite-actions">
                                @if (inv.CanAccept)
                                {
                                    <form method="post" asp-action="AcceptInvitation">
                                        <input type="hidden" name="projectId" value="@d.Id" />
                                        <input type="hidden" name="invitationId" value="@inv.Id" />
                                        <button type="submit" class="project-btn small">Chấp nhận lời mời</button>
                                    </form>
                                }
                                @if (d.CanManage)
                                {
                                    <form method="post" asp-action="CancelInvitation">
                                        <input type="hidden" name="projectId" value="@d.Id" />
                                        <input type="hidden" name="invitationId" value="@inv.Id" />
                                        <button type="submit" class="project-btn small danger">Hủy</button>
                                    </form>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>

    </div>

    <div class="ws-panel" role="tabpanel" id="panel-activity" aria-labelledby="tab-activity" data-ws-panel="activity" hidden>
        <section class="project-card">
            <div class="project-top"><div><h3>Hoạt động gần đây</h3></div></div>
            <ul class="act-list">
                @foreach (var a in d.Activities)
                {
                    <li>
                        <span class="act-dot"></span>
                        <div>
                            <p><strong>@a.ActorName</strong> @a.Text</p>
                            <small>@a.TimeText</small>
                        </div>
                    </li>
                }
            </ul>
            @if (d.Activities.Count == 0)
            {
                <p class="project-attn-empty">Chưa có hoạt động nào trong dự án.</p>
            }
        </section>
    </div>

    <!-- MODAL: YÊU CẦU LÀM LẠI (đặt TRƯỚC các modal nhiệm vụ để phím Esc đóng nó trước) -->
    <div class="project-modal" id="reworkModal" role="dialog" aria-modal="true" aria-labelledby="reworkTitle" hidden>
        <div class="project-modal-box">
            <div class="project-modal-head">
                <div>
                    <h3 id="reworkTitle">Yêu cầu làm lại</h3>
                    <p class="project-sub" id="reworkTaskName"></p>
                </div>
                <button type="button" class="project-modal-close" data-modal-close aria-label="Đóng">×</button>
            </div>

            <form data-rework-form data-reset-on-open novalidate>
                <div class="field">
                    <label for="reworkReason">Lý do (bắt buộc) *</label>
                    <textarea id="reworkReason" class="project-input" rows="4" maxlength="500" required
                              placeholder="VD: Chưa đạt: thiếu kiểm tra dữ liệu đầu vào, cần sửa lại phần..."></textarea>
                </div>

                <div class="field">
                    <label for="reworkTarget">Kéo về cột</label>
                    <select id="reworkTarget" class="project-input">
                        <option value="in_progress">Đang làm</option>
                        <option value="todo">Cần làm</option>
                    </select>
                </div>

                <p class="project-note" data-form-note hidden></p>

                <div class="project-modal-foot">
                    <button type="button" class="project-btn" data-modal-close>Hủy</button>
                    <button type="submit" class="project-btn danger">Gửi lý do và trả về</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: CHI TIẾT NHIỆM VỤ (bố cục giống Jira) -->
    @foreach (var t in allTasks)
    {
        var assigneeLabel = string.IsNullOrEmpty(t.AssigneeName) ? "Chưa giao" : t.AssigneeName;

        <div class="project-modal" id="taskModal-@t.Id" data-task-modal data-task-id="@t.Id" role="dialog" aria-modal="true" aria-labelledby="taskTitle-@t.Id" hidden>
            <div class="project-modal-box project-modal-box-jira">
                <div class="jira-top">
                    <span class="task-key">@d.Name / @t.Key</span>
                    <button type="button" class="project-modal-close" data-modal-close aria-label="Đóng">×</button>
                </div>

                <div class="jira-layout">
                    <!-- CỘT TRÁI -->
                    <div class="jira-main">
                        <h3 id="taskTitle-@t.Id" class="jira-title">@t.Title</h3>

                        <h4 class="jira-h">Mô tả</h4>
                        <p class="task-desc">@(string.IsNullOrWhiteSpace(t.Description) ? "Chưa có mô tả." : t.Description)</p>

                        <h4 class="jira-h">Việc con <span data-sub-count>(@t.SubTaskDone/@t.SubTasks.Count)</span></h4>
                        <div data-sub-list>
                            @foreach (var s in t.SubTasks)
                            {
                                var subRow = s.IsDone ? "sub-row is-done" : "sub-row";
                                var subLabel = s.IsDone ? "Mở lại" : "Đánh dấu xong";

                                <div class="@subRow">
                                    @if (d.CanEdit)
                                    {
                                        <button type="button" class="ms-toggle" data-sub-toggle data-subtask-id="@s.Id" title="@subLabel" aria-label="@subLabel">@(s.IsDone ? "✓" : "○")</button>
                                    }
                                    else
                                    {
                                        <span class="ms-check">@(s.IsDone ? "✓" : "○")</span>
                                    }
                                    <span class="sub-title">@s.Title</span>
                                </div>
                            }
                        </div>
                        @if (t.SubTasks.Count == 0)
                        {
                            <p class="project-sub">Chưa có việc con.</p>
                        }
                        @if (d.CanEdit)
                        {
                            <form method="post" asp-action="CreateTask" class="task-inline-form">
                                <input type="hidden" name="projectId" value="@d.Id" />
                                <input type="hidden" name="parentTaskId" value="@t.Id" />
                                <input type="text" name="title" class="project-input" maxlength="120" required placeholder="Thêm việc con..." aria-label="Tên việc con" />
                                <button type="submit" class="project-btn small">Thêm</button>
                            </form>
                        }

                        <h4 class="jira-h">Hoạt động</h4>
                        <div class="jira-tabs" role="tablist">
                            <button type="button" class="jira-tab active" data-activity-tab="comments">Bình luận <span data-comment-total>@t.Comments.Count</span></button>
                            <button type="button" class="jira-tab" data-activity-tab="history">Lịch sử</button>
                        </div>

                        <div data-activity-panel="comments">
                            <ul class="comment-list" data-comment-list>
                                @if (t.Comments.Count == 0)
                                {
                                    <li class="comment-empty" data-comment-empty>Chưa có bình luận nào.</li>
                                }
                                @foreach (var c in t.Comments)
                                {
                                    var commentClass = c.IsRework ? "comment comment-rework" : "comment";

                                    <li class="@commentClass">
                                        <span class="comment-avatar">@c.AuthorInitial</span>
                                        <div class="comment-body">
                                            <p class="comment-head">
                                                <strong>@c.AuthorName</strong> <small>@c.TimeText</small>
                                                @if (c.IsRework)
                                                {
                                                    <span class="comment-flag">Yêu cầu làm lại</span>
                                                }
                                            </p>
                                            <p class="comment-text">@c.Text</p>
                                        </div>
                                    </li>
                                }
                            </ul>

                            @if (d.CanEdit)
                            {
                                <form class="comment-form" data-comment-form asp-action="AddTaskComment" method="post" novalidate>
                                    <input type="hidden" name="projectId" value="@d.Id" />
                                    <input type="hidden" name="taskId" value="@t.Id" />
                                    <span class="comment-avatar">@d.CurrentUserName.Substring(0, 1)</span>
                                    <div class="comment-form-body">
                                        <textarea class="project-input" name="content" rows="2" maxlength="500" placeholder="Viết bình luận..." aria-label="Bình luận"></textarea>
                                        <button type="submit" class="project-btn small primary">Bình luận</button>
                                    </div>
                                </form>
                            }
                        </div>

                        <ul class="act-list" data-activity-panel="history" data-history-list hidden>
                            @foreach (var h in t.History)
                            {
                                <li>
                                    <span class="act-dot"></span>
                                    <div>
                                        <p><strong>@h.ActorName</strong> <span>@h.Text</span></p>
                                        <small>@h.TimeText</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- CỘT PHẢI -->
                    <aside class="jira-side">
                        <div class="jira-panel">
                            <label class="jira-label" for="status-@t.Id">Trạng thái</label>
                            <select id="status-@t.Id" class="project-input" data-status-select disabled="@(!d.CanEdit)">
                                @foreach (var c in d.Columns)
                                {
                                    <option value="@c.Key" selected="@(c.Key == t.StatusKey)">@c.Title</option>
                                }
                            </select>

                            <div class="review-actions">
                                <button type="button" class="project-btn primary" data-review-action="submit" hidden>Gửi duyệt</button>
                                <button type="button" class="project-btn primary" data-review-action="approve" hidden>Duyệt hoàn thành</button>
                                <button type="button" class="project-btn danger" data-review-action="rework" hidden>Yêu cầu làm lại</button>
                            </div>
                        </div>

                        <div class="jira-panel jira-details">
                            <h4>Chi tiết</h4>
                            <dl>
                                <div>
                                    <dt>Người thực hiện</dt>
                                    <dd>
                                        @if (d.CanManage)
                                        {
                                            <select class="project-input" data-assign-select aria-label="Người thực hiện">
                                                <option value="" selected="@(!t.AssigneeId.HasValue)">Chưa giao</option>
                                                @foreach (var mb in assignable)
                                                {
                                                    <option value="@mb.UserId" selected="@(t.AssigneeId == mb.UserId)">@mb.Name</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <span>@assigneeLabel</span>
                                        }
                                    </dd>
                                </div>
                                <div><dt>Người báo cáo</dt><dd>@t.ReporterName</dd></div>
                                <div><dt>Ưu tiên</dt><dd><span class="task-prio task-prio-@t.PriorityKey">@t.PriorityLabel</span></dd></div>
                                <div><dt>Hạn chót</dt><dd>@(t.DueDate.HasValue ? t.DueDate.Value.ToString("dd/MM/yyyy") : "Chưa đặt")</dd></div>
                                <div><dt>Ngày tạo</dt><dd>@t.CreatedAt.ToString("dd/MM/yyyy")</dd></div>
                                <div><dt>Cập nhật</dt><dd data-updated>@t.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</dd></div>
                                <div data-resolved-row hidden="@(!t.CompletedAt.HasValue)"><dt>Hoàn thành</dt><dd data-resolved>@(t.CompletedAt.HasValue ? t.CompletedAt.Value.ToString("dd/MM/yyyy HH:mm") : "")</dd></div>
                            </dl>
                        </div>

                        @if (d.CanManage)
                        {
                            <form method="post" asp-action="DeleteTask" data-confirm="Xóa nhiệm vụ này và các việc con của nó?">
                                <input type="hidden" name="projectId" value="@d.Id" />
                                <input type="hidden" name="taskId" value="@t.Id" />
                                <button type="submit" class="project-btn danger">Xóa nhiệm vụ</button>
                            </form>
                        }
                    </aside>
                </div>
            </div>
        </div>
    }

    <!-- MODAL: TẠO NHIỆM VỤ -->
    @if (d.CanEdit)
    {
        <div class="project-modal" id="createTaskModal" role="dialog" aria-modal="true" aria-labelledby="createTaskTitle" hidden>
            <div class="project-modal-box">
                <div class="project-modal-head">
                    <div>
                        <h3 id="createTaskTitle">Tạo nhiệm vụ</h3>
                        <p class="project-sub">Nhiệm vụ mới sẽ nhận mã @d.Key-n.</p>
                    </div>
                    <button type="button" class="project-modal-close" data-modal-close aria-label="Đóng">×</button>
                </div>

                <form method="post" asp-action="CreateTask" data-reset-on-open>
                    <input type="hidden" name="projectId" value="@d.Id" />

                    <div class="field">
                        <label for="newTaskTitle">Tên nhiệm vụ *</label>
                        <input type="text" id="newTaskTitle" name="title" class="project-input" maxlength="120" required placeholder="VD: Làm trang đăng nhập" />
                    </div>

                    <div class="field">
                        <label for="newTaskDesc">Mô tả</label>
                        <textarea id="newTaskDesc" name="description" class="project-input" rows="3" maxlength="500"></textarea>
                    </div>

                    <div class="project-form-row">
                        <div class="field">
                            <label for="newTaskStatus">Cột</label>
                            <select id="newTaskStatus" name="status" class="project-input">
                                @foreach (var c in d.Columns)
                                {
                                    <option value="@c.Key">@c.Title</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label for="newTaskPriority">Mức ưu tiên</label>
                            <select id="newTaskPriority" name="priority" class="project-input">
                                @foreach (var (value, label) in priorities)
                                {
                                    <option value="@value" selected="@(value == "medium")">@label</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="project-form-row">
                        <div class="field">
                            <label for="newTaskDue">Hạn chót</label>
                            <input type="date" id="newTaskDue" name="dueDate" class="project-input" />
                        </div>
                        <div class="field">
                            <label for="newTaskAssignee">Giao cho</label>
                            <select id="newTaskAssignee" name="assigneeId" class="project-input">
                                <option value="">Chưa giao</option>
                                @foreach (var mb in assignable)
                                {
                                    <option value="@mb.UserId">@mb.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <p class="project-note" data-form-note hidden></p>

                    <div class="project-modal-foot">
                        <button type="button" class="project-btn" data-modal-close>Hủy</button>
                        <button type="submit" class="project-btn primary">Tạo nhiệm vụ</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <!-- MODAL: MỜI THÀNH VIÊN + THÊM CỘT MỐC (chỉ trưởng nhóm) -->
    @if (d.CanManage)
    {
        <div class="project-modal" id="inviteModal" role="dialog" aria-modal="true" aria-labelledby="inviteTitle" hidden>
            <div class="project-modal-box">
                <div class="project-modal-head">
                    <div>
                        <h3 id="inviteTitle">Mời thành viên</h3>
                        <p class="project-sub">Lời mời sẽ ở trạng thái "Chờ" cho đến khi người kia chấp nhận.</p>
                    </div>
                    <button type="button" class="project-modal-close" data-modal-close aria-label="Đóng">×</button>
                </div>

                <form method="post" asp-action="InviteMember" data-reset-on-open>
                    <input type="hidden" name="projectId" value="@d.Id" />

                    <div class="field">
                        <label for="inviteEmail">Email *</label>
                        <input type="email" id="inviteEmail" name="email" class="project-input" required placeholder="ten@email.com" />
                    </div>

                    <div class="field">
                        <label for="inviteRole">Vai trò</label>
                        <select id="inviteRole" name="role" class="project-input">
                            <option value="Member">Member: tạo và cập nhật nhiệm vụ</option>
                            <option value="Viewer">Viewer: chỉ xem</option>
                            <option value="Manager">Manager: trưởng nhóm, quản lý toàn bộ dự án</option>
                        </select>
                    </div>

                    <p class="project-note" data-form-note hidden></p>

                    <div class="project-modal-foot">
                        <button type="button" class="project-btn" data-modal-close>Hủy</button>
                        <button type="submit" class="project-btn primary">Gửi lời mời</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="project-modal" id="createMilestoneModal" role="dialog" aria-modal="true" aria-labelledby="createMilestoneTitle" hidden>
            <div class="project-modal-box">
                <div class="project-modal-head">
                    <div>
                        <h3 id="createMilestoneTitle">Thêm cột mốc</h3>
                        <p class="project-sub">Đánh dấu một giai đoạn quan trọng của dự án.</p>
                    </div>
                    <button type="button" class="project-modal-close" data-modal-close aria-label="Đóng">×</button>
                </div>

                <form method="post" asp-action="AddMilestone" data-reset-on-open>
                    <input type="hidden" name="projectId" value="@d.Id" />
                    <input type="hidden" name="returnTo" value="details" />

                    <div class="field">
                        <label for="newMilestoneTitleInput">Tên cột mốc *</label>
                        <input type="text" id="newMilestoneTitleInput" name="title" class="project-input" maxlength="100" required />
                    </div>

                    <div class="field">
                        <label for="newMilestoneDue">Hạn hoàn thành *</label>
                        <input type="date" id="newMilestoneDue" name="dueDate" class="project-input" required />
                    </div>

                    <p class="project-note" data-form-note hidden></p>

                    <div class="project-modal-foot">
                        <button type="button" class="project-btn" data-modal-close>Hủy</button>
                        <button type="submit" class="project-btn primary">Thêm cột mốc</button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/project.js" asp-append-version="true"></script>
    <script src="~/js/project-ui.js" asp-append-version="true"></script>
    <script src="~/js/project-detail.js" asp-append-version="true"></script>
}
