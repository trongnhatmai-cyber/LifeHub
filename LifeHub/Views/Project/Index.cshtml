@model LifeHub.Models.ViewModels.ProjectManagement.ProjectViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý dự án";
    ViewData["ActivePage"] = "ProjectOverview";

    var m = Model;
    var managedProjects = m.Projects.Where(p => p.Role == "Manager").ToList();

    // Khu vực "Cần chú ý": dự án chưa xong, có hạn chót, quá hạn hoặc còn ≤ 7 ngày
    var attention = m.Projects
        .Where(p => p.StatusKey != "completed" && p.DueDate.Year < 9999 && (p.DueDate.Date - DateTime.Today).Days <= 7)
        .OrderBy(p => p.DueDate)
        .Take(4)
        .ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" asp-append-version="true" />
}

<div class="project-page">
    <partial name="_Flash" />

    <!-- 1. TIÊU ĐỀ TRANG -->
    <header class="project-heading">
        <div>
            <span class="project-label">PROJECT MANAGEMENT</span>
            <h1>Tổng quan dự án</h1>
            <p>Theo dõi tiến độ và những việc cần chú ý.</p>
        </div>

        <div class="heading-actions">
            <a asp-action="All" class="proj-btn">Xem tất cả</a>
            <button type="button" class="proj-btn primary" id="createProjectBtn" data-modal-open="createProjectModal">
                + Tạo dự án
            </button>
        </div>
    </header>

    <!-- 2. THẺ CHỈ SỐ -->
    <section class="project-summary">
        <div class="summary-card">
            <div class="summary-top"><span>Tổng dự án</span><span class="summary-badge">TOTAL</span></div>
            <h2 data-count="@m.TotalProjects">@m.TotalProjects.ToString("00")</h2>
            <p>Không gian đang quản lý</p>
        </div>
        <div class="summary-card">
            <div class="summary-top"><span>Đang chạy</span><span class="summary-badge">ACTIVE</span></div>
            <h2 data-count="@m.ActiveProjects">@m.ActiveProjects.ToString("00")</h2>
            <p>Dự án đang thực hiện</p>
        </div>
        <div class="summary-card">
            <div class="summary-top"><span>Hoàn thành</span><span class="summary-badge">DONE</span></div>
            <h2 data-count="@m.CompletedProjects">@m.CompletedProjects.ToString("00")</h2>
            <p>Dự án đã nghiệm thu</p>
        </div>
        <div class="summary-card">
            <div class="summary-top"><span>Thành viên</span><span class="summary-badge">TEAM</span></div>
            <h2 data-count="@m.TotalTeamMembers">@m.TotalTeamMembers.ToString("00")</h2>
            <p>Người cộng tác</p>
        </div>
    </section>

    <!-- 3. CẦN CHÚ Ý: dự án sắp đến hạn hoặc quá hạn -->
    <section class="proj-panel proj-block" aria-labelledby="attnTitle">
        <div class="proj-panel-head">
            <div>
                <h2 id="attnTitle">Dự án cần chú ý</h2>
                <p>Dự án quá hạn hoặc còn không quá 7 ngày đến hạn chót.</p>
            </div>
        </div>

        @if (attention.Count == 0)
        {
            <p class="proj-attn-empty">Chưa có dự án nào sắp đến hạn. Mọi thứ đang đúng kế hoạch.</p>
        }
        else
        {
            <div class="proj-attn-list">
                @foreach (var p in attention)
                {
                    var attnClass = p.IsOverdue ? "proj-attn-item is-overdue" : "proj-attn-item";
                    <a asp-action="Details" asp-route-id="@p.Id" class="@attnClass">
                        <div>
                            <h3>@p.Name<span class="proj-attn-tag">@(p.IsOverdue ? "Quá hạn" : "Sắp đến hạn")</span></h3>
                            <small class="proj-sub">@p.Key · @p.Role · Hạn @p.DueDate.ToString("dd/MM/yyyy") · @p.DueText</small>
                        </div>
                        <div class="proj-progress">
                            <div class="proj-progress-head"><span>Tiến độ</span><span class="proj-progress-value">@p.ProgressPercent%</span></div>
                            <div class="bar"><i style="width:@p.ProgressPercent%;"></i></div>
                        </div>
                        <span class="proj-open">Mở dự án <i>→</i></span>
                    </a>
                }
            </div>
        }
    </section>

    <!-- 4. DỰ ÁN GẦN ĐÂY (tối đa 6) -->
    <div class="proj-section-head">
        <div>
            <h2>Dự án gần đây</h2>
            <p class="proj-sub">@m.RecentProjects.Count dự án có hoạt động mới nhất.</p>
        </div>
        <a asp-action="All" class="proj-btn sm">Xem tất cả @m.TotalProjects dự án →</a>
    </div>

    @if (m.RecentProjects.Count == 0)
    {
        <div class="proj-empty">
            <strong>Bạn chưa có dự án nào</strong>
            Tạo dự án đầu tiên để bắt đầu giao việc và theo dõi tiến độ.
            <div><button type="button" class="proj-btn primary" data-modal-open="createProjectModal">+ Tạo dự án</button></div>
        </div>
    }
    else
    {
        <div class="project-grid">
            @foreach (var p in m.RecentProjects)
            {
                <partial name="_ProjectCard" model="p" />
            }
        </div>
    }

    <!-- 5 + 6. CỘT MỐC SẮP TỚI và HOẠT ĐỘNG GẦN ĐÂY -->
    <div class="detail-grid">
    <!-- CỘT MỐC SẮP TỚI -->
    <section class="proj-panel proj-milestones" data-ms-scope>
        <div class="proj-top proj-milestones-head">
            <div>
                <h3>Milestone sắp tới</h3>
                <p class="proj-sub">Cột mốc chưa hoàn thành, gần hạn nhất trước. Bấm vòng tròn để đánh dấu hoàn thành.</p>
            </div>
            @if (managedProjects.Count > 0)
            {
                <button type="button" class="proj-btn sm" data-modal-open="createMilestoneModal">+ Cột mốc</button>
            }
        </div>

        <div class="ms-list">
            @if (m.RecentMilestones.Count == 0)
            {
                <p class="proj-attn-empty">Chưa có milestone nào sắp tới.</p>
            }
            @foreach (var ms in m.RecentMilestones)
            {
                var rowClass = "ms-row" + (ms.IsCompleted ? " is-done" : "") + (ms.IsOverdue ? " is-overdue" : "");
                var pastDue = ms.DueDate.Date < DateTime.Today ? "true" : "false";
                var toggleLabel = ms.IsCompleted ? "Mở lại cột mốc" : "Đánh dấu hoàn thành";

                <div class="@rowClass" data-ms-item data-past-due="@pastDue" data-open-text="@ms.OpenDueText">
                    <div class="ms-main">
                        @if (ms.CanToggle)
                        {
                            <form method="post" asp-action="ToggleMilestone">
                                <input type="hidden" name="milestoneId" value="@ms.Id" />
                                <input type="hidden" name="projectId" value="@ms.ProjectId" />
                                <input type="hidden" name="returnTo" value="index" />
                                <button type="submit" class="ms-toggle" title="@toggleLabel" aria-label="@toggleLabel">@(ms.IsCompleted ? "✓" : "○")</button>
                            </form>
                        }
                        else
                        {
                            <span class="ms-toggle ms-toggle--static">@(ms.IsCompleted ? "✓" : "○")</span>
                        }
                        <div>
                            <span class="ms-title">@ms.Title</span>
                            <span class="summary-badge ms-project">@ms.ProjectName</span>
                            <small class="ms-meta" data-ms-meta>@ms.DueText</small>
                        </div>
                    </div>
                    <span class="ms-date">@ms.DueDate.ToString("dd/MM/yyyy")</span>
                </div>
            }
        </div>
    </section>

        <section class="proj-panel" aria-labelledby="actTitle">
            <div class="proj-panel-head">
                <div>
                    <h2 id="actTitle">Hoạt động gần đây</h2>
                    <p>Bấm vào một dòng để mở dự án tương ứng.</p>
                </div>
                <a asp-action="All" class="proj-link">Xem tất cả →</a>
            </div>

            @if (m.RecentActivities.Count == 0)
            {
                <p class="proj-attn-empty">Các cập nhật mới nhất trong dự án của bạn sẽ xuất hiện tại đây.</p>
            }
            else
            {
                <ul class="proj-feed">
                    @foreach (var a in m.RecentActivities)
                    {
                        <li>
                            <a asp-action="Details" asp-route-id="@a.ProjectId">
                                <strong>@a.ActorName</strong> @a.Text
                                <div class="proj-sub">@a.ProjectName</div>
                            </a>
                            <small>@a.TimeText</small>
                        </li>
                    }
                </ul>
            }
        </section>
    </div>

    <partial name="_CreateProjectModal" />

    <!-- MODAL: THÊM CỘT MỐC (chỉ hiện với dự án mà bạn là Manager) -->
    @if (managedProjects.Count > 0)
    {
        <div class="proj-modal" id="createMilestoneModal" role="dialog" aria-modal="true" aria-labelledby="createMilestoneTitle" hidden>
            <div class="proj-modal__dialog">
                <div class="proj-modal__head">
                    <div>
                        <h3 id="createMilestoneTitle">Thêm cột mốc</h3>
                        <p class="proj-sub">Đánh dấu một giai đoạn quan trọng của dự án.</p>
                    </div>
                    <button type="button" class="proj-modal__close" data-modal-close aria-label="Đóng">×</button>
                </div>

                <form method="post" asp-action="AddMilestone" data-reset-on-open>
                    <input type="hidden" name="returnTo" value="index" />

                    <div class="proj-field">
                        <label for="newMilestoneProject">Dự án *</label>
                        <select id="newMilestoneProject" name="projectId" class="proj-input" required>
                            @foreach (var p in managedProjects)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>

                    <div class="proj-field">
                        <label for="newMilestoneTitleInput">Tên cột mốc *</label>
                        <input type="text" id="newMilestoneTitleInput" name="title" class="proj-input" maxlength="100" required placeholder="VD: Hoàn thành thiết kế" />
                    </div>

                    <div class="proj-field">
                        <label for="newMilestoneDue">Hạn hoàn thành *</label>
                        <input type="date" id="newMilestoneDue" name="dueDate" class="proj-input" required />
                    </div>

                    <p class="proj-form-note" data-form-note hidden></p>

                    <div class="proj-modal__actions">
                        <button type="button" class="proj-btn" data-modal-close>Hủy</button>
                        <button type="submit" class="proj-btn primary">Thêm cột mốc</button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/project.js" asp-append-version="true"></script>
    <script src="~/js/project-ui.js" asp-append-version="true"></script>
}
