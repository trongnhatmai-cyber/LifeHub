@model LifeHub.Models.ViewModels.ProjectManagement.ProjectViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý dự án";
    ViewData["ActivePage"] = "Project";

    var m = Model;
}

@section Styles {
    <link rel="stylesheet" href="~/css/project.css" asp-append-version="true" />
}

<div class="project-page">
    <!-- TIÊU ĐỀ PHÂN HỆ DỰ ÁN -->
    <header class="project-heading">
        <div>
            <span class="project-label">PROJECT MANAGEMENT · TEAM & PERSONAL</span>
            <h1>Dự án của bạn</h1>
            <p>Tổ chức không gian làm việc, phân chia công việc nhóm và theo dõi cột mốc tiến độ.</p>
        </div>

        <div class="heading-actions">
            <button type="button" class="proj-btn primary" id="createProjectBtn" data-modal-open="createProjectModal">
                + Tạo dự án mới
            </button>
        </div>
    </header>

    <!-- 4 THẺ CHỈ SỐ TỔNG QUAN -->
    <section class="project-summary">
        <div class="summary-card">
            <div class="summary-top">
                <span>Tổng số dự án</span>
                <span class="summary-badge">DỰ ÁN</span>
            </div>
            <h2>@m.TotalProjects.ToString("00")</h2>
            <p>Không gian đang quản lý</p>
        </div>

        <div class="summary-card">
            <div class="summary-top">
                <span>Đang thực hiện</span>
                <span class="summary-badge">TIẾN ĐỘ</span>
            </div>
            <h2>@m.ActiveProjects.ToString("00")</h2>
            <p>Dự án đang chạy</p>
        </div>

        <div class="summary-card">
            <div class="summary-top">
                <span>Đã hoàn thành</span>
                <span class="summary-badge">HOÀN TẤT</span>
            </div>
            <h2>@m.CompletedProjects.ToString("00")</h2>
            <p>Dự án đã nghiệm thu</p>
        </div>

        <div class="summary-card">
            <div class="summary-top">
                <span>Thành viên cộng tác</span>
                <span class="summary-badge">NHÓM</span>
            </div>
            <h2>@m.TotalTeamMembers.ToString("00")</h2>
            <p>Thành viên tham gia</p>
        </div>
    </section>

    <!-- THANH CÔNG CỤ: TÌM KIẾM / LỌC / SẮP XẾP (xử lý phía trình duyệt) -->
    <section class="project-toolbar" aria-label="Bộ lọc dự án">
        <input type="search" id="projectSearch" class="proj-input proj-search"
               placeholder="Tìm theo tên hoặc mô tả dự án..." autocomplete="off" aria-label="Tìm dự án" />

        <div class="proj-tabs" role="group" aria-label="Lọc theo trạng thái">
            @foreach (var f in m.StatusFilters)
            {
                var tabClass = f.Key == "all" ? "proj-tab is-active" : "proj-tab";
                <button type="button" class="@tabClass" data-filter="@f.Key"
                        aria-pressed="@(f.Key == "all" ? "true" : "false")">
                    @f.Label <span class="proj-tab-count">@f.Count</span>
                </button>
            }
        </div>

        <select id="projectSort" class="proj-input proj-select" aria-label="Sắp xếp dự án">
            <option value="default">Mặc định</option>
            <option value="deadline">Hạn chót gần nhất</option>
            <option value="progress">Tiến độ cao nhất</option>
            <option value="name">Tên A → Z</option>
        </select>
    </section>

    <p class="proj-result" id="projectResultCount" aria-live="polite"></p>

    <!-- DANH SÁCH THẺ DỰ ÁN -->
    <div class="project-grid" id="projectGrid">
        @for (var i = 0; i < m.Projects.Count; i++)
        {
            var p = m.Projects[i];
            var searchText = p.Name + " " + p.Description;
            var dueClass = p.IsOverdue ? "proj-due is-overdue" : "proj-due";

            <article class="project-item-card" data-project-card
                     data-index="@i"
                     data-status="@p.StatusKey"
                     data-role="@p.RoleKey"
                     data-progress="@p.ProgressPercent"
                     data-due="@p.DueDate.ToString("yyyy-MM-dd")"
                     data-name="@p.Name"
                     data-search="@searchText">
                <div>
                    <div class="proj-top">
                        <div>
                            <h3>@p.Name</h3>
                            <span class="summary-badge">Vai trò: @p.Role</span>
                        </div>
                        <span class="proj-status proj-status--@p.StatusKey">@p.Status</span>
                    </div>

                    <p class="proj-desc">@p.Description</p>
                </div>

                <div>
                    <div class="proj-progress">
                        <div class="proj-progress-head">
                            <span>Tiến độ thực hiện</span>
                            <span class="proj-progress-value">@p.ProgressPercent% (@p.CompletedTasks/@p.TotalTasks việc)</span>
                        </div>
                        <div class="bar">
                            <i style="width:@p.ProgressPercent%;"></i>
                        </div>
                    </div>

                    <div class="proj-meta">
                        <div class="proj-members">
                            <div class="proj-avatars">
                                @foreach (var name in p.MemberNames.Take(3))
                                {
                                    <span title="@name">@name.Substring(0, 1)</span>
                                }
                                @if (p.MemberNames.Count > 3)
                                {
                                    <span class="proj-avatars-more">+@(p.MemberNames.Count - 3)</span>
                                }
                            </div>
                            <span>@p.MemberCount thành viên</span>
                        </div>

                        <div class="@dueClass">
                            <span>Hạn chót: @p.DueDate.ToString("dd/MM/yyyy")</span>
                            <small>@p.DueText</small>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>

    <div class="proj-empty" id="projectEmpty" hidden>
        Không tìm thấy dự án phù hợp. Hãy thử đổi từ khóa hoặc bộ lọc.
    </div>

    <!-- CỘT MỐC GẦN ĐÂY -->
    <section class="project-item-card proj-milestones">
        <div class="proj-top proj-milestones-head">
            <div>
                <h3>Cột mốc dự án (Milestones)</h3>
                <p class="proj-sub">Các mốc then chốt cần hoàn thành đúng hạn</p>
            </div>
            <button type="button" class="proj-btn sm" data-modal-open="createMilestoneModal">
                + Cột mốc
            </button>
        </div>

        <div class="ms-list">
            @foreach (var ms in m.RecentMilestones)
            {
                var rowClass = "ms-row" + (ms.IsCompleted ? " is-done" : "") + (ms.IsOverdue ? " is-overdue" : "");

                <div class="@rowClass">
                    <div class="ms-main">
                        <span class="ms-check">@(ms.IsCompleted ? "✓" : "○")</span>
                        <div>
                            <span class="ms-title">@ms.Title</span>
                            <span class="summary-badge ms-project">@ms.ProjectName</span>
                        </div>
                    </div>
                    <span class="ms-date">@ms.DueDate.ToString("dd/MM/yyyy")</span>
                </div>
            }
        </div>
    </section>

    <!-- MODAL: TẠO DỰ ÁN (chỉ mô phỏng giao diện, không lưu dữ liệu) -->
    <div class="proj-modal" id="createProjectModal" role="dialog" aria-modal="true" aria-labelledby="createProjectTitle" hidden>
        <div class="proj-modal__dialog">
            <div class="proj-modal__head">
                <div>
                    <h3 id="createProjectTitle">Tạo dự án mới</h3>
                    <p class="proj-sub">Bạn sẽ là Manager của dự án này.</p>
                </div>
                <button type="button" class="proj-modal__close" data-modal-close aria-label="Đóng">×</button>
            </div>

            <form data-demo-form novalidate>
                <div class="proj-field">
                    <label for="newProjectName">Tên dự án *</label>
                    <input type="text" id="newProjectName" class="proj-input" maxlength="80" required placeholder="VD: Website nhóm NET108" />
                </div>

                <div class="proj-field">
                    <label for="newProjectDesc">Mô tả</label>
                    <textarea id="newProjectDesc" class="proj-input" rows="3" maxlength="300" placeholder="Mục tiêu và phạm vi của dự án"></textarea>
                </div>

                <div class="proj-field-row">
                    <div class="proj-field">
                        <label for="newProjectStart">Ngày bắt đầu *</label>
                        <input type="date" id="newProjectStart" class="proj-input" required data-date-start />
                    </div>
                    <div class="proj-field">
                        <label for="newProjectDue">Hạn chót *</label>
                        <input type="date" id="newProjectDue" class="proj-input" required data-date-end />
                    </div>
                </div>

                <div class="proj-field">
                    <label for="newProjectStatus">Trạng thái ban đầu</label>
                    <select id="newProjectStatus" class="proj-input">
                        <option>Lên kế hoạch</option>
                        <option>Đang chạy</option>
                    </select>
                </div>

                <p class="proj-form-note" data-form-note hidden></p>

                <div class="proj-modal__actions">
                    <button type="button" class="proj-btn" data-modal-close>Hủy</button>
                    <button type="submit" class="proj-btn primary">Tạo dự án</button>
                </div>
            </form>
        </div>
    </div>

    <!-- MODAL: THÊM CỘT MỐC (chỉ mô phỏng giao diện, không lưu dữ liệu) -->
    <div class="proj-modal" id="createMilestoneModal" role="dialog" aria-modal="true" aria-labelledby="createMilestoneTitle" hidden>
        <div class="proj-modal__dialog">
            <div class="proj-modal__head">
                <div>
                    <h3 id="createMilestoneTitle">Thêm cột mốc</h3>
                    <p class="proj-sub">Đánh dấu một giai đoạn quan trọng của dự án.</p>
                </div>
                <button type="button" class="proj-modal__close" data-modal-close aria-label="Đóng">×</button>
            </div>

            <form data-demo-form novalidate>
                <div class="proj-field">
                    <label for="newMilestoneProject">Dự án *</label>
                    <select id="newMilestoneProject" class="proj-input" required>
                        @foreach (var p in m.Projects)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>

                <div class="proj-field">
                    <label for="newMilestoneTitleInput">Tên cột mốc *</label>
                    <input type="text" id="newMilestoneTitleInput" class="proj-input" maxlength="100" required placeholder="VD: Hoàn thành thiết kế" />
                </div>

                <div class="proj-field">
                    <label for="newMilestoneDue">Hạn hoàn thành *</label>
                    <input type="date" id="newMilestoneDue" class="proj-input" required />
                </div>

                <p class="proj-form-note" data-form-note hidden></p>

                <div class="proj-modal__actions">
                    <button type="button" class="proj-btn" data-modal-close>Hủy</button>
                    <button type="submit" class="proj-btn primary">Thêm cột mốc</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/project.js" asp-append-version="true"></script>
}