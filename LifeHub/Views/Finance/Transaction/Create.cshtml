@model LifeHub.Models.ViewModels.FinanceManagement.TransactionCreateViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Thêm giao dịch";
    ViewData["ActivePage"] = "Transaction";
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/finance-modules.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/finance-modules.js" asp-append-version="true" defer></script>
}

<div class="finance-page" data-module="transactions">
    <header class="finance-heading">
        <div>
            <span class="finance-label">TRANSACTION</span>
            <h1>Thêm giao dịch</h1>
            <p>Nhập thông tin khoản thu hoặc chi.</p>
        </div>
        <a class="finance-btn" asp-controller="Transaction" asp-action="Index">← Quay lại</a>
    </header>

    <section class="finance-card">
        <form asp-controller="Transaction" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="modal-grid">
                <div>
                    <label asp-for="Note">Nội dung giao dịch</label>
                    <input asp-for="Note" class="finance-select" maxlength="255" placeholder="Ví dụ: Ăn trưa" />
                </div>

                <div>
                    <label asp-for="TransactionType">Loại giao dịch</label>
                    <select asp-for="TransactionType" class="finance-select" required>
                        <option value="Expense">Chi tiêu</option>
                        <option value="Income">Thu nhập</option>
                        <option value="Transfer">Chuyển tiền</option>
                    </select>
                </div>

                <div>
                    <label for="CategoryId">Danh mục</label>
                    <select asp-for="CategoryId" class="finance-select">
                        <option value="">Không phân loại</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var c in ViewBag.Categories)
                            {
                                <option value="@c.Id" data-type="@c.Type">@c.Name</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label for="WalletId">Ví / tài khoản</label>
                    <select asp-for="WalletId" class="finance-select" required>
                        <option value="">Chọn ví</option>
                        @if (ViewBag.Wallets != null)
                        {
                            foreach (var w in ViewBag.Wallets)
                            {
                                <option value="@w.Id">@w.Name</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label asp-for="ToWalletId">Ví nhận (dùng khi chuyển tiền)</label>
                    <select asp-for="ToWalletId" class="finance-select">
                        <option value="">Chọn ví nhận</option>
                        @if (ViewBag.Wallets != null)
                        {
                            foreach (var w in ViewBag.Wallets) { <option value="@w.Id">@w.Name</option> }
                        }
                    </select>
                </div>

                <div>
                    <label asp-for="SavingsGoalId">Mục tiêu tiết kiệm</label>
                    <select asp-for="SavingsGoalId" class="finance-select">
                        <option value="">Không liên kết</option>
                        @if (ViewBag.SavingsGoals != null)
                        {
                            foreach (var g in ViewBag.SavingsGoals) { <option value="@g.Id">@g.Name</option> }
                        }
                    </select>
                </div>

                <div>
                    <label asp-for="Amount">Số tiền (₫)</label>
                    <input asp-for="Amount" class="finance-select" type="number" min="0.01" step="0.01" required />
                </div>

                <div>
                    <label asp-for="TransactionDate">Ngày giao dịch</label>
                    <input asp-for="TransactionDate" class="finance-select" type="date" required />
                </div>
            </div>

            <div class="card-actions">
                <button class="finance-btn primary" type="submit">Thêm giao dịch</button>
                <a class="finance-btn" asp-controller="Transaction" asp-action="Index">Hủy</a>
            </div>
        </form>
    </section>
</div>
