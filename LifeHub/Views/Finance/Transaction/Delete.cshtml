@{
    Layout = "_Layout";
    ViewData["Title"] = "Xóa giao dịch";
    ViewData["ActivePage"] = "Transaction";
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/finance-modules.css" asp-append-version="true" />
}

<div class="finance-page">
    <header class="finance-heading">
        <div>
            <span class="finance-label">TRANSACTION</span>
            <h1>Xóa giao dịch</h1>
            <p>Xác nhận giao dịch cần xóa.</p>
        </div>
    </header>

    <section class="finance-card">
        <p>
            Bạn có chắc muốn xóa giao dịch
            <strong>@ViewBag.Name</strong> không?
        </p>

        <form asp-controller="Transaction" asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@ViewBag.Id" />

            <div class="card-actions">
                <button class="finance-btn primary" type="submit">Xác nhận xóa</button>
                <a class="finance-btn" asp-controller="Transaction" asp-action="Index">Hủy</a>
            </div>
        </form>
    </section>
</div>