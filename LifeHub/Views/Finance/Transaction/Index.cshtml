@model LifeHub.Models.ViewModels.FinanceManagement.TransactionViewModel;
@using LifeHub.Models.ViewModels.FinanceModules

@{
    Layout = "_Layout";
    ViewData["Title"] = "Giao dịch";
    ViewData["ActivePage"] = "Transaction";

    var isAll = Model.EffectiveMonth.Equals("all");
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/finance-modules.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/finance-modules.js" asp-append-version="true" defer></script>
}

<div class="finance-page" data-module="transactions">
    <header class="finance-heading">
        <div>
            <span class="finance-label">PERSONAL FINANCE MANAGEMENT</span>
            <h1>Giao dịch</h1>
            <p>Theo dõi toàn bộ khoản thu, chi và lịch sử dòng tiền của bạn.</p>
        </div>

        <div class="heading-actions">
            <a class="finance-btn" asp-controller="Finance" asp-action="Index">← Tổng quan</a>
            <a class="finance-btn primary"
               asp-controller="Transaction"
               asp-action="Create">
                ＋ Thêm giao dịch
            </a>
        </div>
    </header>

    <section class="finance-summary">
        <article class="summary-card income-card">
            <div class="summary-top">
                <span>Tổng thu</span>
                <span class="summary-badge">INCOME</span>
            </div>
            <h2>@FinanceFormat.Money(Model.TotalIncome)</h2>
            <p>@Model.PeriodLabel</p>
        </article>

        <article class="summary-card expense-card">
            <div class="summary-top">
                <span>Tổng chi</span>
                <span class="summary-badge">EXPENSE</span>
            </div>
            <h2>@FinanceFormat.Money(Model.TotalExpense)</h2>
            <p>@Model.PeriodLabel</p>
        </article>

        <article class="summary-card balance-card">
            <div class="summary-top">
                <span>Chênh lệch</span>
                <span class="summary-badge">NET FLOW</span>
            </div>
            <h2 class="@(Model.Net >= 0 ? "text-income" : "text-expense")">
                @FinanceFormat.Money(Model.Net)
            </h2>
            <p>Thu nhập trừ chi tiêu</p>
        </article>

        <article class="summary-card saving-card">
            <div class="summary-top">
                <span>Số giao dịch</span>
                <span class="summary-badge">ACTIVITY</span>
            </div>
            <h2>@Model.Rows.Count</h2>
            <p>Giao dịch trong kỳ đang xem</p>
        </article>
    </section>

    <section class="finance-card">
        <div class="section-heading">
            <div>
                <h3>Lịch sử giao dịch</h3>
                <p>Lọc theo loại, danh mục, ví, thời gian hoặc từ khóa.</p>
            </div>
            <span class="muted">@Model.PeriodLabel</span>
        </div>

        <form method="get" asp-controller="Transaction" asp-action="Index" class="filter-bar">
            <div class="finance-chips">
                <a class="finance-chip @(Model.Filter.Type.Equals("all") ? "active" : "")"
                   asp-route-Type="all"
                   asp-route-Month="@Model.EffectiveMonth">
                    Tất cả
                </a>

                <a class="finance-chip @(Model.Filter.Type.Equals("income") ? "active" : "")"
                   asp-route-Type="income"
                   asp-route-Month="@Model.EffectiveMonth">
                    Thu nhập
                </a>

                <a class="finance-chip @(Model.Filter.Type.Equals("expense") ? "active" : "")"
                   asp-route-Type="expense"
                   asp-route-Month="@Model.EffectiveMonth">
                    Chi tiêu
                </a>
            </div>

            <div class="filter-row">
                <div>
                    <label for="Month">Thời gian</label>
                    <select class="finance-select" id="Month" name="Month" data-autosubmit>
                        <option value="all" selected="@(isAll)">Tất cả thời gian</option>
                        @foreach (var m in Model.Months)
                        {
                            <option value="@m.Key" selected="@(Model.EffectiveMonth.Equals(m.Key))">
                                @m.Label
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <label for="CategoryId">Danh mục</label>
                    <select class="finance-select" id="CategoryId" name="CategoryId" data-autosubmit>
                        <option value="">Tất cả danh mục</option>
                        @foreach (var c in Model.Categories)
                        {
                            <option value="@c.Id" selected="@(Model.Filter.CategoryId == c.Id)">
                                @c.Name
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <label for="WalletId">Ví / tài khoản</label>
                    <select class="finance-select" id="WalletId" name="WalletId" data-autosubmit>
                        <option value="">Tất cả ví</option>
                        @foreach (var w in Model.Wallets)
                        {
                            <option value="@w.Id" selected="@(Model.Filter.WalletId == w.Id)">
                                @w.Name
                            </option>
                        }
                    </select>
                </div>

                <div>
                    <label for="From">Từ ngày</label>
                    <input class="finance-select" type="date" id="From" name="From"
                           value="@(Model.Filter.From?.ToString("yyyy-MM-dd"))" />
                </div>

                <div>
                    <label for="To">Đến ngày</label>
                    <input class="finance-select" type="date" id="To" name="To"
                           value="@(Model.Filter.To?.ToString("yyyy-MM-dd"))" />
                </div>

                <div>
                    <label for="Q">Tìm kiếm</label>
                    <input class="finance-select" type="search" id="Q" name="Q"
                           value="@Model.Filter.Q"
                           placeholder="Tên giao dịch..." />
                </div>

                <input type="hidden" name="Type" value="@Model.Filter.Type" />

                <button class="finance-btn" type="submit">Lọc</button>

                <a class="finance-btn"
                   asp-controller="Transaction"
                   asp-action="Index">
                    Đặt lại
                </a>
            </div>
        </form>

        <p class="result-count">
            Hiển thị <strong>@Model.Rows.Count</strong> giao dịch
        </p>

        <div class="table-responsive">
            <table class="transaction-table">
                <thead>
                    <tr>
                        <th>Giao dịch</th>
                        <th>Danh mục</th>
                        <th>Ví</th>
                        <th>Ngày</th>
                        <th class="right">Số tiền</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Rows.Any())
                    {
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>
                                    <strong>@row.Name</strong>
                                    <small class="muted">Mã giao dịch #@row.Id</small>
                                </td>

                                <td>
                                    <span class="dot" style="background:@row.CategoryColor"></span>
                                    @row.CategoryName
                                </td>

                                <td>@row.WalletName</td>

                                <td>@FinanceFormat.Date(row.Date.ToDateTime(TimeOnly.MinValue))</td>

                                <td class="right">
                                    <strong class="@(row.IsIncome ? "text-income" : "text-expense")">
                                        @row.AmountLabel
                                    </strong>
                                </td>

                                <td>
                                    <div class="row-actions">
                                        <a class="row-btn"
                                           asp-controller="Transaction"
                                           asp-action="Edit"
                                           asp-route-id="@row.Id">
                                            Sửa
                                        </a>

                                        <a class="row-btn danger"
                                           asp-controller="Transaction"
                                           asp-action="Delete"
                                           asp-route-id="@row.Id">
                                            Xóa
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6">
                                <div class="finance-empty">
                                    <span>⌕</span>
                                    <strong>Không tìm thấy giao dịch</strong>
                                    <p>Thử thay đổi bộ lọc hoặc khoảng thời gian.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

</div>
