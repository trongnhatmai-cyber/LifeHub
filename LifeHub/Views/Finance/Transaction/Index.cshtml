@{
    Layout = "_Layout";
    ViewData["Title"] = "Giao dịch";
    ViewData["ActivePage"] = "Transaction";
}

<div class="lh-soon">
    <h1>Giao dịch</h1>
    <p class="lh-soon-summary">Ghi lại từng khoản thu, khoản chi và chuyển giữa các ví.</p>
    <p class="lh-soon-note">Trang này đang được xây dựng. Hiện chưa có dữ liệu và chưa lưu được thay đổi.</p>

    <div class="lh-soon-grid">
        <section>
            <h2>Sẽ có trong trang này</h2>
            <ul>
                <li>Thêm khoản thu, khoản chi và chuyển giữa các ví</li>
                <li>Lọc theo ví, danh mục, thời gian; tìm theo ghi chú</li>
                <li>Mỗi khoản chi tự cộng vào mức "đã chi" của danh mục</li>
                <li>Biểu đồ thu chi theo tháng</li>
            </ul>
        </section>
        <section>
            <h2>Bảng dữ liệu sẽ dùng</h2>
            <ul class="lh-soon-tables">
                <li><code>transactions</code></li>
                <li><code>wallets</code></li>
                <li><code>categories</code></li>
                <li><code>budgets</code></li>
            </ul>
        </section>
    </div>

    <a asp-controller="Dashboard" asp-action="Index" class="lh-soon-back">Quay về Tổng quan</a>
</div>
