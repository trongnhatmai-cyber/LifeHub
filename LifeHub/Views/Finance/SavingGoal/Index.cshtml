@model LifeHub.Models.ViewModels.FinanceModules.SavingGoalPageViewModel
@using LifeHub.Models.ViewModels.FinanceModules
@{
    Layout = "_Layout"; ViewData["Title"] = "Mục tiêu tiết kiệm"; ViewData["ActivePage"] = "SavingGoal";
}
@section Styles { <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/finance-modules.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/finance-modules.js" asp-append-version="true" defer></script> }
<div class="finance-page" data-module="saving-goals">
    <header class="finance-heading">
    <div>
        <span class="finance-label">PERSONAL FINANCE MANAGEMENT</span>
        <h1>Mục tiêu tiết kiệm</h1>
        <p>Lập kế hoạch cho những điều quan trọng và theo dõi hành trình tích lũy.</p>
    </div>
    <div class="heading-actions">
        <a class="finance-btn" asp-controller="Finance" asp-action="Index">← Tổng quan</a>
        <a class="finance-btn primary" asp-controller="SavingGoal" asp-action="Create">＋ Tạo mục tiêu</a>
    </div>
</header>

    <section class="finance-summary">
        <article class="summary-card income-card"><div class="summary-top"><span>Đã tích lũy</span><span class="summary-badge">SAVED</span></div><h2>@FinanceFormat.Money(Model.TotalSaved)</h2><p>Tổng tiền của các mục tiêu</p></article>
        <article class="summary-card balance-card"><div class="summary-top"><span>Mục tiêu tổng</span><span class="summary-badge">TARGET</span></div><h2>@FinanceFormat.Money(Model.TotalTarget)</h2><p>Tổng số tiền cần đạt</p></article>
        <article class="summary-card saving-card"><div class="summary-top"><span>Đang thực hiện</span><span class="summary-badge">ACTIVE</span></div><h2>@Model.ActiveCount</h2><p>Mục tiêu chưa hoàn thành</p></article>
        <article class="summary-card expense-card"><div class="summary-top"><span>Đã hoàn thành</span><span class="summary-badge">ACHIEVED</span></div><h2>@Model.AchievedCount</h2><p>Mục tiêu đạt đích</p></article>
    </section>
    <section class="finance-card overall-goal"><div class="section-heading"><div><h3>Hành trình tiết kiệm</h3><p>Tổng tiến độ trên tất cả mục tiêu.</p></div><strong class="goal-overall-percent">@Model.OverallPercent.ToString("0")%</strong></div><div class="progress-track overall-track"><div style="width:@FinanceFormat.Css(Model.OverallPercent)%;"></div></div><div class="overall-meta"><span>@FinanceFormat.Money(Model.TotalSaved) đã tích lũy</span><span>Còn @FinanceFormat.Money(Math.Max(0, Model.TotalTarget - Model.TotalSaved))</span></div></section>
    <div class="section-heading goal-filter-heading"><div><h3>Danh sách mục tiêu</h3><p>Mỗi mục tiêu có tiến độ và thời hạn riêng.</p></div><nav class="finance-chips"><a class="finance-chip @(Model.Status == "active" ? "active" : "")" asp-route-status="active">Đang thực hiện</a><a class="finance-chip @(Model.Status == "achieved" ? "active" : "")" asp-route-status="achieved">Đã hoàn thành</a><a class="finance-chip @(Model.Status == "all" ? "active" : "")" asp-route-status="all">Tất cả</a></nav></div>
    <section class="goal-grid">
    @foreach (var goal in Model.Goals) {
        <article class="goal-card" style="--goal-color:@goal.Color"><div class="goal-head"><div class="goal-ring" style="--p:@FinanceFormat.Css(goal.Percent);--goal-color:@goal.Color"><div><strong>@goal.Percent.ToString("0")%</strong></div></div><div class="goal-title-wrap"><h3>@goal.Title</h3><span class="goal-state @goal.StateKey">@goal.StateLabel</span></div></div>
            <div class="goal-lines"><div><span>Đã tiết kiệm</span><strong>@FinanceFormat.Money(goal.CurrentAmount)</strong></div><div><span>Mục tiêu</span><strong>@FinanceFormat.Money(goal.TargetAmount)</strong></div><div><span>Còn cần</span><strong>@FinanceFormat.Money(goal.Remaining)</strong></div><div><span>Thời hạn</span><strong>@(goal.Deadline.HasValue ? FinanceFormat.Date(goal.Deadline.Value) : "Không đặt")</strong></div></div>
            <div class="progress-track"><div style="width:@FinanceFormat.Css(goal.Percent)%;background:@goal.Color"></div></div>
            @if (goal.SuggestedMonthly.HasValue) { <p class="goal-tip">Gợi ý tích lũy khoảng <strong>@FinanceFormat.Money(goal.SuggestedMonthly.Value)</strong> mỗi tháng để kịp thời hạn.</p> } else if (goal.IsAchieved) { <p class="goal-tip">Bạn đã hoàn thành mục tiêu này. Hãy tiếp tục duy trì thói quen tốt!</p> } else if (goal.IsOverdue) { <p class="goal-tip">Mục tiêu đã quá hạn. Bạn có thể điều chỉnh kế hoạch trong lần cập nhật tiếp theo.</p> }
            <div class="card-actions">
                <a class="finance-btn primary"
                asp-controller="SavingGoal"
                asp-action="Contribute"
                asp-route-id="@goal.Id">
                    ＋ Nạp tiền
                </a>

                <a class="row-btn"
                asp-controller="SavingGoal"
                asp-action="Edit"
                asp-route-id="@goal.Id">
                    Chỉnh sửa
                </a>

                <a class="row-btn"
                asp-controller="SavingGoal"
                asp-action="Delete"
                asp-route-id="@goal.Id">
                    Xóa
                </a>
            </div>
        </article>
    }
    @if (!Model.Goals.Any()) { 
        <div class="finance-card finance-empty">
            <span>◎</span>
            <strong>Chưa có mục tiêu trong bộ lọc này</strong>
            <p>Hãy tạo một mục tiêu tiết kiệm để bắt đầu theo dõi.</p>
            <a class="finance-btn primary"
                asp-controller="SavingGoal"
                asp-action="Create">
                    Tạo mục tiêu đầu tiên
            </a>
        </div> 
    }
    </section>
    <div class="finance-page-note">Tạo, chỉnh sửa, nạp tiền và xóa hiện chỉ mô phỏng giao diện; dữ liệu và số dư chưa thay đổi.</div>
</div>
