@{
    Layout = "_Layout";
    ViewData["Title"] = "Tạo mục tiêu tiết kiệm";
    ViewData["ActivePage"] = "SavingGoal";
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/finance-modules.css" asp-append-version="true" />
}

<div class="finance-page">
    <header class="finance-heading">
        <div>
            <span class="finance-label">SAVING PLAN</span>
            <h1>Tạo mục tiêu tiết kiệm</h1>
            <p>Lập kế hoạch cho mục tiêu tài chính của bạn.</p>
        </div>
        <a class="finance-btn" asp-controller="SavingGoal" asp-action="Index">← Quay lại</a>
    </header>

    <section class="finance-card">
        <form asp-controller="SavingGoal" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="modal-grid">
                <div>
                    <label for="Title">Tên mục tiêu</label>
                    <input class="finance-select" id="Title" name="Title"
                           required maxlength="100" placeholder="Ví dụ: Mua laptop" />
                </div>

                <div>
                    <label for="TargetAmount">Số tiền mục tiêu (₫)</label>
                    <input class="finance-select" id="TargetAmount" name="TargetAmount"
                           type="number" min="1" step="1000" required />
                </div>

                <div>
                    <label for="Deadline">Thời hạn</label>
                    <input class="finance-select" id="Deadline" name="Deadline" type="date" />
                </div>

                <div>
                    <label for="Color">Màu nhận diện</label>
                    <input class="finance-select" id="Color" name="Color"
                           type="color" value="#e11d48" />
                </div>
            </div>

            <div class="card-actions">
                <button class="finance-btn primary" type="submit">Tạo mục tiêu</button>
                <a class="finance-btn" asp-controller="SavingGoal" asp-action="Index">Hủy</a>
            </div>
        </form>
    </section>
</div>