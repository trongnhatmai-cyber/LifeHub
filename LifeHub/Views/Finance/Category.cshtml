@model IEnumerable<LifeHub.Models.ViewModels.FinanceManagement.CategoryViewModel>
@using System.Globalization
@{
    Layout = "_Layout";
    ViewData["Title"] = "Danh mục và ngân sách";
    ViewData["ActivePage"] = "Category";

    var categories = Model?.ToList() ?? new List<LifeHub.Models.ViewModels.FinanceManagement.CategoryViewModel>();
    var expenseCategories = categories.Where(x => string.Equals(x.Type, "expense", StringComparison.OrdinalIgnoreCase)).ToList();
    var incomeCategories = categories.Where(x => string.Equals(x.Type, "income", StringComparison.OrdinalIgnoreCase)).ToList();
    var totalLimit = expenseCategories.Sum(x => x.MonthlyLimit ?? x.Limit);
    var totalSpent = expenseCategories.Sum(x => x.SpentThisMonth > 0 ? x.SpentThisMonth : x.Spent);
    var configuredCount = expenseCategories.Count(x => (x.MonthlyLimit ?? x.Limit) > 0);
    var vi = CultureInfo.GetCultureInfo("vi-VN");
    var overallPercent = totalLimit > 0 ? Math.Min(100, (double)(totalSpent / totalLimit * 100m)) : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
}

<div class="finance-page" data-module="categories">
    <partial name="~/Views/Finance/_FinanceFlash.cshtml" />

    <header class="finance-heading">
        <div>
            <span class="finance-label">QUẢN LÝ TÀI CHÍNH</span>
            <h1>Danh mục và ngân sách</h1>
            <p>Phân loại dòng tiền và thiết lập hạn mức chi tiêu theo từng nhóm.</p>
        </div>
        <div class="heading-actions">
            <a class="finance-btn" asp-controller="Finance" asp-action="Index">← Tổng quan</a>
            <button type="button" class="finance-btn primary" data-open="categoryModal" data-mode="create" data-title="Thêm danh mục">+ Thêm danh mục</button>
        </div>
    </header>

    <section class="finance-summary">
        <article class="summary-card balance-card"><div class="summary-top"><span>Danh mục chi tiêu</span><span class="summary-badge">EXPENSE</span></div><h2>@expenseCategories.Count</h2><p>Nhóm phân loại khoản chi</p></article>
        <article class="summary-card income-card"><div class="summary-top"><span>Danh mục thu nhập</span><span class="summary-badge">INCOME</span></div><h2>@incomeCategories.Count</h2><p>Nhóm phân loại khoản thu</p></article>
        <article class="summary-card saving-card"><div class="summary-top"><span>Ngân sách đã thiết lập</span><span class="summary-badge">BUDGET</span></div><h2>@configuredCount</h2><p>Danh mục có hạn mức</p></article>
        <article class="summary-card expense-card"><div class="summary-top"><span>Tổng hạn mức</span><span class="summary-badge">MONTHLY LIMIT</span></div><h2>@totalLimit.ToString("N0", vi) ₫</h2><p>Trên các danh mục chi tiêu</p></article>
    </section>

    <section class="finance-card budget-overview">
        <div class="section-heading">
            <div><h3>Tình hình ngân sách tháng</h3><p>Tổng hợp theo hạn mức và số tiền đã chi.</p></div>
            <span class="budget-caption">@DateTime.Today.ToString("MMMM yyyy", vi)</span>
        </div>
        <div class="budget-total-row">
            <div><span>Đã sử dụng</span><strong>@totalSpent.ToString("N0", vi) ₫</strong></div>
            <div><span>Còn lại</span><strong>@Math.Max(0, totalLimit - totalSpent).ToString("N0", vi) ₫</strong></div>
            <div><span>Tiến độ</span><strong>@overallPercent.ToString("0")%</strong></div>
        </div>
        <div class="progress-track tall"><i style="width:@overallPercent.ToString(CultureInfo.InvariantCulture)%"></i></div>
        @if (configuredCount == 0)
        {
            <p class="finance-note">Bạn chưa thiết lập hạn mức ngân sách cho các danh mục.</p>
        }
    </section>

    <section class="finance-card category-management-card">
        <div class="section-heading">
            <div><h3>Danh sách danh mục</h3><p>Quản lý các nhóm thu nhập và chi tiêu.</p></div>
            <div class="finance-chips" role="group" aria-label="Lọc danh mục">
                <button class="finance-chip active" type="button" data-category-filter="all">Tất cả</button>
                <button class="finance-chip" type="button" data-category-filter="expense">Chi tiêu</button>
                <button class="finance-chip" type="button" data-category-filter="income">Thu nhập</button>
            </div>
        </div>

        <div class="category-management-grid">
            @foreach (var cat in categories)
            {
                var kind = string.Equals(cat.Type, "income", StringComparison.OrdinalIgnoreCase) ? "income" : "expense";
                var limit = cat.MonthlyLimit ?? cat.Limit;
                var spent = cat.SpentThisMonth > 0 ? cat.SpentThisMonth : cat.Spent;
                var percent = limit > 0 ? Math.Min(100, (double)(spent / limit * 100m)) : 0;
                var color = string.IsNullOrWhiteSpace(cat.Color) ? "#e98ba5" : cat.Color;

                <article class="category-management-item" data-category-kind="@kind" style="--category-color:@color">
                    <div class="category-management-top">
                        <span class="category-symbol">@(string.IsNullOrWhiteSpace(cat.Icon) ? (kind == "income" ? "↗" : "↘") : cat.Icon)</span>
                        <span class="category-type-pill @kind">@(kind == "income" ? "Thu nhập" : "Chi tiêu")</span>
                    </div>
                    <h3>@cat.Name</h3>
                    <div class="category-budget-values"><span>Đã sử dụng</span><strong>@spent.ToString("N0", vi) ₫</strong></div>
                    <div class="category-budget-values"><span>Hạn mức tháng</span><strong>@(limit > 0 ? limit.ToString("N0", vi) + " ₫" : "Chưa thiết lập")</strong></div>
                    <div class="progress-track"><i style="width:@percent.ToString(CultureInfo.InvariantCulture)%"></i></div>
                    <small class="category-percent">@(limit > 0 ? percent.ToString("0", CultureInfo.InvariantCulture) + "% ngân sách" : "Chưa có ngân sách")</small>
                    <div class="card-actions">
                        @if (cat.IsDefault)
                        {
                            <span class="summary-badge">MẶC ĐỊNH</span>
                        }
                        else
                        {
                            <button type="button" class="row-btn" data-open="categoryModal" data-mode="edit"
                                    data-action="@Url.Action("Edit", "Category")" data-title="Chỉnh sửa danh mục"
                                    data-id="@cat.Id" data-name="@cat.Name" data-type="@(kind == "income" ? "Income" : "Expense")"
                                    data-color="@color" data-icon="@cat.Icon" data-parentid="@cat.ParentId">Chỉnh sửa</button>
                            <button type="button" class="row-btn danger" data-open="deleteModal" data-mode="delete"
                                    data-action="@Url.Action("Delete", "Category")" data-id="@cat.Id" data-name="@cat.Name"
                                    data-note="Các giao dịch thuộc danh mục này sẽ chuyển thành Chưa phân loại.">Xóa</button>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="finance-empty" id="categoryFilterEmpty" hidden="@(categories.Any() ? "hidden" : null)">
            Chưa có danh mục trong mục này. Bấm "+ Thêm danh mục" để tạo mới.
        </div>
    </section>

    @* ---------- THÊM / SỬA DANH MỤC (Category/Create, Category/Edit) ----------
       Ô ẩn Icon và ParentId PHẢI giữ lại: action Edit ghi đè cả hai, thiếu sẽ làm mất biểu tượng và danh mục cha.
       BACKEND_REQUIRED: khi CategoryService lưu được hạn mức tháng (MonthlyLimit), thêm lại ô sau vào form:
         <div class="field full" data-show-for="expense"><label for="catLimit">Hạn mức mỗi tháng (₫)</label>
         <input id="catLimit" name="MonthlyLimit" type="number" min="0" step="1" /></div> *@
         
    <div class="finance-modal" id="categoryModal" role="dialog" aria-modal="true" aria-labelledby="categoryModalTitle" hidden>
        <div class="finance-modal-box narrow">
            <div class="finance-modal-head">
                <h3 id="categoryModalTitle" data-modal-title>Thêm danh mục</h3>
                <button type="button" class="finance-modal-close" data-close aria-label="Đóng">&times;</button>
            </div>
            <form asp-controller="Category" asp-action="Create" method="post">
                <input type="hidden" name="Id" disabled />
                <input type="hidden" name="Icon" />
                <input type="hidden" name="ParentId" />
                <div class="finance-form-grid">
                    <div class="field full">
                        <label for="catName">Tên danh mục</label>
                        <input id="catName" name="Name" maxlength="100" placeholder="Ví dụ: Ăn uống" required />
                    </div>
                    <div class="field">
                        <label for="catType">Loại danh mục</label>
                        <select id="catType" name="Type" required>
                            <option value="Expense">Chi tiêu</option>
                            <option value="Income">Thu nhập</option>
                        </select>
                    </div>
                    <div class="field">
                        <label for="catColor">Màu danh mục</label>
                        <input id="catColor" name="Color" type="color" value="#e98ba5" />
                    </div>
                </div>
                <p class="form-error" role="alert" hidden></p>
                <div class="finance-modal-foot">
                    <button type="button" class="finance-btn" data-close>Hủy</button>
                    <button type="submit" class="finance-btn primary">Lưu danh mục</button>
                </div>
            </form>
        </div>
    </div>

    <partial name="~/Views/Finance/_FinanceDeleteModal.cshtml" />
</div>

@section Scripts {
    <script src="~/js/finance.js" asp-append-version="true"></script>
}
