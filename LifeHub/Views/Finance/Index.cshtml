@model LifeHub.Models.ViewModels.FinanceManagement.FinanceViewModel
@using System.Globalization
@using LifeHub.Models.ViewModels.FinanceModules

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý tài chính";
    // Khóa mục con trong _Layout.cshtml: để mục "Tổng quan tài chính" được tô sáng.
    ViewData["ActivePage"] = "FinanceOverview";

    var balance = Model.TotalIncome - Model.TotalExpense;

    var expenseCategories = Model.Categories?
        .Where(c => string.Equals(c.Type, "Expense", StringComparison.OrdinalIgnoreCase))
        .ToList() ?? new List<LifeHub.Models.ViewModels.FinanceManagement.FinanceCategoryViewModel>();

    var monthlyBudget = Model.MonthlyBudgetDetails;
    var hasBudget = monthlyBudget != null && (monthlyBudget.Limit > 0 || monthlyBudget.CategoryBudgets.Any());
    double budgetPercent = hasBudget && monthlyBudget!.Limit > 0
        ? Math.Min(100, (double)(monthlyBudget.Spent / monthlyBudget.Limit * 100m))
        : 0;

    // Màu thanh tiến độ: từ 80% cảnh báo, từ 100% vượt hạn mức (class warn / over trong finance.css mục 8)
    string Bar(double pct) => pct >= 100 ? "over" : pct >= 80 ? "warn" : "";
    string W(double pct) => pct.ToString("0.#", CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
}

<div class="finance-page" data-module="overview">
    <partial name="~/Views/Finance/_FinanceFlash.cshtml" />

    <!-- TIÊU ĐỀ -->
    <header class="finance-heading">
        <div>
            <span class="finance-label">QUẢN LÝ TÀI CHÍNH</span>
            <h1>Tài chính của bạn</h1>
            <p>Theo dõi dòng tiền, kiểm soát chi tiêu và xây dựng tương lai tài chính.</p>
        </div>
        <div class="heading-actions">
            <select class="finance-select" id="monthFilter" aria-label="Chọn tháng xem lịch sử giao dịch">
                <option value="all">Tất cả giao dịch</option>
            </select>
            <button type="button" class="finance-btn primary" data-open="transactionModal" data-mode="create" data-title="Thêm giao dịch">+ Thêm giao dịch</button>
        </div>
    </header>

    <!-- 4 THẺ CHỈ SỐ -->
    <section class="finance-summary">
        <div class="summary-card income-card">
            <div class="summary-top"><span>Tổng thu nhập</span><span class="summary-badge">THU VÀO</span></div>
            <h2>@FinanceFormat.Money(Model.TotalIncome)</h2>
            <p>Thu nhập trong tháng</p>
        </div>
        <div class="summary-card expense-card">
            <div class="summary-top"><span>Tổng chi tiêu</span><span class="summary-badge">CHI RA</span></div>
            <h2>@FinanceFormat.Money(Model.TotalExpense)</h2>
            <p>Chi tiêu trong tháng</p>
        </div>
        <div class="summary-card balance-card">
            <div class="summary-top"><span>Chênh lệch tháng</span><span class="summary-badge">BALANCE</span></div>
            <h2 class="@(balance >= 0 ? "text-income" : "text-expense")">@FinanceFormat.Money(balance)</h2>
            <p>Thu nhập trừ chi tiêu</p>
        </div>
        <div class="summary-card saving-card">
            <div class="summary-top"><span>Tiết kiệm</span><span class="summary-badge">SAVING</span></div>
            <h2>@FinanceFormat.Money(Model.TotalSaving)</h2>
            <p>Tổng tiền dành dụm</p>
        </div>
    </section>

    <!-- BIỂU ĐỒ DÒNG TIỀN VÀ PHÂN BỔ CHI TIÊU -->
    <div class="finance-grid">
        <div class="finance-card">
            <div class="section-heading">
                <div><h3>Dòng tiền của bạn</h3><p>So sánh thu nhập và chi tiêu</p></div>
                <div class="heading-actions">
                    <select class="finance-select" id="chartPeriod" aria-label="Khoảng thời gian biểu đồ">
                        <option value="month" selected>6 tháng</option>
                        <option value="week">Theo tuần</option>
                    </select>
                    <select class="finance-select" id="chartWeek" aria-label="Chọn tuần xem biểu đồ" hidden>
                        @if (Model.CashFlow?.WeeklyData != null)
                        {
                            for (var i = 0; i < Model.CashFlow.WeeklyData.Count; i++)
                            {
                                <option value="@i">@Model.CashFlow.WeeklyData[i].Label</option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="chart-legend">
                <span><i class="legend-income"></i> Thu nhập</span>
                <span><i class="legend-expense"></i> Chi tiêu</span>
            </div>

            <div class="money-chart">
                <div class="chart-y-labels" id="chartYLabels"><span>30tr</span><span>20tr</span><span>10tr</span><span>0</span></div>
                <div class="chart-content">
                    <div class="chart-grid-lines"><span></span><span></span><span></span><span></span></div>
                    <div class="chart-columns" id="chartColumns"><!-- finance.js vẽ cột từ dữ liệu bên dưới --></div>
                </div>
            </div>

            <!-- Nguồn dữ liệu biểu đồ: C# render, JS chỉ đọc để vẽ (không tự tính) -->
            <div id="monthlyChartData" hidden>
                @if (Model.CashFlow?.MonthlyData != null)
                {
                    foreach (var point in Model.CashFlow.MonthlyData)
                    {
                        <span class="chart-point" data-label="@point.Label"
                              data-income="@point.Income.ToString(CultureInfo.InvariantCulture)"
                              data-expense="@point.Expense.ToString(CultureInfo.InvariantCulture)"></span>
                    }
                }
            </div>
            <div id="weeklyChartData" hidden>
                @if (Model.CashFlow?.WeeklyData != null)
                {
                    for (var i = 0; i < Model.CashFlow.WeeklyData.Count; i++)
                    {
                        <div class="week-data" data-week-index="@i">
                            @foreach (var day in Model.CashFlow.WeeklyData[i].Days)
                            {
                                <span class="chart-point" data-label="@day.Label" data-date="@day.Date.ToString("yyyy-MM-dd")"
                                      data-income="@day.Income.ToString(CultureInfo.InvariantCulture)"
                                      data-expense="@day.Expense.ToString(CultureInfo.InvariantCulture)"></span>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <div class="finance-card">
            <div class="section-heading">
                <div><h3>Phân bổ chi tiêu</h3><p>Các khoản chi theo danh mục</p></div>
                <a asp-controller="Category" asp-action="Index" class="finance-btn small">Quản lý danh mục</a>
            </div>

            <div class="expense-total">
                <span>Tổng chi tiêu</span>
                <h2>@FinanceFormat.Money(Model.TotalExpense)</h2>
            </div>

            @if (expenseCategories.Any())
            {
                <div class="category-list">
                    @foreach (var cat in expenseCategories)
                    {
                        double pct = cat.Limit > 0 ? Math.Min(100, Math.Round((double)(cat.Spent / cat.Limit * 100m))) : 0;
                        <div class="category-item">
                            <div class="category-info">
                                <span>@cat.Name</span>
                                @if (cat.Limit > 0)
                                {
                                    <strong>@FinanceFormat.Money(cat.Spent) / @FinanceFormat.Money(cat.Limit) (@W(pct)%)</strong>
                                }
                                else
                                {
                                    <strong>@FinanceFormat.Money(cat.Spent)</strong>
                                }
                            </div>
                            @if (cat.Limit > 0)
                            {
                                <div class="progress-track"><i class="@Bar(pct)" style="width:@W(pct)%"></i></div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="finance-empty">Chưa có dữ liệu chi tiêu.</div>
            }
        </div>
    </div>

    <!-- NGÂN SÁCH THÁNG -->
    <section class="finance-card finance-block">
        <div class="section-heading">
            <div><h3>Ngân sách tháng</h3><p>Theo dõi giới hạn chi tiêu tổng thể</p></div>
            <span class="summary-badge">@DateTime.Today.ToString("MM/yyyy")</span>
        </div>

        @if (hasBudget)
        {
            <div class="expense-total">
                <span>Đã sử dụng</span>
                <h2>@FinanceFormat.Money(monthlyBudget!.Spent) / @FinanceFormat.Money(monthlyBudget.Limit)</h2>
            </div>
            <div class="progress-track tall"><i class="@Bar(budgetPercent)" style="width:@W(budgetPercent)%"></i></div>
            <div class="category-info spaced">
                <span>Đã sử dụng: @W(budgetPercent)%</span>
                <strong>Còn lại: @FinanceFormat.Money(monthlyBudget.Remaining)</strong>
            </div>

            @if (monthlyBudget.CategoryBudgets.Any())
            {
                <div class="category-list roomy">
                    @foreach (var budget in monthlyBudget.CategoryBudgets)
                    {
                        double bp = Math.Min(100, (double)budget.UsagePercent);
                        <div class="category-item">
                            <div class="category-info">
                                <span>@budget.Category</span>
                                <strong>@FinanceFormat.Money(budget.Spent) / @FinanceFormat.Money(budget.Limit)</strong>
                            </div>
                            <div class="progress-track"><i class="@Bar(bp)" style="width:@W(bp)%"></i></div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="finance-empty">Chưa có dữ liệu ngân sách tháng.</div>
        }
    </section>

    <!-- MỤC TIÊU TIẾT KIỆM -->
    <section class="finance-card finance-block">
        <div class="section-heading">
            <div><h3>Mục tiêu tiết kiệm</h3><p>Theo dõi tiến độ các mục tiêu của bạn</p></div>
            <a asp-controller="SavingGoal" asp-action="Index" class="finance-btn small">Quản lý mục tiêu</a>
        </div>

        @if (Model.SavingGoals != null && Model.SavingGoals.Any())
        {
            <div class="category-list roomy">
                @foreach (var goal in Model.SavingGoals)
                {
                    double gp = (double)goal.ProgressPercent;
                    <div class="category-item">
                        <div class="category-info">
                            <span>@goal.Title</span>
                            <strong>@FinanceFormat.Money(goal.CurrentAmount) / @FinanceFormat.Money(goal.TargetAmount)</strong>
                        </div>
                        <div class="progress-track"><i style="width:@W(gp)%"></i></div>
                        <div class="category-info spaced">
                            <span>Tiến độ: @W(gp)%</span>
                            <span>@(goal.Deadline.HasValue ? "Hạn: " + goal.Deadline.Value.ToString("dd/MM/yyyy") : "Chưa đặt thời hạn")</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="finance-empty">Chưa có mục tiêu tiết kiệm nào.</div>
        }
    </section>

    <!-- LỊCH SỬ GIAO DỊCH (lọc nhanh phía trình duyệt trên các hàng Razor đã render sẵn) -->
    <section class="finance-card finance-block">
        <div class="section-heading">
            <div><h3>Lịch sử giao dịch</h3><p>Giao dịch trong tháng hiện tại</p></div>
            <div class="heading-actions">
                <select class="finance-select" id="transactionFilter" aria-label="Lọc loại giao dịch">
                    <option value="all" selected>Tất cả giao dịch</option>
                    <option value="income">Khoản thu</option>
                    <option value="expense">Khoản chi</option>
                </select>
                <a asp-controller="Transaction" asp-action="Index" class="finance-btn">Xem tất cả</a>
                <button type="button" class="finance-btn primary" data-open="transactionModal" data-mode="create" data-title="Thêm giao dịch">+ Thêm giao dịch</button>
            </div>
        </div>

        <div class="filter-row inline">
            <div><label for="startDateFilter">Từ ngày</label><input type="date" class="finance-select" id="startDateFilter" /></div>
            <div><label for="endDateFilter">Đến ngày</label><input type="date" class="finance-select" id="endDateFilter" /></div>
            <button type="button" class="finance-btn" id="clearDateFilter">Xóa lọc ngày</button>
        </div>

        <div class="table-wrap">
            <table class="finance-table">
                <thead>
                    <tr><th>Nội dung</th><th>Danh mục</th><th>Ngày</th><th class="right">Số tiền</th></tr>
                </thead>
                <tbody id="transactionBody">
                    @if (Model.Transactions != null)
                    {
                        foreach (var t in Model.Transactions)
                        {
                            var kind = (t.Type ?? "").ToLowerInvariant();
                            <tr data-type="@kind" data-date="@t.Date.ToString("yyyy-MM-dd")" data-month="@t.Date.ToString("yyyy-MM")">
                                <td><strong>@t.Name</strong></td>
                                <td><span class="summary-badge">@t.Category</span></td>
                                <td class="muted">@t.Date.ToString("dd/MM/yyyy")</td>
                                <td class="right">
                                    <strong class="@(kind == "income" ? "text-income" : kind == "transfer" ? "" : "text-expense")">
                                        @(kind == "income" ? "+" : kind == "transfer" ? "↔ " : "-")@FinanceFormat.Money(t.Amount)
                                    </strong>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="finance-empty" id="emptyTransactions" hidden="@(Model.Transactions != null && Model.Transactions.Any() ? "hidden" : null)">
            Chưa có giao dịch nào được ghi nhận. Bấm "+ Thêm giao dịch" để bắt đầu.
        </div>
    </section>

    <partial name="~/Views/Finance/_TransactionModals.cshtml" model='"overview"' />
</div>

@section Scripts {
    <script src="~/js/finance.js" asp-append-version="true"></script>
}
