@model LifeHub.Models.ViewModels.FinanceManagement.FinanceViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý tài chính";
    ViewData["ActivePage"] = "Finance";

    var balance = Model.TotalIncome - Model.TotalExpense;
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/finance.js" asp-append-version="true" defer></script>
}

<div class="finance-page">
    <!-- TIÊU ĐỀ PHÂN HỆ -->
    <header class="finance-heading">
        <div>
            <span class="finance-label">PERSONAL FINANCE MANAGEMENT</span>
            <h1>Tài chính của bạn</h1>
            <p>Theo dõi dòng tiền, kiểm soát chi tiêu và xây dựng tương lai tài chính.</p>
        </div>

        <div class="heading-actions">
            <select class="finance-select" id="monthFilter" aria-label="Chọn tháng xem báo cáo">
                <option value="11/2026" selected>Tháng 11 / 2026</option>
                <option value="10/2026">Tháng 10 / 2026</option>
                <option value="09/2026">Tháng 09 / 2026</option>
            </select>

            <button type="button" class="finance-btn primary" id="openTransaction">
                + Thêm giao dịch
            </button>
        </div>
    </header>

    <!-- 4 THẺ CHỈ SỐ PASTEL HỒNG TỔNG QUAN (BINDING TỪ VIEWMODEL) -->
    <section class="finance-summary">
        <div class="summary-card income-card">
            <div class="summary-top">
                <span>Tổng thu nhập</span>
                <span class="summary-badge">THU VÀO</span>
            </div>
            <h2 id="totalIncome">@Model.TotalIncome.ToString("N0") ₫</h2>
            <p>Thu nhập trong tháng</p>
        </div>

        <div class="summary-card expense-card">
            <div class="summary-top">
                <span>Tổng chi tiêu</span>
                <span class="summary-badge">CHI RA</span>
            </div>
            <h2 id="totalExpense">@Model.TotalExpense.ToString("N0") ₫</h2>
            <p>Chi tiêu trong tháng</p>
        </div>

        <div class="summary-card balance-card">
            <div class="summary-top">
                <span>Số dư hiện tại</span>
                <span class="summary-badge">BALANCE</span>
            </div>
            <h2 id="totalBalance">@balance.ToString("N0") ₫</h2>
            <p>Thu nhập trừ chi tiêu</p>
        </div>

        <div class="summary-card saving-card">
            <div class="summary-top">
                <span>Tiết kiệm</span>
                <span class="summary-badge">SAVING</span>
            </div>
            <h2 id="savingProgress">@Model.TotalSaving.ToString("N0") ₫</h2>
            <p>Tổng tiền dành dụm</p>
        </div>
    </section>

    <!-- KHỐI BIỂU ĐỒ & PHÂN BỔ CHI TIÊU -->
    <div class="finance-grid">
        <!-- DÒNG TIỀN CỦA BẠN (BIỂU ĐỒ SO SÁNH THU NHẬP VÀ CHI TIÊU) -->
        <div class="finance-card">
            <div class="section-heading">
                <div>
                    <h3>Dòng tiền của bạn</h3>
                    <p>So sánh thu nhập và chi tiêu</p>
                </div>
                <select class="finance-select" id="chartPeriod" aria-label="Khoảng thời gian biểu đồ">
                    <option value="month" selected>6 tháng</option>
                    <option value="week">Theo tuần</option>
                </select>
            </div>

            <div class="chart-legend">
                <span><i class="legend-income"></i> Thu nhập</span>
                <span><i class="legend-expense"></i> Chi tiêu</span>
            </div>

            <div class="money-chart">
                <div class="chart-y-labels">
                    <span>30tr</span>
                    <span>20tr</span>
                    <span>10tr</span>
                    <span>0</span>
                </div>
                <div class="chart-content">
                    <div class="chart-grid-lines">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <div class="chart-columns" id="chartColumns">
                        <!-- Biểu đồ được tự động vẽ bởi finance.js -->
                    </div>
                </div>
            </div>
        </div>

        <!-- PHÂN BỔ CHI TIÊU THEO DANH MỤC -->
        <div class="finance-card">
            <div class="section-heading">
                <div>
                    <h3>Phân bổ chi tiêu</h3>
                    <p>Các khoản chi trong tháng</p>
                </div>
                <a asp-controller="Category" asp-action="Index" class="finance-btn" style="text-decoration:none;font-size:12px;padding:4px 10px;min-height:32px;">
                    Quản lý danh mục
                </a>
            </div>

            <div class="expense-total">
                <span>Tổng chi tiêu</span>
                <h2 id="expenseBreakdown">@Model.TotalExpense.ToString("N0") ₫</h2>
            </div>

            @if (Model.Categories != null && Model.Categories.Any(c => c.Type == "expense"))
            {
                <div class="category-list" id="categoryList">
                    @foreach (var cat in Model.Categories.Where(c => c.Type == "expense"))
                    {
                        var pct = cat.Limit > 0 ? Math.Min(100, Math.Round((double)(cat.Spent / cat.Limit * 100))) : 0;
                        <div class="category-item" style="margin-bottom:14px;">
                            <div class="category-info">
                                <span>@cat.Name</span>
                                <strong>@cat.Spent.ToString("N0") ₫ / @cat.Limit.ToString("N0") ₫ (@pct%)</strong>
                            </div>
                            <div class="progress-track" style="height:7px;border-radius:10px;overflow:hidden;background:var(--finance-soft);">
                                <div style="width:@pct%;height:100%;border-radius:10px;background:var(--finance-accent);transition:width 0.4s ease;"></div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div id="emptyCategory" class="empty-state" style="text-align:center;padding:45px 15px;color:var(--finance-muted);font-size:13px;">
                    Chưa có dữ liệu chi tiêu.
                </div>
            }
        </div>
    </div>

    <!-- DANH SÁCH GIAO DỊCH (LẤY TỪ VIEWMODEL) -->
    <section class="finance-card" style="margin-top: 18px;">
        <div class="section-heading">
            <div>
                <h3>Lịch sử giao dịch</h3>
                <p>Danh sách các khoản thu và chi gần nhất từ ViewModel</p>
            </div>
            <div class="transaction-filters">
                <select class="finance-select" id="transactionFilter" aria-label="Lọc loại giao dịch">
                    <option value="all" selected>Tất cả giao dịch</option>
                    <option value="income">Khoản thu</option>
                    <option value="expense">Khoản chi</option>
                </select>
                <button type="button" class="finance-btn primary" id="openTransaction2">
                    + Thêm giao dịch
                </button>
            </div>
        </div>

        <div style="overflow-x:auto;">
            <table class="finance-table" style="width:100%;border-collapse:collapse;font-size:13px;">
                <thead>
                    <tr style="border-bottom:1px solid var(--finance-border);color:var(--finance-muted);text-align:left;">
                        <th style="padding:12px 10px;">NỘI DUNG</th>
                        <th style="padding:12px 10px;">DANH MỤC</th>
                        <th style="padding:12px 10px;">NGÀY</th>
                        <th style="padding:12px 10px;text-align:right;">SỐ TIỀN</th>
                    </tr>
                </thead>
                <tbody id="transactionBody">
                    @if (Model.Transactions != null && Model.Transactions.Any())
                    {
                        @foreach (var t in Model.Transactions)
                        {
                            <tr data-type="@t.Type" style="border-bottom:1px solid var(--finance-border);transition:background 0.15s ease;">
                                <td style="padding:12px 10px;font-weight:600;">@t.Name</td>
                                <td style="padding:12px 10px;"><span class="summary-badge" style="font-size:10px;">@t.Category</span></td>
                                <td style="padding:12px 10px;color:var(--finance-muted);">@t.Date.ToString("dd/MM/yyyy")</td>
                                <td style="padding:12px 10px;text-align:right;font-weight:700;color:@(t.Type == "income" ? "var(--finance-income)" : "var(--finance-expense)");">
                                    @(t.Type == "income" ? "+" : "-")@t.Amount.ToString("N0") ₫
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div id="emptyTransactions" style="display:@(Model.Transactions != null && Model.Transactions.Any() ? "none" : "block");text-align:center;padding:35px 20px;color:var(--finance-muted);font-size:13px;">
            Chưa có giao dịch nào được ghi nhận.
        </div>
    </section>

    <!-- MODAL THÊM GIAO DỊCH -->
    <div class="finance-modal" id="transactionModal" aria-hidden="true" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99;align-items:center;justify-content:center;padding:20px;">
        <div class="finance-modal-content" style="background:var(--finance-bg);color:var(--finance-text);border:1px solid var(--finance-border);border-radius:18px;max-width:480px;width:100%;padding:24px;box-shadow:var(--finance-shadow);">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
                <h3 style="margin:0;font-size:17px;font-weight:750;">Thêm giao dịch mới</h3>
                <button type="button" id="closeModal" style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--finance-muted);">&times;</button>
            </div>

            <form id="transactionForm" method="post" asp-controller="Finance" asp-action="CreateTransaction">
                <div style="margin-bottom:14px;">
                    <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--finance-text);">Nội dung giao dịch</label>
                    <input type="text" id="transactionName" name="Title" class="finance-select" style="width:100%;" placeholder="VD: Mua sách, Tiền lương..." required />
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
                    <div>
                        <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--finance-text);">Loại giao dịch</label>
                        <select id="transactionType" name="Type" class="finance-select" style="width:100%;">
                            <option value="expense" selected>Chi tiêu</option>
                            <option value="income">Thu nhập</option>
                        </select>
                    </div>

                    <div>
                        <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--finance-text);">Danh mục</label>
                        <select id="transactionCategory" name="CategoryId" class="finance-select" style="width:100%;" required>
                            <option value="" disabled selected>Chọn danh mục</option>
                            @if (Model.Categories != null && Model.Categories.Any())
                                {
                                    foreach (var c in Model.Categories)
                                    {
                                        <option value="@c.Id" data-type="@c.Type">@c.Name</option>
                                    }
                                }
                        </select>
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;">
                    <div>
                        <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--finance-text);">Số tiền (VNĐ)</label>
                        <input type="number" id="transactionAmount" name="Amount" min="1000" step="1000" class="finance-select" style="width:100%;" placeholder="VD: 50000" required />
                    </div>

                    <div>
                        <label style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--finance-text);">Ngày</label>
                        <input type="date" id="transactionDate" name="Date" class="finance-select" style="width:100%;" required />
                    </div>
                </div>

                <div style="display:flex;justify-content:flex-end;gap:10px;">
                    <button type="button" class="finance-btn" id="cancelTransaction">Hủy</button>
                    <button type="submit" class="finance-btn primary">Lưu giao dịch</button>
                </div>
            </form>
        </div>
    </div>
</div>
