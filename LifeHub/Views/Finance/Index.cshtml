
@model LifeHub.Models.ViewModels.FinanceManagement.FinanceViewModel

@using System.Globalization

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý tài chính";
    ViewData["ActivePage"] = "Finance";

    var balance = Model.TotalIncome - Model.TotalExpense;

    var expenseCategories = Model.Categories?
        .Where(c => string.Equals(c.Type, "Expense", StringComparison.OrdinalIgnoreCase))
        .ToList() ?? new List<LifeHub.Models.ViewModels.FinanceManagement.FinanceCategoryViewModel>();

    var monthlyBudget = Model.MonthlyBudgetDetails;
    var budgetPercent = monthlyBudget != null && monthlyBudget.Limit > 0
        ? Math.Min(100, monthlyBudget.Spent / monthlyBudget.Limit * 100)
        : 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/finance.js" asp-append-version="true" defer></script>
}

<div class="finance-page">

    <!-- TIÊU ĐỀ -->
    <header class="finance-heading">
        <div>
            <span class="finance-label">PERSONAL FINANCE MANAGEMENT</span>
            <h1>Tài chính của bạn</h1>
            <p>Theo dõi dòng tiền, kiểm soát chi tiêu và xây dựng tương lai tài chính.</p>
        </div>

        <div class="heading-actions">
            <select class="finance-select" id="monthFilter"
                    aria-label="Chọn tháng xem báo cáo">
                <option value="all">Tất cả giao dịch</option>
            </select>

            <button type="button" class="finance-btn primary" id="openTransaction">
                + Thêm giao dịch
            </button>
        </div>
    </header>

    <!-- TỔNG QUAN TÀI CHÍNH -->
    <section class="finance-summary">

        <div class="summary-card income-card">
            <div class="summary-top">
                <span>Tổng thu nhập</span>
                <span class="summary-badge">THU VÀO</span>
            </div>
            <h2 id="totalIncome">@Model.TotalIncome.ToString("N0") ₫</h2>
            <p>Thu nhập trong tháng</p>
        </div>

        <div class="summary-card expense-card">
            <div class="summary-top">
                <span>Tổng chi tiêu</span>
                <span class="summary-badge">CHI RA</span>
            </div>
            <h2 id="totalExpense">@Model.TotalExpense.ToString("N0") ₫</h2>
            <p>Chi tiêu trong tháng</p>
        </div>

        <div class="summary-card balance-card">
            <div class="summary-top">
                <span>Số dư hiện tại</span>
                <span class="summary-badge">BALANCE</span>
            </div>
            <h2 id="totalBalance">@balance.ToString("N0") ₫</h2>
            <p>Thu nhập trừ chi tiêu</p>
        </div>

        <div class="summary-card saving-card">
            <div class="summary-top">
                <span>Tiết kiệm</span>
                <span class="summary-badge">SAVING</span>
            </div>
            <h2 id="savingProgress">@Model.TotalSaving.ToString("N0") ₫</h2>
            <p>Tổng tiền dành dụm</p>
        </div>

    </section>

    <!-- BIỂU ĐỒ VÀ PHÂN BỔ CHI TIÊU -->
    <div class="finance-grid">

        <!-- BIỂU ĐỒ DÒNG TIỀN -->
        <div class="finance-card">
            <div class="section-heading">
                <div>
                    <h3>Dòng tiền của bạn</h3>
                    <p>So sánh thu nhập và chi tiêu</p>
                </div>

                <div class="heading-actions">
                    <select class="finance-select" id="chartPeriod"
                            aria-label="Khoảng thời gian biểu đồ">
                        <option value="month" selected>6 tháng</option>
                        <option value="week">Theo tuần</option>
                    </select>

                    <select class="finance-select" id="chartWeek"
                            aria-label="Chọn tuần xem biểu đồ"
                            style="display:none;">
                        @if (Model.CashFlow?.WeeklyData != null)
                        {
                            for (var i = 0; i < Model.CashFlow.WeeklyData.Count; i++)
                            {
                                var week = Model.CashFlow.WeeklyData[i];

                                <option value="@i">
                                    @week.Label
                                </option>
                            }
                        }
                    </select>
                </div>
            </div>

            <div class="chart-legend">
                <span><i class="legend-income"></i> Thu nhập</span>
                <span><i class="legend-expense"></i> Chi tiêu</span>
            </div>

            <div class="money-chart">
                <div class="chart-y-labels">
                    <span>30tr</span>
                    <span>20tr</span>
                    <span>10tr</span>
                    <span>0</span>
                </div>

                <div class="chart-content">
                    <div class="chart-grid-lines">
                        <span></span>
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>

                    <div class="chart-columns" id="chartColumns">
                        <!-- finance.js sẽ vẽ biểu đồ từ dữ liệu bên dưới -->
                    </div>
                </div>
            </div>

            <!-- NGUỒN DỮ LIỆU BIỂU ĐỒ THÁNG -->
            <div id="monthlyChartData" hidden>
                @if (Model.CashFlow?.MonthlyData != null)
                {
                    foreach (var point in Model.CashFlow.MonthlyData)
                    {
                        <span class="chart-point"
                              data-label="@point.Label"
                              data-income="@point.Income.ToString(CultureInfo.InvariantCulture)"
                              data-expense="@point.Expense.ToString(CultureInfo.InvariantCulture)">
                        </span>
                    }
                }
            </div>

            <!-- NGUỒN DỮ LIỆU BIỂU ĐỒ TUẦN -->
            <div id="weeklyChartData" hidden>
                @if (Model.CashFlow?.WeeklyData != null)
                {
                    for (var i = 0; i < Model.CashFlow.WeeklyData.Count; i++)
                    {
                        var week = Model.CashFlow.WeeklyData[i];

                        <div class="week-data" data-week-index="@i">
                            @foreach (var day in week.Days)
                            {
                                <span class="chart-point"
                                      data-label="@day.Label"
                                      data-date="@day.Date.ToString("yyyy-MM-dd")"
                                      data-income="@day.Income.ToString(CultureInfo.InvariantCulture)"
                                      data-expense="@day.Expense.ToString(CultureInfo.InvariantCulture)">
                                </span>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        <!-- PHÂN BỔ CHI TIÊU -->
        <div class="finance-card">
            <div class="section-heading">
                <div>
                    <h3>Phân bổ chi tiêu</h3>
                    <p>Các khoản chi theo danh mục</p>
                </div>

                <a asp-controller="Category"
                   asp-action="Index"
                   class="finance-btn"
                   style="text-decoration:none;font-size:12px;padding:4px 10px;min-height:32px;">
                    Quản lý chi tiêu
                </a>
            </div>

            <div class="expense-total">
                <span>Tổng chi tiêu</span>
                <h2 id="expenseBreakdown">
                    @Model.TotalExpense.ToString("N0") ₫
                </h2>
            </div>

            @if (expenseCategories.Any())
            {
                <div class="category-list" id="categoryList">
                    @foreach (var cat in expenseCategories)
                    {
                        var pct = cat.Limit > 0
                            ? Math.Min(100, Math.Round(cat.Spent / cat.Limit * 100))
                            : 0;

                        <div class="category-item" style="margin-bottom:14px;">
                            <div class="category-info">
                                <span>@cat.Name</span>
                                <strong>
                                    @cat.Spent.ToString("N0") ₫ /
                                    @cat.Limit.ToString("N0") ₫ (@pct%)
                                </strong>
                            </div>

                            <div class="progress-track"
                                 style="height:7px;border-radius:10px;overflow:hidden;background:var(--finance-soft);">
                                <div style="width:@pct.ToString(CultureInfo.InvariantCulture)%;height:100%;border-radius:10px;background:var(--finance-accent);transition:width 0.4s ease;">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div id="emptyCategory"
                     class="empty-state"
                     style="text-align:center;padding:45px 15px;color:var(--finance-muted);font-size:13px;">
                    Chưa có dữ liệu chi tiêu.
                </div>
            }
        </div>

    </div>

    <!-- NGÂN SÁCH THÁNG -->
    <section class="finance-card" style="margin-top:18px;">
        <div class="section-heading">
            <div>
                <h3>Ngân sách tháng</h3>
                <p>Theo dõi giới hạn chi tiêu tổng thể</p>
            </div>
            <span class="summary-badge">
                @(monthlyBudget?.Month ?? 0)/@(monthlyBudget?.Year ?? 0)
            </span>
        </div>

        @if (monthlyBudget != null)
        {
            <div class="expense-total">
                <span>Đã sử dụng</span>
                <h2>
                    @monthlyBudget.Spent.ToString("N0") ₫ /
                    @monthlyBudget.Limit.ToString("N0") ₫
                </h2>
            </div>

            <div class="progress-track"
                 style="height:10px;border-radius:10px;overflow:hidden;background:var(--finance-soft);">
                <div style="width:@budgetPercent.ToString(CultureInfo.InvariantCulture)%;height:100%;border-radius:10px;background:var(--finance-accent);">
                </div>
            </div>

            <div class="category-info" style="margin-top:12px;">
                <span>Đã sử dụng: @budgetPercent.ToString("N1")%</span>
                <strong>
                    Còn lại: @monthlyBudget.Remaining.ToString("N0") ₫
                </strong>
            </div>

            @if (monthlyBudget.CategoryBudgets.Any())
            {
                <div class="category-list" style="margin-top:20px;">
                    @foreach (var budget in monthlyBudget.CategoryBudgets)
                    {
                        <div class="category-item" style="margin-bottom:14px;">
                            <div class="category-info">
                                <span>@budget.Category</span>
                                <strong>
                                    @budget.Spent.ToString("N0") ₫ /
                                    @budget.Limit.ToString("N0") ₫
                                </strong>
                            </div>

                            <div class="progress-track"
                                 style="height:7px;border-radius:10px;overflow:hidden;background:var(--finance-soft);">
                                <div style="width:@Math.Min(100, budget.UsagePercent).ToString(CultureInfo.InvariantCulture)%;height:100%;border-radius:10px;background:var(--finance-accent);">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <p>Chưa có dữ liệu ngân sách tháng.</p>
        }
    </section>

    <!-- MỤC TIÊU TIẾT KIỆM -->
    <section class="finance-card" style="margin-top:18px;">
        <div class="section-heading">
            <div>
                <h3>Mục tiêu tiết kiệm</h3>
                <p>Theo dõi tiến độ các mục tiêu của bạn</p>
            </div>
        </div>

        @if (Model.SavingGoals != null && Model.SavingGoals.Any())
        {
            <div class="category-list">
                @foreach (var goal in Model.SavingGoals)
                {
                    <div class="category-item" style="margin-bottom:20px;">
                        <div class="category-info">
                            <span>@goal.Title</span>
                            <strong>
                                @goal.CurrentAmount.ToString("N0") ₫ /
                                @goal.TargetAmount.ToString("N0") ₫
                            </strong>
                        </div>

                        <div class="progress-track"
                             style="height:8px;border-radius:10px;overflow:hidden;background:var(--finance-soft);">
                            <div style="width:@goal.ProgressPercent.ToString(CultureInfo.InvariantCulture)%;height:100%;border-radius:10px;background:var(--finance-accent);">
                            </div>
                        </div>

                        <div class="category-info" style="margin-top:7px;">
                            <span>
                                Tiến độ: @goal.ProgressPercent.ToString("N1")%
                            </span>

                            <span>
                                @if (goal.Deadline.HasValue)
                                {
                                    <text>Hạn: @goal.Deadline.Value.ToString("dd/MM/yyyy")</text>
                                }
                                else
                                {
                                    <text>Chưa đặt thời hạn</text>
                                }
                            </span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p>Chưa có mục tiêu tiết kiệm nào.</p>
        }
    </section>

    <!-- LỊCH SỬ GIAO DỊCH -->
    <section class="finance-card" style="margin-top:18px;">
        <div class="section-heading">
            <div>
                <h3>Lịch sử giao dịch</h3>
                <p>Danh sách giao dịch được cung cấp từ ViewModel</p>
            </div>

            <div class="transaction-filters">
                <select class="finance-select"
                        id="transactionFilter"
                        aria-label="Lọc loại giao dịch">
                    <option value="all" selected>Tất cả giao dịch</option>
                    <option value="income">Khoản thu</option>
                    <option value="expense">Khoản chi</option>
                </select>

                <button type="button"
                        class="finance-btn primary"
                        id="openTransaction2">
                    + Thêm giao dịch
                </button>
            </div>
        </div>

        <!-- LỌC THEO KHOẢNG NGÀY -->
        <div class="transaction-filters" style="margin:12px 0 16px;">
            <div>
                <label for="startDateFilter">Từ ngày</label>
                <input type="date"
                       class="finance-select"
                       id="startDateFilter" />
            </div>

            <div>
                <label for="endDateFilter">Đến ngày</label>
                <input type="date"
                       class="finance-select"
                       id="endDateFilter" />
            </div>

            <button type="button" class="finance-btn" id="clearDateFilter">
                Xóa lọc ngày
            </button>
        </div>

        <div style="overflow-x:auto;">
            <table class="finance-table"
                   style="width:100%;border-collapse:collapse;font-size:13px;">
                <thead>
                    <tr style="border-bottom:1px solid var(--finance-border);color:var(--finance-muted);text-align:left;">
                        <th style="padding:12px 10px;">NỘI DUNG</th>
                        <th style="padding:12px 10px;">DANH MỤC</th>
                        <th style="padding:12px 10px;">NGÀY</th>
                        <th style="padding:12px 10px;text-align:right;">SỐ TIỀN</th>
                    </tr>
                </thead>

                <tbody id="transactionBody">
                    @if (Model.Transactions != null && Model.Transactions.Any())
                    {
                        @foreach (var t in Model.Transactions)
                        {
                            var normalizedType = (t.Type ?? "").ToLowerInvariant();

                            <tr data-type="@normalizedType"
                                data-date="@t.Date.ToString("yyyy-MM-dd")"
                                data-month="@t.Date.ToString("yyyy-MM")"
                                style="border-bottom:1px solid var(--finance-border);transition:background 0.15s ease;">

                                <td style="padding:12px 10px;font-weight:600;">
                                    @t.Name
                                </td>

                                <td style="padding:12px 10px;">
                                    <span class="summary-badge" style="font-size:10px;">
                                        @t.Category
                                    </span>
                                </td>

                                <td style="padding:12px 10px;color:var(--finance-muted);">
                                    @t.Date.ToString("dd/MM/yyyy")
                                </td>

                                <td style="padding:12px 10px;text-align:right;font-weight:700;color:@(normalizedType == "income" ? "var(--finance-income)" : "var(--finance-expense)");">
                                    @(normalizedType == "income" ? "+" : "-")@t.Amount.ToString("N0") ₫
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div id="emptyTransactions"
             style="display:@(Model.Transactions != null && Model.Transactions.Any() ? "none" : "block");text-align:center;padding:35px 20px;color:var(--finance-muted);font-size:13px;">
            Chưa có giao dịch nào được ghi nhận.
        </div>
    </section>

    <!-- MODAL NHẬP GIAO DỊCH MẪU -->
    <div class="finance-modal"
         id="transactionModal"
         aria-hidden="true"
         style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:99;align-items:center;justify-content:center;padding:20px;">

        <div class="finance-modal-content"
             style="background:var(--finance-bg);color:var(--finance-text);border:1px solid var(--finance-border);border-radius:18px;max-width:480px;width:100%;padding:24px;box-shadow:var(--finance-shadow);">

            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;">
                <h3 style="margin:0;font-size:17px;font-weight:750;">
                    Nhập giao dịch mẫu
                </h3>

                <button type="button"
                        id="closeModal"
                        style="background:none;border:none;font-size:20px;cursor:pointer;color:var(--finance-muted);">
                    &times;
                </button>
            </div>

            <p style="font-size:12px;color:var(--finance-muted);margin-bottom:16px;">
                Đây là giao diện thử nghiệm. Thông tin nhập vào chưa được lưu vào cơ sở dữ liệu.
            </p>

            <form id="transactionForm">
                <div style="margin-bottom:14px;">
                    <label for="transactionName"
                           style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--finance-text);">
                        Nội dung giao dịch
                    </label>

                    <input type="text"
                           id="transactionName"
                           class="finance-select"
                           style="width:100%;"
                           placeholder="VD: Mua sách, Tiền lương..."
                           required />
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px;">
                    <div>
                        <label for="transactionType"
                               style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--finance-text);">
                            Loại giao dịch
                        </label>

                        <select id="transactionType"
                                class="finance-select"
                                style="width:100%;">
                            <option value="expense" selected>Chi tiêu</option>
                            <option value="income">Thu nhập</option>
                        </select>
                    </div>

                    <div>
                        <label for="transactionCategory"
                               style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--finance-text);">
                            Danh mục
                        </label>

                        <select id="transactionCategory"
                                class="finance-select"
                                style="width:100%;"
                                required>
                            <option value="" disabled selected>Chọn danh mục</option>

                            @if (Model.Categories != null)
                            {
                                foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id"
                                            data-type="@c.Type.ToLowerInvariant()">
                                        @c.Name
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:20px;">
                    <div>
                        <label for="transactionAmount"
                               style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--finance-text);">
                            Số tiền (VNĐ)
                        </label>

                        <input type="number"
                               id="transactionAmount"
                               min="1000"
                               step="1000"
                               class="finance-select"
                               style="width:100%;"
                               placeholder="VD: 50000"
                               required />
                    </div>

                    <div>
                        <label for="transactionDate"
                               style="display:block;font-size:12px;font-weight:700;margin-bottom:6px;color:var(--finance-text);">
                            Ngày
                        </label>

                        <input type="date"
                               id="transactionDate"
                               class="finance-select"
                               style="width:100%;"
                               required />
                    </div>
                </div>

                <div style="display:flex;justify-content:flex-end;gap:10px;">
                    <button type="button"
                            class="finance-btn"
                            id="cancelTransaction">
                        Đóng
                    </button>

                    <button type="submit"
                            class="finance-btn primary">
                        Xem trước
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>
