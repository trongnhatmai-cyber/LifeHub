@{
    Layout = "_Layout";
    ViewData["Title"] = "Chuyển tiền";
    ViewData["ActivePage"] = "Wallet";
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/finance-modules.css" asp-append-version="true" />
}

<div class="finance-page">
    <header class="finance-heading">
        <div>
            <span class="finance-label">WALLET TRANSFER</span>
            <h1>Chuyển tiền giữa các ví</h1>
            <p>Chọn ví nguồn, ví đích và số tiền cần chuyển.</p>
        </div>
        <a class="finance-btn" asp-controller="Wallet" asp-action="Index">← Quay lại</a>
    </header>

    <section class="finance-card">
        <form asp-controller="Wallet" asp-action="Transfer" method="post">
            @Html.AntiForgeryToken()

            <div class="modal-grid">
                <div>
                    <label for="FromWalletId">Ví nguồn</label>
                    <select class="finance-select" id="FromWalletId"
                            name="FromWalletId" required>
                        @if (ViewBag.Wallets != null)
                        {
                            foreach (var w in ViewBag.Wallets)
                            {
                                <option value="@w.Id">
                                    @w.Name — @w.Balance
                                </option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label for="ToWalletId">Ví đích</label>
                    <select class="finance-select" id="ToWalletId"
                            name="ToWalletId" required>
                        @if (ViewBag.Wallets != null)
                        {
                            foreach (var w in ViewBag.Wallets)
                            {
                                <option value="@w.Id">@w.Name</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label for="Amount">Số tiền</label>
                    <input class="finance-select" id="Amount" name="Amount"
                           type="number" min="1" step="1000" required />
                </div>

                <div>
                    <label for="Note">Ghi chú</label>
                    <input class="finance-select" id="Note" name="Note"
                           placeholder="Không bắt buộc" />
                </div>
            </div>

            <div class="card-actions">
                <button class="finance-btn primary" type="submit">Xác nhận chuyển</button>
                <a class="finance-btn" asp-controller="Wallet" asp-action="Index">Hủy</a>
            </div>
        </form>
    </section>
</div>