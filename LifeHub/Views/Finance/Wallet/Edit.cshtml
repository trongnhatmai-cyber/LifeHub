@{
    Layout = "_Layout";
    ViewData["Title"] = "Chỉnh sửa ví";
    ViewData["ActivePage"] = "Wallet";
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/finance-modules.css" asp-append-version="true" />
}

<div class="finance-page">
    <header class="finance-heading">
        <div>
            <span class="finance-label">WALLET</span>
            <h1>Chỉnh sửa ví</h1>
            <p>Cập nhật thông tin ví / tài khoản.</p>
        </div>
        <a class="finance-btn" asp-controller="Wallet" asp-action="Index">← Quay lại</a>
    </header>

    <section class="finance-card">
        <form asp-controller="Wallet" asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@ViewBag.Id" />

            <div class="modal-grid">
                <div>
                    <label for="Name">Tên ví</label>
                    <input class="finance-select" id="Name" name="Name"
                           value="@ViewBag.Name" required maxlength="80" />
                </div>

                <div>
                    <label for="Kind">Loại ví</label>
                    <select class="finance-select" id="Kind" name="Kind" required>
                        <option value="cash" selected="@(ViewBag.Kind?.ToString() == "cash")">Tiền mặt</option>
                        <option value="bank" selected="@(ViewBag.Kind?.ToString() == "bank")">Ngân hàng</option>
                        <option value="ewallet" selected="@(ViewBag.Kind?.ToString() == "ewallet")">Ví điện tử</option>
                        <option value="savings" selected="@(ViewBag.Kind?.ToString() == "savings")">Quỹ tiết kiệm</option>
                    </select>
                </div>

                <div>
                    <label for="Color">Màu nhận diện</label>
                    <input class="finance-select" id="Color" name="Color"
                           type="color" value="@(ViewBag.Color ?? "#e11d48")" />
                </div>
            </div>

            <div class="card-actions">
                <button class="finance-btn primary" type="submit">Lưu thay đổi</button>
                <a class="finance-btn" asp-controller="Wallet" asp-action="Index">Hủy</a>
            </div>
        </form>
    </section>
</div>