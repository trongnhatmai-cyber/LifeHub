@model LifeHub.Models.ViewModels.FinanceModules.WalletPageViewModel
@using LifeHub.Models.ViewModels.FinanceModules
@{
    Layout = "_Layout"; ViewData["Title"] = "Ví và tài khoản"; ViewData["ActivePage"] = "Wallet";
}
@section Styles { <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/finance-modules.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/finance-modules.js" asp-append-version="true" defer></script> }
<div class="finance-page" data-module="wallets">
    <header class="finance-heading">
        <div>
            <span class="finance-label">PERSONAL FINANCE MANAGEMENT</span>
            <h1>Ví và tài khoản</h1>
            <p>Quản lý các nguồn tiền, theo dõi số dư và dòng tiền qua từng tài khoản.</p>
        </div>
        <div class="heading-actions">
            <a class="finance-btn" asp-controller="Finance" asp-action="Index">← Tổng quan</a>
            <a class="finance-btn primary"
                asp-controller="Wallet"
                asp-action="Create">
                ＋ Thêm ví
            </a>
        </div>
    </header>
    <section class="finance-summary">
        <article class="summary-card balance-card">
            <div class="summary-top">
                <span>Tổng tài sản</span>
                <span class="summary-badge">TOTAL</span>
            </div>
            <h2>@FinanceFormat.Money(Model.TotalBalance)</h2>
            <p>Tổng số dư tất cả ví</p>
        </article>

        <article class="summary-card income-card">
            <div class="summary-top">
                <span>Có thể sử dụng</span>
                <span class="summary-badge">AVAILABLE</span>
            </div>
            <h2>@FinanceFormat.Money(Model.SpendableBalance)</h2>
            <p>Không bao gồm quỹ tiết kiệm</p>
        </article>

        <article class="summary-card saving-card">
            <div class="summary-top">
                <span>Quỹ tiết kiệm</span> 
                <span class="summary-badge">SAVINGS</span>
            </div>
            <h2>@FinanceFormat.Money(Model.SavingsBalance)</h2>
            <p>Đang dành cho các mục tiêu</p>
        </article>

        <article class="summary-card expense-card">
            <div class="summary-top">
                <span>Số lượng ví</span>
                <span class="summary-badge">WALLETS</span>
            </div>
            <h2>@Model.WalletCount</h2>
            <p>Tài khoản đang theo dõi</p>
        </article>
    </section>

    <div class="section-heading">
        <div>
            <h3>Tài khoản của bạn</h3>
            <p>Số dư và biến động trong tháng hiện tại.</p>
        </div>
        <a class="finance-btn"
            asp-controller="Wallet"
            asp-action="Transfer">
            ⇄ Chuyển tiền
        </a>
    </div>
    <section class="wallet-grid">
    @foreach (var wallet in Model.Wallets) {
        <article class="wallet-card" style="--wallet-color:@wallet.Color">
            <div class="wallet-top"><span class="wallet-kind">
                <span class="dot" style="background:@wallet.Color"></span>@wallet.KindLabel</span>
                <span class="summary-badge">#@wallet.Id</span>
            </div>
            
            <h3>@wallet.Name</h3>
            <div class="wallet-balance">@FinanceFormat.Money(wallet.Balance)</div>
            <div class="wallet-flow">
                <div>
                    <span>Thu trong tháng</span>
                    <strong class="text-income">+@FinanceFormat.Money(wallet.MonthIncome)</strong>
                </div>
                <div>
                    <span>Chi trong tháng</span>
                    <strong class="text-expense">-@FinanceFormat.Money(wallet.MonthExpense)</strong>
                </div>
                </div>
            <div class="wallet-recent-title">Giao dịch gần đây</div>
                <ul class="mini-list">
                    @if (wallet.Recent.Any()) { 
                        foreach (var tx in wallet.Recent) { 
                            <li>
                                <span>@tx.Name</span>
                                <b class="@(tx.IsIncome ? "text-income" : "text-expense")">@tx.AmountLabel</b>
                            </li> 
                        } 
                    } 
                    else { 
                        <li>
                            <span>Chưa có giao dịch</span>
                            <b>—</b>
                        </li> 
                    }
                </ul>
            <div class="card-actions">
                <a class="row-btn"
                    asp-controller="Wallet"
                    asp-action="Edit"
                    asp-route-id="@wallet.Id">
                    Chỉnh sửa
                </a>

                <a class="row-btn"
                    asp-controller="Wallet"
                    asp-action="Delete"
                    asp-route-id="@wallet.Id">
                    Xóa ví
                </a>
            </div>
        </article>
    }
    </section>
    <section class="finance-card wallet-guidance"><div class="section-heading"><div><h3>Nguyên tắc quản lý ví</h3><p>Giữ số dư và giao dịch được tổ chức rõ ràng.</p></div></div><div class="guidance-grid"><div><strong>Tiền mặt</strong><p>Theo dõi tiền mặt đang có và các khoản chi trực tiếp.</p></div><div><strong>Tài khoản ngân hàng</strong><p>Ghi nhận tiền lương, thanh toán và chuyển khoản.</p></div><div><strong>Ví điện tử</strong><p>Quản lý các khoản thanh toán qua ứng dụng.</p></div><div><strong>Quỹ tiết kiệm</strong><p>Tổng hợp số tiền đã dành cho các mục tiêu tiết kiệm.</p></div></div></section>
    <div class="finance-page-note">Thêm, sửa, xóa và chuyển tiền hiện chỉ là mô phỏng giao diện; số dư không thay đổi.</div>
</div>
