@model IEnumerable<LifeHub.Models.ViewModels.FinanceManagement.CategoryViewModel>
@using System.Globalization
@{
    Layout = "_Layout"; ViewData["Title"] = "Danh mục và ngân sách"; ViewData["ActivePage"] = "Category";
    var categories = Model?.ToList() ?? new List<LifeHub.Models.ViewModels.FinanceManagement.CategoryViewModel>();
    var expenseCategories = categories.Where(x => string.Equals(x.Type, "expense", StringComparison.OrdinalIgnoreCase)).ToList();
    var incomeCategories = categories.Where(x => string.Equals(x.Type, "income", StringComparison.OrdinalIgnoreCase)).ToList();
    var totalLimit = expenseCategories.Sum(x => x.MonthlyLimit ?? x.Limit);
    var totalSpent = expenseCategories.Sum(x => x.SpentThisMonth > 0 ? x.SpentThisMonth : x.Spent);
    var configuredCount = expenseCategories.Count(x => (x.MonthlyLimit ?? x.Limit) > 0);
    var vi = CultureInfo.GetCultureInfo("vi-VN");
}
@section Styles { <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/finance-modules.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/finance-modules.js" asp-append-version="true" defer></script> }
<div class="finance-page" data-module="categories">
    <header class="finance-heading"><div><span class="finance-label">PERSONAL FINANCE MANAGEMENT</span><h1>Danh mục và ngân sách</h1><p>Phân loại dòng tiền và thiết lập hạn mức chi tiêu theo từng nhóm.</p></div>
    <div class="heading-actions">
        <a class="finance-btn" asp-controller="Finance" asp-action="Index">← Tổng quan</a>
        <a class="finance-btn primary" asp-controller="Category"
            asp-action="Create" 
            class="primary-button">
            + Thêm danh mục
        </a>
    </div>
</header>
    <section class="finance-summary">
        <article class="summary-card balance-card"><div class="summary-top"><span>Danh mục chi tiêu</span><span class="summary-badge">EXPENSE</span></div><h2>@expenseCategories.Count</h2><p>Nhóm phân loại khoản chi</p></article>
        <article class="summary-card income-card"><div class="summary-top"><span>Danh mục thu nhập</span><span class="summary-badge">INCOME</span></div><h2>@incomeCategories.Count</h2><p>Nhóm phân loại khoản thu</p></article>
        <article class="summary-card saving-card"><div class="summary-top"><span>Ngân sách đã thiết lập</span><span class="summary-badge">BUDGET</span></div><h2>@configuredCount</h2><p>Danh mục có hạn mức</p></article>
        <article class="summary-card expense-card"><div class="summary-top"><span>Tổng hạn mức</span><span class="summary-badge">MONTHLY LIMIT</span></div><h2>@totalLimit.ToString("N0", vi) ₫</h2><p>Trên các danh mục chi tiêu</p></article>
    </section>
    <section class="finance-card budget-overview"><div class="section-heading"><div><h3>Tình hình ngân sách tháng</h3><p>Tổng hợp theo hạn mức và số tiền đã chi được cung cấp từ ViewModel.</p></div><span class="budget-caption">@(DateTime.Today.ToString("MMMM yyyy", vi))</span></div>
        @{ var overallPercent = totalLimit > 0 ? Math.Min(100, (double)(totalSpent / totalLimit * 100m)) : 0; }
        <div class="budget-total-row"><div><span>Đã sử dụng</span><strong>@totalSpent.ToString("N0", vi) ₫</strong></div><div><span>Còn lại</span><strong>@Math.Max(0, totalLimit-totalSpent).ToString("N0", vi) ₫</strong></div><div><span>Tiến độ</span><strong>@overallPercent.ToString("0")%</strong></div></div>
        <div class="progress-track overall-track"><div style="width:@overallPercent.ToString(CultureInfo.InvariantCulture)%"></div></div>
        @if (configuredCount == 0) { <p class="budget-empty-note">Bạn chưa thiết lập hạn mức ngân sách cho các danh mục. Có thể mở từng danh mục để thiết lập trong phiên bản hoàn chỉnh.</p> }
    </section>
    <section class="finance-card category-management-card">
        <div class="section-heading"><div><h3>Danh sách danh mục</h3><p>Quản lý các nhóm thu nhập và chi tiêu.</p></div><div class="finance-chips" role="tablist"><button class="finance-chip active" type="button" data-category-filter="all">Tất cả</button><button class="finance-chip" type="button" data-category-filter="expense">Chi tiêu</button><button class="finance-chip" type="button" data-category-filter="income">Thu nhập</button></div></div>
        <div class="category-management-grid">
        @foreach (var cat in categories) {
            var kind = string.Equals(cat.Type, "income", StringComparison.OrdinalIgnoreCase) ? "income" : "expense";
            var limit = cat.MonthlyLimit ?? cat.Limit;
            var spent = cat.SpentThisMonth > 0 ? cat.SpentThisMonth : cat.Spent;
            var percent = limit > 0 ? Math.Min(100, (double)(spent / limit * 100m)) : 0;
            <article class="category-management-item" data-category-kind="@kind" style="--category-color:@(string.IsNullOrWhiteSpace(cat.Color) ? "#e98ba5" : cat.Color)">
                <div class="category-management-top"><span class="category-symbol">@(string.IsNullOrWhiteSpace(cat.Icon) ? (kind == "income" ? "↗" : "↘") : cat.Icon)</span><span class="category-type-pill @kind">@(kind == "income" ? "Thu nhập" : "Chi tiêu")</span></div>
                <h3>@cat.Name</h3><div class="category-budget-values"><span>Đã sử dụng</span><strong>@spent.ToString("N0", vi) ₫</strong></div><div class="category-budget-values"><span>Hạn mức tháng</span><strong>@(limit > 0 ? limit.ToString("N0", vi) + " ₫" : "Chưa thiết lập")</strong></div>
                <div class="progress-track"><div style="width:@percent.ToString(CultureInfo.InvariantCulture)%"></div></div><small class="category-percent">@(limit > 0 ? percent.ToString("0", CultureInfo.InvariantCulture) + "% ngân sách" : "Chưa có ngân sách")</small>
                <div class="card-actions">
                    <div class="category-actions">
                        <a asp-controller="Category"
                        asp-action="Edit"
                        asp-route-id="@cat.Id"
                        class="secondary-button">
                            Chỉnh sửa
                        </a>
                    <a asp-controller="Category"
                        asp-action="Delete"
                        asp-route-id="@cat.Id"
                        class="delete-button">
                            Xóa
                        </a>
            </article>

        }
        @if (!categories.Any()) { <div class="finance-empty"><span>▦</span><strong>Chưa có danh mục</strong><p>Danh mục sẽ xuất hiện tại đây khi có dữ liệu.</p></div> }
        </div>
    </section> 
</div>
