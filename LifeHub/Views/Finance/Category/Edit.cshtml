@model LifeHub.Models.ViewModels.FinanceManagement.CategoryViewModel

@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

@section Styles {
    <link rel="stylesheet" href="~/css/finance.css" asp-append-version="true" />
}

<div class="module-page finance-page">

    <div class="page-header">
        <div>
            <p class="page-eyebrow">QUẢN LÝ TÀI CHÍNH</p>
            <h1>Chỉnh sửa danh mục</h1>
            <p class="page-description">
                Cập nhật thông tin danh mục tài chính.
            </p>
        </div>

        <a asp-controller="Category"
           asp-action="Index"
           class="secondary-button">
            Quay lại
        </a>
    </div>

    <div class="module-card form-card">

        <form asp-controller="Category"
              asp-action="Edit"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Id" type="hidden" />
            <input asp-for="Icon" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary">
            </div>

            <div class="form-group">
                <label asp-for="Name">Tên danh mục</label>

                <input asp-for="Name" class="module-input" />

                <span asp-validation-for="Name"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Type">Loại danh mục</label>

                <select asp-for="Type" class="module-input">
                    <option value="Expense">Chi tiêu</option>
                    <option value="Income">Thu nhập</option>
                </select>

                <span asp-validation-for="Type"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="Color">Màu danh mục</label>

                <input asp-for="Color"
                       type="color"
                       class="color-input" />
            </div>

            <div class="form-group">
                <label asp-for="ParentId">Danh mục cha</label>

                <input asp-for="ParentId"
                       type="number"
                       min="1"
                       class="module-input" />
            </div>

            <div class="form-actions">
                <a asp-controller="Category"
                   asp-action="Index"
                   class="secondary-button">
                    Hủy
                </a>

                <button type="submit" class="primary-button">
                    Lưu thay đổi
                </button>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/finance.js" asp-append-version="true"></script>
}