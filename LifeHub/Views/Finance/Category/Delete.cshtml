
@model LifeHub.Models.ViewModels.FinanceManagement.CategoryViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Xóa danh mục";
    ViewData["ActivePage"] = "Category";
}

@section Styles {
    <link rel="stylesheet" href="~/css/category-management.css" asp-append-version="true" />
}

<div class="module-page finance-page">

    <div class="page-header">
        <div>
            <p class="page-eyebrow">QUẢN LÝ TÀI CHÍNH</p>
            <h1>Xóa danh mục</h1>
            <p class="page-description">
                Kiểm tra thông tin trước khi xác nhận xóa danh mục.
            </p>
        </div>

        <a asp-controller="Category"
           asp-action="Index"
           class="secondary-button">
            Quay lại
        </a>
    </div>

    <div class="module-card form-card delete-confirm-card">

        <div class="delete-warning">
            <span class="delete-warning-icon" aria-hidden="true">!</span>
            <div>
                <h2>Bạn có chắc chắn muốn xóa?</h2>
                <p>
                    Hãy kiểm tra danh mục bên dưới trước khi tiếp tục.
                    Thao tác xóa có thể ảnh hưởng đến dữ liệu liên quan.
                </p>
            </div>
        </div>

        <div class="delete-category-preview">
            <div class="category-color"
                 style="background-color: @(string.IsNullOrWhiteSpace(Model.Color) ? "#e98ba5" : Model.Color)">
            </div>

            <div class="category-information">
                <strong>@Model.Name</strong>
                <span>
                    @(Model.Type == "Income" ? "Thu nhập" : "Chi tiêu")
                </span>

                @if (Model.Type == "Expense" && Model.MonthlyLimit.HasValue)
                {
                    <span>
                        Hạn mức:
                        @Model.MonthlyLimit.Value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫ / tháng
                    </span>
                }
            </div>
        </div>

        <form asp-controller="Category"
              asp-action="Delete"
              asp-route-id="@Model.Id"
              method="post">

            <input type="hidden" asp-for="Id" />

            <div class="form-actions">
                <a asp-controller="Category"
                   asp-action="Index"
                   class="secondary-button">
                    Hủy
                </a>

                <button type="submit" class="delete-button">
                    Xác nhận xóa
                </button>
            </div>
        </form>

    </div>
</div>
