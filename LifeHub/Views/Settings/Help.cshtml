@{
    Layout = "_SettingsLayout";
    ViewData["SettingsActive"] = "";
}

<header class="settings-head">
    <div>
        <h1>Trợ giúp &amp; Hỗ trợ</h1>
        <p>Mẹo sử dụng nhanh và câu hỏi thường gặp.</p>
    </div>
</header>

<section class="settings-card">
    <div class="section-heading"><div><h3>Phím tắt</h3></div></div>
    <dl class="settings-facts">
        <div><dt>Mở tìm kiếm toàn hệ thống</dt><dd><kbd class="settings-kbd">Ctrl</kbd> + <kbd class="settings-kbd">K</kbd></dd></div>
        <div><dt>Đóng hộp thoại / menu đang mở</dt><dd><kbd class="settings-kbd">Esc</kbd></dd></div>
    </dl>
</section>

<section class="settings-card">
    <div class="section-heading"><div><h3>Câu hỏi thường gặp</h3></div></div>

    <details class="settings-faq">
        <summary>Làm sao đổi giao diện sáng / tối?</summary>
        <p>Bấm biểu tượng mặt trăng trên thanh trên cùng, hoặc vào Cài đặt &gt; Giao diện để chọn và lưu lựa chọn.</p>
    </details>
    <details class="settings-faq">
        <summary>Làm sao đánh dấu thông báo đã đọc?</summary>
        <p>Mở biểu tượng chuông rồi chọn “Đánh dấu đã đọc”, hoặc vào trang Thông báo để đánh dấu từng mục hoặc tất cả.</p>
    </details>
    <details class="settings-faq">
        <summary>Tôi quên mật khẩu thì làm thế nào?</summary>
        <p>Tại trang đăng nhập, chọn quên mật khẩu để nhận hướng dẫn đặt lại. Khi đã đăng nhập, bạn có thể đổi mật khẩu trong Cài đặt &gt; Bảo mật.</p>
    </details>
    <details class="settings-faq">
        <summary>Làm sao thu hồi quyền truy cập nội dung đã chia sẻ?</summary>
        <p>Vào Cài đặt &gt; Chia sẻ &amp; Phân quyền, tìm mục cần thu hồi và bấm “Thu hồi”.</p>
    </details>
</section>
