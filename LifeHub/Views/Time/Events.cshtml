@model LifeHub.Models.ViewModels.TimeManagement.TimeEventsViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Sự kiện";
    ViewData["ActivePage"] = "TimeEvents";
    var types = new[] { "Họp", "Học tập", "Công việc", "Dự án", "Sinh hoạt", "Cá nhân", "Khác" };
    var statusChips = new[] { ("all", "Tất cả"), ("upcoming", "Sắp diễn ra"), ("ongoing", "Đang diễn ra"), ("done", "Đã hoàn thành"), ("cancelled", "Đã hủy") };
}

@section Styles {
    <link rel="stylesheet" href="~/css/time.css" asp-append-version="true" />
}

<div class="time-page">
    <header class="time-heading">
        <div>
            <span class="time-label">QUẢN LÝ THỜI GIAN</span>
            <h1>Sự kiện</h1>
            <p>Quản lý danh sách sự kiện và nhắc nhở của bạn.</p>
        </div>
        <div class="heading-actions">
            <button type="button" class="time-btn primary" data-open="eventFormModal" data-mode="create" data-title="Tạo sự kiện">+ Thêm sự kiện</button>
        </div>
    </header>

    <section class="time-summary">
        <div class="summary-card"><div class="summary-top"><span>Tổng sự kiện</span><span class="summary-badge">TOTAL</span></div><h2>@Model.Total</h2><p>Tất cả sự kiện</p></div>
        <div class="summary-card"><div class="summary-top"><span>Sắp diễn ra</span><span class="summary-badge">UPCOMING</span></div><h2>@Model.Upcoming</h2><p>Chưa bắt đầu</p></div>
        <div class="summary-card"><div class="summary-top"><span>Đã diễn ra</span><span class="summary-badge">DONE</span></div><h2>@Model.Done</h2><p>Đã kết thúc</p></div>
        <div class="summary-card"><div class="summary-top"><span>Đã hủy</span><span class="summary-badge">CANCELLED</span></div><h2>@Model.Cancelled</h2><p>Hệ thống chưa lưu trạng thái hủy</p></div>
    </section>

    <section class="time-card">
        <div class="section-heading">
            <div><h3>Danh sách sự kiện</h3><p>Hiển thị @Model.Items.Count / @Model.Total sự kiện</p></div>
        </div>

        <!-- Chip trạng thái: lọc phía server -->
        <div class="time-chips">
            @foreach (var (key, label) in statusChips)
            {
                <a class="time-chip @(Model.Status == key ? "active" : "")" asp-controller="Time" asp-action="Events" asp-route-status="@key"
                   asp-route-range="@Model.Range" asp-route-type="@Model.Type" asp-route-source="@Model.Source" asp-route-q="@Model.Q">@label</a>
            }
        </div>

        <form method="get" asp-controller="Time" asp-action="Events" class="time-toolbar">
            <input type="hidden" name="status" value="@Model.Status" />
            <input type="search" name="q" value="@Model.Q" placeholder="Tìm theo tên hoặc địa điểm" aria-label="Từ khóa" />
            <select name="range" data-autosubmit aria-label="Khoảng thời gian">
                <option value="all" selected="@(Model.Range == "all")">Mọi thời gian</option>
                <option value="today" selected="@(Model.Range == "today")">Hôm nay</option>
                <option value="week" selected="@(Model.Range == "week")">Tuần này</option>
                <option value="month" selected="@(Model.Range == "month")">Tháng này</option>
            </select>
            <select name="type" data-autosubmit aria-label="Loại sự kiện">
                <option value="all">Mọi loại</option>
                @foreach (var t in types) { <option value="@t" selected="@(Model.Type == t)">@t</option> }
            </select>
            <select name="source" data-autosubmit aria-label="Nguồn sự kiện">
                <option value="all" selected="@(Model.Source == "all")">Mọi nguồn</option>
                <option value="personal" selected="@(Model.Source == "personal")">Cá nhân (tạo tại đây)</option>
                <option value="study" selected="@(Model.Source == "study")">Học tập</option>
                <option value="task" selected="@(Model.Source == "task")">Công việc</option>
                <option value="project" selected="@(Model.Source == "project")">Dự án</option>
                <option value="life" selected="@(Model.Source == "life")">Sinh hoạt</option>
            </select>
        </form>

        <div class="table-wrap">
            <table class="time-table stack">
                <thead><tr><th>SỰ KIỆN</th><th>THỜI GIAN</th><th>LOẠI</th><th>NGUỒN</th><th>TRẠNG THÁI</th><th class="right">THAO TÁC</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Items)
                    {
                        <tr style="--ev-color:@e.Color">
                            <td data-label="Sự kiện"><strong>@e.Title</strong>@if (e.Location != "") { <small class="row-sub">@e.Location</small> }</td>
                            <td data-label="Thời gian" class="muted">@e.Start.ToString("dd/MM") – @(e.IsAllDay ? "Cả ngày" : e.Start.ToString("HH:mm"))</td>
                            <td data-label="Loại">@e.TypeLabel</td>
                            <td data-label="Nguồn"><span class="source-tag">@e.SourceLabel</span></td>
                            <td data-label="Trạng thái"><span class="status @e.StatusClass">@e.StatusIcon @e.StatusLabel</span></td>
                            <td data-label="Thao tác" class="right">
                                <div class="row-actions">
                                    <button type="button" class="row-btn" @Html.Raw(e.Attrs("eventDetailModal", "detail"))>Xem</button>
                                    @if (e.Editable)
                                    {
                                        <button type="button" class="row-btn" @Html.Raw(e.Attrs("eventFormModal", "edit", "Chỉnh sửa sự kiện"))>Sửa</button>
                                        <button type="button" class="row-btn" data-simulate-action>Hoàn thành</button>
                                    }
                                    <button type="button" class="row-btn" @Html.Raw(e.Attrs("eventFormModal", "duplicate", "Nhân bản sự kiện"))>Nhân bản</button>
                                    @if (e.Editable)
                                    {
                                        <button type="button" class="row-btn" @Html.Raw(e.Attrs("eventDeleteModal", "delete"))>Xóa</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="6" class="time-empty">@(Model.Total == 0 ? "Chưa có sự kiện nào. Bấm \"+ Thêm sự kiện\" để bắt đầu." : "Không có sự kiện nào phù hợp bộ lọc.")</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="time-note">Deadline của Công việc và lịch học của Học tập hiển thị tại đây để tiện theo dõi, nhưng được chỉnh sửa ở phân hệ gốc.</p>
    </section>

    <partial name="_EventFormModal" />
    <partial name="_EventDetailModal" />
    <partial name="_EventDeleteModal" />
</div>

@section Scripts {
    <script src="~/js/time.js" asp-append-version="true"></script>
}
