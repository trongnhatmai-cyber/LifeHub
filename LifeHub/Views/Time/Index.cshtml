@model LifeHub.Models.ViewModels.TimeManagement.TimeOverviewViewModel
@using System.Globalization

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý thời gian";
    ViewData["ActivePage"] = "TimeOverview";
    string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    var totalMin = Model.Allocation.Sum(x => x.Minutes);
}

@section Styles {
    <link rel="stylesheet" href="~/css/time.css" asp-append-version="true" />
}

<div class="time-page">
    <header class="time-heading">
        <div>
            <span class="time-label">QUẢN LÝ THỜI GIAN</span>
            <h1>Quản lý thời gian</h1>
            <p>Sắp xếp thời gian, làm chủ lịch trình của bạn.</p>
        </div>

        <div class="heading-actions">
            <form method="get" asp-controller="Time" asp-action="Index" class="date-nav">
                <input type="date" name="date" value="@Model.DateIso" data-autosubmit aria-label="Chọn ngày" />
            </form>
            <a class="time-btn" asp-controller="Time" asp-action="Calendar" asp-route-date="@Model.DateIso">Xem lịch</a>
            <button type="button" class="time-btn primary" data-open="eventFormModal" data-mode="create" data-title="Tạo sự kiện" data-startdate="@Model.DateIso">+ Tạo sự kiện</button>
        </div>
    </header>

    <section class="time-summary">
        <div class="summary-card">
            <div class="summary-top"><span>Sự kiện hôm nay</span><span class="summary-badge">EVENTS</span></div>
            <h2>@Model.TotalCount</h2>
            <p>Tổng số lịch trình</p>
        </div>
        <div class="summary-card">
            <div class="summary-top"><span>Thời gian đã lên lịch</span><span class="summary-badge">PLANNED</span></div>
            <h2>@Model.PlannedText</h2>
            <p>Trong ngày</p>
        </div>
        <div class="summary-card">
            <div class="summary-top"><span>Đã hoàn thành</span><span class="summary-badge">DONE</span></div>
            <h2>@Model.DoneCount/@Model.TotalCount</h2>
            <p>Sự kiện hôm nay</p>
        </div>
        <div class="summary-card">
            <div class="summary-top"><span>Thời gian tập trung</span><span class="summary-badge">FOCUS</span></div>
            <h2>@Model.FocusText</h2>
            <p>Pomodoro, @Model.FocusSessions phiên</p>
        </div>
    </section>

    <!-- LỊCH TRÌNH HÔM NAY -->
    <section class="time-card" style="margin-bottom:20px">
        <div class="section-heading">
            <div><h3>Lịch trình @(Model.DateIso == Model.TodayIso ? "hôm nay" : "trong ngày")</h3><p>@Model.DateLabel, @Model.TotalCount sự kiện</p></div>
            <a class="time-btn small" asp-controller="Time" asp-action="Calendar" asp-route-date="@Model.DateIso">Xem lịch đầy đủ &rarr;</a>
        </div>

        <div class="agenda">
            @foreach (var e in Model.TodayEvents)
            {
                <button type="button" class="agenda-item" style="--ev-color:@e.Color" @Html.Raw(e.Attrs("eventDetailModal", "detail"))>
                    <span class="agenda-time">@e.TimeRange</span>
                    <span class="agenda-main"><strong>@e.Title</strong><small>@e.TypeLabel@(e.Location != "" ? ", " + e.Location : "")</small></span>
                    <span class="source-tag">@e.SourceLabel</span>
                    <span class="status @e.StatusClass">@e.StatusIcon @e.StatusLabel</span>
                </button>
            }
        </div>
        @if (!Model.TodayEvents.Any())
        {
            <div class="time-empty">Chưa có sự kiện nào trong ngày này. Bấm "+ Tạo sự kiện" để bắt đầu.</div>
        }
    </section>

    <div class="time-grid">
        <!-- PHÂN BỔ THỜI GIAN -->
        <section class="time-card">
            <div class="section-heading">
                <div><h3>Phân bổ thời gian</h3><p>Theo nhóm, tuần @Model.WeekLabel</p></div>
            </div>
            @if (totalMin > 0)
            {
                <div class="donut-wrap">
                    <div class="donut">
                        <svg viewBox="0 0 36 36" role="img" aria-label="Biểu đồ phân bổ thời gian theo nhóm">
                            <circle class="donut-bg" cx="18" cy="18" r="15.9155" />
                            @foreach (var sl in Model.Allocation)
                            {
                                var p = sl.Minutes * 100.0 / totalMin;
                                <circle class="donut-seg" cx="18" cy="18" r="15.9155" stroke="@sl.Color" stroke-dasharray="@F(p) @F(100 - p)" stroke-dashoffset="@F(-sl.Offset)" />
                            }
                        </svg>
                        <div class="donut-center"><strong>@Model.AllocationTotalText</strong><span>Đã lên lịch</span></div>
                    </div>
                    <ul class="legend-list">
                        @foreach (var sl in Model.Allocation)
                        {
                            <li><div><i style="background:@sl.Color"></i>@sl.Label</div><span>@sl.MinutesText, @sl.Percent%</span></li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="time-empty">Chưa có sự kiện nào trong tuần này để phân bổ.</div>
            }
        </section>

        <!-- KẾ HOẠCH TUẦN -->
        <section class="time-card">
            <div class="section-heading">
                <div><h3>Kế hoạch tuần</h3><p>Tiến độ thực hiện kế hoạch @Model.WeekLabel</p></div>
            </div>
            <div class="plan-grid">
                <div class="plan-stat">Đã lên lịch<strong>@Model.WeekPlannedText</strong></div>
                <div class="plan-stat">Đã hoàn thành<strong>@Model.WeekDone</strong></div>
                <div class="plan-stat">Còn lại<strong>@Model.WeekRemaining</strong></div>
            </div>
            <div class="bar" role="progressbar" aria-valuenow="@Model.WeekPercent" aria-valuemin="0" aria-valuemax="100"><i style="width:@Model.WeekPercent%"></i></div>
            <p class="plan-note">Đã thực hiện @Model.WeekPercent% các sự kiện đã lên lịch trong tuần.</p>
        </section>
    </div>

    <partial name="_EventFormModal" />
    <partial name="_EventDetailModal" />
</div>

@section Scripts {
    <script src="~/js/time.js" asp-append-version="true"></script>
}
