@* Dashboard: trang tổng quan sau khi đăng nhập. CSS và JS được nạp riêng qua Sections. *@
@{
    ViewData["Title"] = "Tổng quan & Học tập";
    ViewData["PageTitle"] = "Tổng quan";
    ViewData["ActivePage"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true" defer></script>
}

<!-- TỔNG QUAN -->
<section class="view" id="tong-quan">

    <div class="hd">
        <div>
            <span class="pill">MY LIFE SPACE · PERSONAL HUB</span>
            <h1>Chào ngày mới, bạn</h1>
            <p class="mut">
                Một ngày tốt bắt đầu từ những ưu tiên rõ ràng.
                Đây là bức tranh cuộc sống của bạn hôm nay.
            </p>
        </div>

        <button class="btn" type="button">Xem lịch</button>
        <button class="btn p" type="button">+ Lên kế hoạch</button>
    </div>

    <div class="g2">

        <div class="hero">
            <small>YOUR DAILY MOMENTUM</small>

            <h2>
                Tiến từng bước nhỏ,<br>
                tạo nên thay đổi lớn.
            </h2>

            <p>
                Giữ nhịp học tập, công việc và chăm sóc bản thân.
                Hôm nay bạn muốn hoàn thành điều gì quan trọng nhất?
            </p>

            <div class="hrow">
                <button class="btn" type="button"
                        onclick="document.getElementById('qi').focus()">
                    Chọn ưu tiên hôm nay
                </button>

                <div class="bar">
                    <i style="width:68%"></i>
                </div>

                <span>Mục tiêu tuần · 68%</span>
            </div>
        </div>

        <div class="card">

            <div class="ch">
                <h3>Lịch của bạn</h3>
                <span class="pill">HÔM NAY</span>
            </div>

            <div class="week" id="week"></div>

            <div class="ev">
                <div class="e">
                    Lớp Mạng máy tính
                    <small>07:30 · Phòng B2-304</small>
                </div>

                <div class="e b">
                    Họp nhóm đồ án
                    <small>15:00</small>
                </div>

                <div class="e c">
                    Hạn nộp bài tập CSDL
                    <small>23:59</small>
                </div>
            </div>

        </div>

    </div>


    <div class="g4">

        <div class="card st">
            <div class="t">
                Việc cần hoàn thành
            </div>
            <b id="openCnt">4</b>
            <small class="mut">Công việc đang mở</small>
        </div>

        <div class="card st">
            <div class="t">
                Dự án đang chạy
            </div>
            <b>03</b>
            <small class="mut">Không gian đang theo dõi</small>
        </div>

        <div class="card st">
            <div class="t">
                Mục tiêu cá nhân
            </div>
            <b>03</b>
            <small class="mut">Đang trên hành trình</small>
        </div>

        <div class="card st">
            <div class="t">
                Chuỗi thói quen
            </div>
            <b>07 ngày</b>
            <small class="mut">Duy trì đều đặn</small>
        </div>

    </div>


    <div class="g2b">

        <div class="card">

            <div class="ch">
                <div>
                    <h3>Việc ưu tiên hôm nay</h3>
                    <p class="mut">Chọn việc quan trọng và bắt đầu ngay</p>
                </div>

                <a class="tag" href="#hoc-tap">Học tập</a>
            </div>

            <form class="add" id="addT">

                <input id="qi" type="text" maxlength="120" autocomplete="off"
                       placeholder="Thêm nhanh một việc cần làm..."
                       aria-label="Việc mới" required>

                <button class="btn p" type="submit">
                    + Thêm
                </button>

            </form>

            <div id="tasks"></div>

        </div>


        <div class="card">

            <div class="ch">
                <div>
                    <h3>Nhịp độ phát triển</h3>
                    <p class="mut">Tiến độ các mục tiêu nổi bật</p>
                </div>

                <span class="pill">TUẦN NÀY</span>
            </div>

            <div class="prog">

                <div>
                    <div>
                        <span>Hoàn thành dự án LIFEHUB</span>
                        <span class="accent-text">70%</span>
                    </div>
                    <div class="bar">
                        <i style="width:70%"></i>
                    </div>
                </div>

                <div>
                    <div>
                        <span>Ôn tập lập trình</span>
                        <span class="accent-text">55%</span>
                    </div>
                    <div class="bar">
                        <i style="width:55%"></i>
                    </div>
                </div>

                <div>
                    <div>
                        <span>Đọc 2 cuốn sách</span>
                        <span class="accent-text">40%</span>
                    </div>
                    <div class="bar">
                        <i style="width:40%"></i>
                    </div>
                </div>

                <div>
                    <div>
                        <span>Chạy bộ 20 km</span>
                        <span class="warn-text">30%</span>
                    </div>
                    <div class="bar">
                        <i class="warn-bar" style="width:30%"></i>
                    </div>
                </div>

            </div>

        </div>

    </div>

</section>
