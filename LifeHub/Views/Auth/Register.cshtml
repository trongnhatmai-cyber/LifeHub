@model LifeHub.Models.ViewModels.RegisterViewModel;
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Tạo tài khoản | LifeHub</title>

    <link rel="icon" type="image/png" href="~/images/lifehub-icon.png" asp-append-version="true">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true">
</head>

<body>

    <div class="auth-bg">
        <div class="bg-circle circle-one"></div>
        <div class="bg-circle circle-two"></div>
        <div class="bg-circle circle-three"></div>
    </div>

    <header class="auth-header">
        <a asp-controller="Home" asp-action="Index" class="logo" aria-label="Trang chủ LifeHub">
            <img src="~/images/lifehub-logo.png" alt="LifeHub – Plan • Focus • Achieve" class="auth-logo-img" asp-append-version="true">
        </a>

        <a href="/Home/Index" class="back-home">
            <span>←</span> Trang chủ
        </a>
    </header>

    <main class="auth-container register-container">

        <div class="auth-card register-card">

            <div class="auth-top">
                <div class="auth-symbol" aria-hidden="true">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3l9 4.5-9 4.5-9-4.5z" />
                        <path d="M3 12l9 4.5 9-4.5" />
                        <path d="M3 16.5l9 4.5 9-4.5" />
                    </svg>
                </div>

                <span class="auth-label">BẮT ĐẦU HÀNH TRÌNH MỚI</span>

                <h1>Tạo không gian của riêng bạn.</h1>

                <p>
                    Một tài khoản duy nhất để sắp xếp
                    mọi khía cạnh trong cuộc sống.
                </p>
            </div>

            <form class="auth-form" asp-controller="Auth" asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="form-group">
                    <label for="fullname">Họ và tên</label>

                    <div class="input-wrap">
                        <span class="input-icon" aria-hidden="true">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="8" r="4" />
                                <path d="M4 21a8 8 0 0 1 16 0" />
                            </svg>
                        </span>
                        <input
                            type="text"
                            id="fullname"
                            placeholder="Nguyễn Văn A"
                            required
                            asp-for="FullName"
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="email">Địa chỉ email</label>

                    <div class="input-wrap">
                        <span class="input-icon" aria-hidden="true">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="5" width="18" height="14" rx="3" />
                                <path d="M3 7l9 6 9-6" />
                            </svg>
                        </span>
                        <input asp-for="Email"
                            type="email"
                            id="email"
                            placeholder="name@example.com"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="password">Mật khẩu</label>

                    <div class="input-wrap">
                        <span class="input-icon" aria-hidden="true">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="4" y="11" width="16" height="10" rx="2.5" />
                                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                            </svg>
                        </span>

                        <input asp-for="Password"
                            type="password"
                            id="password"
                            placeholder="Tối thiểu 8 ký tự"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword('password', this)"
                        >Hiện</button>
                    </div>

                    <div class="password-hint">
                        Sử dụng mật khẩu đủ mạnh để bảo vệ tài khoản.
                    </div>
                </div>

                <div class="form-group">
                    <label for="confirm-password">Xác nhận mật khẩu</label>

                    <div class="input-wrap">
                        <span class="input-icon" aria-hidden="true">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="4" y="11" width="16" height="10" rx="2.5" />
                                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                            </svg>
                        </span>

                        <input asp-for="ConfirmPassword"
                            type="password"
                            id="confirm-password"
                            placeholder="Nhập lại mật khẩu"
                            required
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword('confirm-password', this)"
                        >Hiện</button>
                    </div>
                </div>

                <label class="terms">
                    <input type="checkbox" id="termsCheckbox" required>
                    <span>
                        Tôi đồng ý với
                        <button type="button" class="terms-link" data-legal-tab="terms">Điều khoản sử dụng</button>
                        và
                        <button type="button" class="terms-link" data-legal-tab="privacy">Chính sách bảo mật</button>
                        của LifeHub.
                    </span>
                </label>

                <button type="submit" class="auth-submit">
                    Tạo tài khoản
                    <span>→</span>
                </button>

            </form>

            <div class="auth-divider">
                <span>hoặc</span>
            </div>

            <button type="button" class="google-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill="#EA4335" d="M12 10.2v3.9h5.5c-.2 1.3-1.6 3.8-5.5 3.8-3.3 0-6-2.7-6-6s2.7-6 6-6c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.8 3.4 14.6 2.5 12 2.5 6.8 2.5 2.5 6.8 2.5 12s4.3 9.5 9.5 9.5c5.5 0 9.1-3.9 9.1-9.3 0-.6-.1-1.1-.2-1.6H12z" />
                </svg>
                Đăng ký với Google
            </button>

            <div class="auth-switch">
                Đã có tài khoản?
                <a href="/Auth/Login">Đăng nhập ngay</a>
            </div>

        </div>

        <div class="auth-footer">
            <span>© 2026 LifeHub</span>
            <span>Organize your life, one place.</span>
        </div>

    </main>

    <!-- MODAL ĐIỀU KHOẢN SỬ DỤNG & CHÍNH SÁCH BẢO MẬT -->
    <div class="legal-modal" id="legalModal" role="dialog" aria-modal="true" aria-labelledby="legalModalTitle" aria-hidden="true">
        <div class="legal-backdrop" data-legal-close></div>
        <div class="legal-dialog">
            <div class="legal-head">
                <h2 id="legalModalTitle">Điều khoản &amp; Bảo mật LifeHub</h2>
                <button type="button" class="legal-close" data-legal-close aria-label="Đóng hộp thoại">×</button>
            </div>
            <div class="legal-tabs" role="tablist" aria-label="Chọn nội dung">
                <button type="button" class="legal-tab is-active" role="tab" id="tab-terms" aria-controls="pane-terms" aria-selected="true" data-legal-switch="terms">Điều khoản sử dụng</button>
                <button type="button" class="legal-tab" role="tab" id="tab-privacy" aria-controls="pane-privacy" aria-selected="false" data-legal-switch="privacy">Chính sách bảo mật</button>
            </div>
            <div class="legal-body">
                <div class="legal-pane is-active" id="pane-terms" role="tabpanel" aria-labelledby="tab-terms">
                    <h3>1. Phạm vi sử dụng tài khoản</h3>
                    <p>Tài khoản LifeHub được tạo để phục vụ quản lý học tập, công việc, dự án, tài chính và sinh hoạt cá nhân. Bạn chịu trách nhiệm bảo mật thông tin đăng nhập và các hoạt động phát sinh từ tài khoản của mình.</p>
                    <h3>2. Nội dung &amp; tệp đính kèm</h3>
                    <ul>
                        <li>Cung cấp địa chỉ email hợp lệ khi đăng ký tài khoản.</li>
                        <li>Không tải lên tệp chứa mã độc hoặc nội dung vi phạm pháp luật trong các dự án và tài liệu chia sẻ.</li>
                        <li>Tôn trọng quyền riêng tư và phân quyền (Quản lý, Thành viên, Người xem) khi cộng tác nhóm.</li>
                    </ul>
                    <h3>3. Lưu ý về tính năng theo dõi sinh hoạt</h3>
                    <p>Các mục ghi nhận giấc ngủ, vận động, nước uống và tâm trạng chỉ hỗ trợ tự quan sát thói quen cá nhân, không thay thế tư vấn hoặc chẩn đoán y tế.</p>
                </div>
                <div class="legal-pane" id="pane-privacy" role="tabpanel" aria-labelledby="tab-privacy">
                    <h3>1. Thông tin được lưu trữ</h3>
                    <p>LifeHub chỉ lưu trữ họ tên, email, mật khẩu đã mã hóa cùng dữ liệu nghiệp vụ bạn chủ động tạo trong 10 phân hệ và tùy chọn giao diện cá nhân.</p>
                    <h3>2. Nguyên tắc tách biệt &amp; sử dụng</h3>
                    <ul>
                        <li>Dữ liệu cá nhân được cô lập theo tài khoản, không hiển thị công khai khi chưa có thao tác chia sẻ.</li>
                        <li>Không bán, trao đổi hoặc chia sẻ dữ liệu cá nhân cho bên thứ ba vì mục đích quảng cáo.</li>
                        <li>Mọi thao tác thêm, sửa, xóa đều được bảo vệ qua cơ chế xác thực của hệ thống.</li>
                    </ul>
                    <h3>3. Quyền kiểm soát của bạn</h3>
                    <p>Bạn có toàn quyền chỉnh sửa hồ sơ, thu hồi quyền chia sẻ dự án hoặc ghi chú, và xuất số liệu báo cáo ra CSV bất cứ lúc nào.</p>
                </div>
            </div>
            <div class="legal-foot">
                <button type="button" class="legal-btn" data-legal-close>Đóng</button>
                <button type="button" class="legal-btn legal-btn-primary" id="legalAgreeBtn">Tôi đã hiểu và đồng ý</button>
            </div>
        </div>
    </div>

    <script>
        function togglePassword(id, button) {
            const input = document.getElementById(id);

            if (input.type === "password") {
                input.type = "text";
                button.textContent = "Ẩn";
            } else {
                input.type = "password";
                button.textContent = "Hiện";
            }
        }

        (function () {
            const modal = document.getElementById('legalModal');
            if (!modal) return;

            const tabs = modal.querySelectorAll('[data-legal-switch]');
            const panes = {
                terms: document.getElementById('pane-terms'),
                privacy: document.getElementById('pane-privacy')
            };
            const termsCheckbox = document.getElementById('termsCheckbox');
            const agreeBtn = document.getElementById('legalAgreeBtn');

            function switchTab(name) {
                tabs.forEach(function (t) {
                    const active = t.getAttribute('data-legal-switch') === name;
                    t.classList.toggle('is-active', active);
                    t.setAttribute('aria-selected', String(active));
                });
                Object.keys(panes).forEach(function (key) {
                    if (panes[key]) panes[key].classList.toggle('is-active', key === name);
                });
            }

            function openModal(tabName) {
                switchTab(tabName || 'terms');
                modal.classList.add('is-open');
                modal.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }

            function closeModal() {
                modal.classList.remove('is-open');
                modal.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            }

            document.querySelectorAll('[data-legal-tab]').forEach(function (btn) {
                btn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    openModal(btn.getAttribute('data-legal-tab'));
                });
            });

            tabs.forEach(function (t) {
                t.addEventListener('click', function () {
                    switchTab(t.getAttribute('data-legal-switch'));
                });
            });

            modal.querySelectorAll('[data-legal-close]').forEach(function (el) {
                el.addEventListener('click', closeModal);
            });

            if (agreeBtn) {
                agreeBtn.addEventListener('click', function () {
                    if (termsCheckbox) termsCheckbox.checked = true;
                    closeModal();
                });
            }

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && modal.classList.contains('is-open')) {
                    closeModal();
                }
            });
        })();
    </script>

</body>
</html>
