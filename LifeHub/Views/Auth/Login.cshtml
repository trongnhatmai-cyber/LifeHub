@model LifeHub.Models.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập | LifeHub</title>

    <link rel="icon" type="image/png" href="~/images/lifehub-icon.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>

<body>

    <!-- Nền chuyển sắc dịu nhẹ -->
    <div class="auth-bg" aria-hidden="true">
        <div class="bg-circle circle-one"></div>
        <div class="bg-circle circle-two"></div>
        <div class="bg-circle circle-three"></div>
    </div>

    <!-- Thanh điều hướng đầu trang -->
    <header class="auth-header">
        <a asp-controller="Home" asp-action="Index" class="logo" aria-label="Trang chủ LifeHub">
            <img src="~/images/lifehub-logo.png" alt="LifeHub – Plan • Focus • Achieve" class="auth-logo-img" asp-append-version="true" />
        </a>

        <a asp-controller="Home" asp-action="Index" class="back-home">
            <span>←</span> Quay về trang chủ
        </a>
    </header>

    <main class="auth-container">

        <div class="login-split-shell">

            <!-- CỘT TRÁI: GIỚI THIỆU TỐI GIẢN LIFEHUB -->
            <section class="login-brand-pane" aria-label="Giới thiệu không gian LifeHub">
                <div class="login-brand-copy">
                    <h2>Một không gian gọn gàng cho mọi nhịp sống.</h2>
                    <p>Từ lịch học, công việc đến tài chính và mục tiêu — tất cả bắt đầu từ đây.</p>
                </div>

                <div class="login-visual-frame">
                    <img src="~/images/login-visual.jpg" alt="Minh họa không gian làm việc LifeHub" asp-append-version="true" />
                </div>

                <div class="login-brand-foot">
                    LifeHub · Plan • Focus • Achieve
                </div>
            </section>

            <!-- CỘT PHẢI: BIỂU MẪU ĐĂNG NHẬP CỐT LÕI -->
            <section class="login-form-pane">

                <div class="auth-top">
                    <div class="auth-symbol" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 3l9 4.5-9 4.5-9-4.5z" />
                            <path d="M3 12l9 4.5 9-4.5" />
                            <path d="M3 16.5l9 4.5 9-4.5" />
                        </svg>
                    </div>

                    <span class="auth-label">CHÀO MỪNG TRỞ LẠI</span>
                    <h1>Rất vui được gặp lại bạn.</h1>
                    <p>Nhập thông tin tài khoản để truy cập Bảng điều khiển cá nhân của bạn.</p>

                    @if (TempData["SuccessMessage"] is string ok && !string.IsNullOrWhiteSpace(ok))
                    {
                        <div class="auth-flash success" role="status">@ok</div>
                    }

                    @if (TempData["ErrorMessage"] is string err && !string.IsNullOrWhiteSpace(err))
                    {
                        <div class="auth-flash error" role="alert">@err</div>
                    }
                </div>

                <form class="auth-form"
                      asp-controller="Auth"
                      asp-action="Login"
                      asp-route-returnUrl="@ViewData["ReturnUrl"]"
                      asp-antiforgery="false"
                      method="post"
                      novalidate>

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                    <div class="form-group">
                        <label asp-for="Email">Địa chỉ email</label>
                        <div class="input-wrap">
                            <span class="input-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="3" y="5" width="18" height="14" rx="3" />
                                    <path d="M3 7l9 6 9-6" />
                                </svg>
                            </span>
                            <input asp-for="Email"
                                   type="email"
                                   id="email"
                                   autocomplete="email"
                                   placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>

                    <div class="form-group">
                        <div class="label-row">
                            <label asp-for="Password">Mật khẩu</label>
                            <a href="#" class="forgot-link">Quên mật khẩu?</a>
                        </div>

                        <div class="input-wrap">
                            <span class="input-icon" aria-hidden="true">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                                    <rect x="4" y="11" width="16" height="10" rx="2.5" />
                                    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                                </svg>
                            </span>

                            <input asp-for="Password"
                                   type="password"
                                   id="password"
                                   autocomplete="current-password"
                                   placeholder="Nhập mật khẩu của bạn" />

                            <button type="button"
                                    class="password-toggle"
                                    onclick="togglePassword('password', this)"
                                    aria-label="Hiện hoặc ẩn mật khẩu">
                                Hiện
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-error"></span>
                    </div>

                    <div class="form-options">
                        <label class="remember">
                            <input type="checkbox" asp-for="RememberMe" />
                            <span>Ghi nhớ đăng nhập trong 24 giờ</span>
                        </label>
                    </div>

                    <button type="submit" class="auth-submit">
                        Đăng nhập vào LifeHub
                        <span>→</span>
                    </button>

                </form>

                <div class="auth-divider">
                    <span>hoặc</span>
                </div>

                <button type="button" class="google-btn">
                    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="#EA4335" d="M12 10.2v3.9h5.5c-.2 1.3-1.6 3.8-5.5 3.8-3.3 0-6-2.7-6-6s2.7-6 6-6c1.9 0 3.1.8 3.8 1.5l2.6-2.5C16.8 3.4 14.6 2.5 12 2.5 6.8 2.5 2.5 6.8 2.5 12s4.3 9.5 9.5 9.5c5.5 0 9.1-3.9 9.1-9.3 0-.6-.1-1.1-.2-1.6H12z" />
                    </svg>
                    Tiếp tục với Google
                </button>

                <div class="auth-switch">
                    Chưa có tài khoản?
                    <a asp-controller="Auth" asp-action="Register">Tạo tài khoản mới</a>
                </div>

            </section>

        </div>

        <div class="auth-footer">
            <span>© 2026 LifeHub</span>
            <span>Quản lý trọn vẹn cuộc sống trong một không gian.</span>
        </div>

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword(id, button) {
            const input = document.getElementById(id);
            if (!input) return;

            if (input.type === "password") {
                input.type = "text";
                button.textContent = "Ẩn";
            } else {
                input.type = "password";
                button.textContent = "Hiện";
            }
        }
    </script>

</body>
</html>
