@model LifeHub.Models.ViewModels.LoginViewModel;
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập | LifeHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true">
</head>

<body>

    <div class="auth-bg">
        <div class="bg-circle circle-one"></div>
        <div class="bg-circle circle-two"></div>
        <div class="bg-circle circle-three"></div>
    </div>

    <header class="auth-header">
        <a href="/Home/Index" class="logo">
            <span class="logo-icon">L</span>
            LifeHub
        </a>

        <a href="/Home/Index" class="back-home">
            <span>←</span> Trang chủ
        </a>
    </header>

    <main class="auth-container">

        <div class="auth-card">

            <div class="auth-top">
                <div class="auth-symbol">
                    <span>✦</span>
                </div>

                <span class="auth-label">CHÀO MỪNG TRỞ LẠI</span>

                <h1>Rất vui được gặp lại bạn.</h1>

                <p>
                    Đăng nhập để tiếp tục quản lý công việc,
                    học tập và cuộc sống của bạn.
                </p>
            </div>

            <form class="auth-form" asp-controller="Auth" asp-action="Login" method="post">

                <div class="form-group">
                    <label for="email">Địa chỉ email</label>

                    <div class="input-wrap">
                        <span class="input-icon">✉</span>
                        <input asp-for="Email"
                            type="email"
                            id="email"
                            placeholder="name@example.com"
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <div class="label-row">
                        <label for="password">Mật khẩu</label>
                        <a href="#" class="forgot-link">Quên mật khẩu?</a>
                    </div>

                    <div class="input-wrap">
                        <span class="input-icon">♧</span>

                        <input
                            type="password"
                            id="password"
                            placeholder="Nhập mật khẩu"
                            required
                            asp-for="Password"
                        >

                        <button
                            type="button"
                            class="password-toggle"
                            onclick="togglePassword('password', this)"
                            aria-label="Hiện hoặc ẩn mật khẩu"
                        >Hiện</button>
                    </div>
                </div>

                <div class="form-options">
                    <label class="remember">
                        <input type="checkbox" asp-for="RememberMe">
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                </div>

                <button type="submit" class="auth-submit">
                    Đăng nhập
                    <span>→</span>
                </button>

            </form>

            <div class="auth-divider">
                <span>hoặc</span>
            </div>

            <button type="button" class="google-btn">
                <span class="google-icon">G</span>
                Tiếp tục với Google
            </button>

            <div class="auth-switch">
                Chưa có tài khoản?
                <a href="/Auth/Register">Tạo tài khoản mới</a>
            </div>

        </div>

        <div class="auth-footer">
            <span>© 2026 LifeHub</span>
            <span>Organize your life, one place.</span>
        </div>

    </main>

    <script>
        function togglePassword(id, button) {
            const input = document.getElementById(id);

            if (input.type === "password") {
                input.type = "text";
                button.textContent = "Ẩn";
            } else {
                input.type = "password";
                button.textContent = "Hiện";
            }
        }
    </script>

</body>
</html>
