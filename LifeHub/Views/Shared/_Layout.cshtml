@{
    // Trả về "active" nếu đang ở đúng trang
    string Cls(string page) => ViewData["ActivePage"]?.ToString() == page ? "active" : "";

    var userName = User.Identity?.IsAuthenticated == true && !string.IsNullOrWhiteSpace(User.Identity?.Name)
        ? User.Identity!.Name!
        : "Người dùng Demo";
    var initial = userName.Trim()[0].ToString().ToUpper();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - LifeHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <!-- Bootstrap: xóa dòng này nếu không trang nào còn dùng -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS chung của Layout (nạp sau Bootstrap để ghi đè) -->
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    <!-- CSS riêng của từng trang -->
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="app">

        <aside class="sidebar">
            <div class="logo">
                <span class="logo-mark">L</span>
                <span>LIFEHUB</span>
            </div>

            <div class="menu-label">KHÔNG GIAN CỦA BẠN</div>

            <nav class="menu">
                <a asp-controller="Dashboard" asp-action="Index" class="@(Cls("Dashboard") + (Cls("Home") != "" ? " active" : ""))"><span class="menu-sym">▦</span>Tổng quan</a>
                <a asp-controller="Study" asp-action="Index" class="@Cls("Study")"><span class="menu-sym">▤</span>Học tập</a>
                <a asp-controller="Project" asp-action="Index" class="@Cls("Project")"><span class="menu-sym">🗂</span>Dự án</a>
                <a asp-controller="Task" asp-action="Index" class="@(Cls("Task") + (Cls("Work") != "" ? " active" : ""))"><span class="menu-sym">☑</span>Công việc</a>
                <a asp-controller="Time" asp-action="Index" class="@Cls("Time")"><span class="menu-sym">◷</span>Thời gian</a>
                <a asp-controller="Goal" asp-action="Index" class="@(Cls("Goal") + (Cls("Goals") != "" ? " active" : ""))"><span class="menu-sym">◎</span>Mục tiêu &amp; Thói quen</a>
                <a asp-controller="Finance" asp-action="Index" class="@Cls("Finance")"><span class="menu-sym">＄</span>Tài chính</a>
                <a asp-controller="Knowledge" asp-action="Index" class="@Cls("Knowledge")"><span class="menu-sym">✉</span>Kiến thức &amp; Tài liệu</a>
                <a asp-controller="Lifestyle" asp-action="Index" class="@Cls("Lifestyle")"><span class="menu-sym">♡</span>Sinh hoạt &amp; Thành tích</a>
                <a asp-controller="AI" asp-action="Index" class="@Cls("AI")"><span class="menu-sym">✧</span>Trợ lý AI</a>
            </nav>

            <div class="sidebar-spacer"></div>

            <a asp-controller="Profile" asp-action="Index" class="sidebar-bottom @Cls("Profile")">
                <span class="menu-sym">♙</span>Hồ sơ &amp; cài đặt
            </a>
        </aside>

        <main class="main">
            <header class="topbar">
                <h2>@ViewData["Title"]</h2>

                <div class="topbar-right">
                    <span class="topbar-date" id="currentDate"></span>

                    <button class="theme-button" id="themeToggle" type="button" aria-label="Chuyển chế độ giao diện">
                        Sáng / Tối
                    </button>

                    <span class="user-name">@userName</span>
                    <div class="avatar">@initial</div>
                </div>
            </header>

            <div class="page-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- JavaScript dùng chung toàn hệ thống -->
    <script src="~/js/lifehub.js" asp-append-version="true"></script>

    <!-- JavaScript riêng của từng trang -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
