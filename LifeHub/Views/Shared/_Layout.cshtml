
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>@ViewData["Title"] - LifeHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/lifehub.css" asp-append-version="true">
</head>
<body>

<div class="app">

    <!-- SIDEBAR DÙNG CHUNG -->
    <aside class="side">

        <div class="logo">
            <b>L</b>
            <span>LIFEHUB</span>
        </div>

        <small>KHÔNG GIAN CỦA BẠN</small>

        <a href="/Home/Index" class="menu-link" data-page="tong-quan">
            Tổng quan
        </a>

        <a href="/Home/Index#hoc-tap" class="menu-link" data-page="hoc-tap">
            Học tập
        </a>

        <a href="/Project/Index" class="menu-link" data-page="du-an">
            Dự án
        </a>

        <a href="/Work/Index" class="menu-link" data-page="cong-viec">
            Công việc
        </a>

        <a href="/Time/Index" class="menu-link" data-page="thoi-gian">
            Thời gian
        </a>

        <a href="/Goals/Index" class="menu-link" data-page="muc-tieu">
            Mục tiêu &amp; thói quen
        </a>

        <a href="/Finance/Index" class="menu-link" data-page="tai-chinh">
            Tài chính
        </a>

        <a href="/Knowledge/Index" class="menu-link" data-page="kien-thuc">
            Kiến thức &amp; tài liệu
        </a>

        <a href="/AI/Index" class="menu-link" data-page="ai">
            AI Assistant
        </a>

        <div class="sp"></div>

        <a href="/Profile/Index" class="menu-link" data-page="ho-so">
            Hồ sơ &amp; cài đặt
        </a>

    </aside>


    <!-- MAIN CONTENT -->
    <div class="main">

        <!-- HEADER DÙNG CHUNG -->
        <header class="top">

            <h2 id="ttl">@ViewData["PageTitle"]</h2>

            <span class="chip" id="today"></span>

            <button class="tg" id="theme" type="button">
                Sáng / Tối
            </button>

            <span class="mut">Người dùng Demo</span>

            <span class="av">N</span>

        </header>

        <!-- NỘI DUNG TỪNG TRANG -->
        @RenderBody()

    </div>

</div>

<script src="~/js/lifehub.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
