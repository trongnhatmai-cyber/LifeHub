@using System.Globalization
@{
    var active = ViewData["ActivePage"] as string ?? string.Empty;
    var userName = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Khách" : User.Identity!.Name!;
    var initial = userName.Trim()[0].ToString().ToUpperInvariant();
    var today = DateTime.Now.ToString("dddd, dd/MM/yyyy", new CultureInfo("vi-VN"));

    // Mỗi mục: { ActivePage key, nhãn, controller, tên màu pastel (--pastel-{tên}-accent), ký hiệu }. Action luôn là Index.
    var groups = new List<(string Title, List<string[]> Items)>
    {
        ("Tổng quan", new List<string[]> {
            new[] { "Dashboard", "Tổng quan", "Dashboard", "study", "◧" } }),
        ("Học tập và công việc", new List<string[]> {
            new[] { "Study", "Học tập", "Study", "study", "✎" },
            new[] { "Task", "Công việc", "Task", "task", "☑" },
            new[] { "Project", "Dự án", "Project", "project", "❖" },
            new[] { "Time", "Lịch và thời gian", "Time", "time", "◷" } }),
        ("Cuộc sống", new List<string[]> {
            new[] { "Finance", "Tài chính", "Finance", "finance", "₫" },
            new[] { "Goal", "Mục tiêu", "Goal", "goal", "◎" },
            new[] { "Habit", "Thói quen", "Habit", "habit", "↻" },
            new[] { "Knowledge", "Ghi chú và tài liệu", "Knowledge", "knowledge", "❏" },
            new[] { "Lifestyle", "Sinh hoạt", "Lifestyle", "lifestyle", "♡" } }),
        ("Trợ lý", new List<string[]> {
            new[] { "AI", "Trợ lý AI", "AI", "ai", "✦" } })
    };
}

<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | LifeHub</title>
    <script>
        // Đặt theme trước khi trang vẽ để không bị nháy sáng/tối.
        (function () {
            try {
                var t = localStorage.getItem("lifehub_theme");
                if (!t && window.matchMedia && matchMedia("(prefers-color-scheme: dark)").matches) t = "dark";
                document.documentElement.dataset.theme = t === "dark" ? "dark" : "light";
            } catch (e) { document.documentElement.dataset.theme = "light"; }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <a asp-controller="Dashboard" asp-action="Index" class="logo">
                <span class="logo-mark">L</span>LifeHub
            </a>

            @foreach (var g in groups)
            {
                <div class="menu-label">@g.Title</div>
                <nav class="menu" aria-label="@g.Title">
                    @foreach (var item in g.Items)
                    {
                        <a asp-controller="@item[2]" asp-action="Index"
                           class="@(active == item[0] ? "active" : null)"
                           aria-current="@(active == item[0] ? "page" : null)">
                            <span class="menu-sym" style="color:var(--pastel-@(item[3])-accent)" aria-hidden="true">@item[4]</span>@item[1]
                        </a>
                    }
                </nav>
            }

            <div class="sidebar-spacer"></div>

            <a asp-controller="Settings" asp-action="Index" class="sidebar-bottom"
               aria-current="@(active == "Settings" ? "page" : null)">
                <span class="menu-sym" aria-hidden="true">⚙</span>Cài đặt
            </a>
        </aside>

        <div class="main">
            <header class="topbar">
                <h2>@ViewData["Title"]</h2>
                <div class="topbar-right">
                    <span class="topbar-date">@today</span>
                    <a asp-controller="Notification" asp-action="Index" class="theme-button">Thông báo</a>
                    <button type="button" class="theme-button" id="themeToggle" aria-pressed="false">☾ Chế độ tối</button>
                    <span class="user-name">@userName</span>
                    <a asp-controller="Profile" asp-action="Index" class="avatar" title="Hồ sơ của @userName" aria-label="Hồ sơ của @userName">@initial</a>
                    <form asp-controller="Auth" asp-action="Logout" method="post">
                        <button type="submit" class="theme-button">Đăng xuất</button>
                    </form>
                </div>
            </header>

            <main class="page-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/lifehub.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
