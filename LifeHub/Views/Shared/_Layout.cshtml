}

<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] | LifeHub</title>

    <script>
        (function () {
            try {
                var t = localStorage.getItem("lifehub_theme");

                if (!t && window.matchMedia &&
                    matchMedia("(prefers-color-scheme: dark)").matches) {
                    t = "dark";
                }

                document.documentElement.dataset.theme =
                    t === "dark" ? "dark" : "light";
            } catch (e) {
                document.documentElement.dataset.theme = "light";
            }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <div class="app">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="logo">
                <span class="logo-mark">L</span>
                LifeHub
            </a>

            @foreach (var g in groups)
            {
                <div class="menu-label">@g.Title</div>

                <nav class="menu" aria-label="@g.Title">

                @foreach (var item in g.Items)
                {
                    var kids = children.TryGetValue(item[0], out var childList)
                        ? childList
                        : null;

                    var hasKids = kids != null;
                    var isSelf = active == item[0];

                    var isChildActive = hasKids &&
                        kids!.Any(x => x[0] == active);

                    var isOpen = isSelf || isChildActive;

                    if (hasKids)
                    {
                        <details class="menu-group" open="@(isOpen ? "open" : null)">
                            <summary class="menu-parent @(isOpen ? "is-open" : "")">
                                <span class="menu-sym"
                                    style="color:var(--pastel-@(item[3])-accent)"
                                    aria-hidden="true">
                                    @item[4]
                                </span>

                                <span class="menu-text">@item[1]</span>
                                <span class="menu-chevron" aria-hidden="true">›</span>
                            </summary>

                            <div class="submenu">
                                @foreach (var sub in kids!)
                                {
                                    var isSubActive = active == sub[0];

                                    var childController = sub[0] switch
                                    {
                                        "Transaction" => "Transaction",
                                        "Category" => "Category",
                                        "Wallet" => "Wallet",
                                        "SavingGoal" => "SavingGoal",
                                        "Course" or "Schedule" or "Assignment" or "Grade" or "StudyDocument" => "Study",
                                        _ => item[2]
                                    };

                                    var childAction = sub[0] switch
                                    {
                                        "GoalOverview" or "HabitOverview" => "Index",
                                        "GoalList" => "GoalList",
                                        "KeyResult" => "KeyResult",
                                        "GoalProgress" => "GoalProgress",
                                        "GoalReview" => "GoalReview",
                                        "HabitList" => "HabitList",
                                        "HabitTracking" => "HabitTracking",
                                        "HabitStreak" => "HabitStreak",
                                        "HabitStatistics" => "HabitStatistics",
                                        "Course" => "Courses",
                                        "Schedule" => "Schedule",
                                        "Assignment" => "Assignments",
                                        "Grade" => "Grades",
                                        "StudyDocument" => "Documents",
                                        _ => "Index"
                                    };


                                    <a asp-controller="@childController"
                                    asp-action="@childAction"
                                    class="submenu-link @(isSubActive ? "active" : "")"
                                    aria-current="@(isSubActive ? "page" : null)">

                                        <span class="submenu-dot"></span>
                                        <span>@sub[1]</span>
                                    </a>
                                }
                            </div>
                        </details>
                    }
                    else
                    {
                        <a asp-controller="@item[2]"
                        asp-action="Index"
                        class="submenu-link @(isSelf ? "active" : "")"
                        aria-current="@(isSelf ? "page" : null)">

                            <span class="menu-sym"
                                style="color:var(--pastel-@(item[3])-accent)"
                                aria-hidden="true">
                                @item[4]
                            </span>

                            <span class="menu-text">@item[1]</span>
                        </a>
                    }
                }


                </nav>
            }

            <div class="sidebar-spacer"></div>

            <a asp-controller="Settings"
               asp-action="Index"
               class="sidebar-bottom"
               aria-current="@(active == "Settings" ? "page" : null)">

                <span class="menu-sym" aria-hidden="true">⚙</span>
                Cài đặt

            </a>

        </aside>

        <!-- MAIN CONTENT -->
        <div class="main">

            <header class="topbar">

                <h2>@ViewData["Title"]</h2>

                <div class="topbar-right">

                    <span class="topbar-date">@today</span>

                    <a asp-controller="Notification"
                       asp-action="Index"
                       class="theme-button">
                        Thông báo
                    </a>

                    <button type="button"
                            class="theme-button"
                            id="themeToggle"
                            aria-pressed="false">
                        ☾ Chế độ tối
                    </button>

                    <span class="user-name">@userName</span>

                    <a asp-controller="Profile"
                       asp-action="Index"
                       class="avatar"
                       title="Hồ sơ của @userName"
                       aria-label="Hồ sơ của @userName">
                        @initial
                    </a>

                    <form asp-controller="Auth"
                          asp-action="Logout"
                          method="post">

                        <button type="submit" class="theme-button">
                            Đăng xuất
                        </button>

                    </form>

                </div>

            </header>

            <main class="page-content">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/js/lifehub.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
