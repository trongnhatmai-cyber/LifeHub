@using System.Globalization
@using System.Security.Claims
@{
    var active = ViewData["ActivePage"] as string;

    //tác dụng dự phòng: nếu không có ActivePage thì thử lấy giá trị từ URL.
    if (string.IsNullOrWhiteSpace(active))
    {
        active = Context.Request.Query["section"].ToString();
    }
    //Nếu tên người dùng trống → hiển thị Khách. Nếu có tên → hiển thị tên tài khoản.
    var userName = string.IsNullOrWhiteSpace(User.Identity?.Name)
        ? "Khách"
        : User.Identity!.Name!;

    //Lấy ký tự đầu tiên của tên người dùng để hiển thị trong Avatar.
    var initial = userName.Trim()[0].ToString().ToUpperInvariant();

    // Email hiển thị trong menu Avatar (claim được tạo lúc đăng nhập).
    var userEmail = User.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;

    //Ngày hiện tại bằng tiếng Việt. Topbar mới theo mẫu thiết kế không còn hiển thị ngày giờ nên biến này chỉ giữ lại để dùng khi cần.
    var today = DateTime.Now.ToString("dddd, dd/MM/yyyy", new CultureInfo("vi-VN"));

    // CẤU TRÚC MENU CHA
    // { ActivePage, Label, Controller, Color, Icon }
    var groups = new List<(string Title, List<string[]> Items)>
    {
        ("Tổng quan", new List<string[]> {
            new[] { "Dashboard", "Tổng quan", "Dashboard", "study", "◧" }
        }),

        ("Học tập và công việc", new List<string[]> {
            new[] { "Study", "Học tập", "Study", "study", "✎" },
            new[] { "Task", "Công việc", "Task", "task", "☑" },
            new[] { "Project", "Dự án", "Project", "project", "❖" },
            new[] { "Time", "Lịch và thời gian", "Time", "time", "◷" }
        }),

        ("Quản lý cá nhân", new List<string[]> {
            new[] { "Finance", "Tài chính", "Finance", "finance", "₫" },
            new[] { "Goal", "Mục tiêu", "Goal", "goal", "◎" },
            new[] { "Habit", "Thói quen", "Habit", "habit", "↻" },
            new[] { "Lifestyle", "Sinh hoạt cá nhân", "Lifestyle", "lifestyle", "♡" }
        }),

        ("Tiện ích", new List<string[]> {
            new[] { "AI", "Trợ lý AI", "AI", "ai", "✦" },
            new[] { "Report", "Thống kê", "Report", "time", "▤" }
        })
    };

    // MENU CON
    // { ActivePage key, Label }
    // Các mục con dùng Controller của phân hệ cha.
    var children = new Dictionary<string, List<string[]>>
    {
        ["Study"] = new List<string[]> {
            new[] { "StudyOverview", "Tổng quan" },
            new[] { "Semester", "Học kỳ" },
            new[] { "Course", "Môn học & Khóa học" },
            new[] { "Schedule", "Thời khóa biểu" },
            new[] { "Assignment", "Bài tập & Kỳ thi" },
            new[] { "Grade", "Điểm số" },
            new[] { "StudyDocument", "Tài liệu" }
        },

        ["Task"] = new List<string[]> {
            new[] { "TaskOverview", "Tổng quan" },
            new[] { "TaskList", "Danh sách công việc" },
            new[] { "TaskCategory", "Danh mục công việc" },
        },

        ["Project"] = new List<string[]> {
            new[] { "ProjectOverview", "Tổng quan" },
            new[] { "ProjectList", "Danh sách dự án" }
        },

        ["Time"] = new List<string[]> {
            new[] { "TimeOverview", "Tổng quan thời gian" },
            new[] { "Calendar", "Lịch cá nhân" },
            new[] { "CombinedCalendar", "Lịch tổng hợp" }
        },

        ["Finance"] = new List<string[]> {
            new[] { "FinanceOverview", "Tổng quan tài chính" },
            new[] { "Transaction", "Giao dịch" },
            new[] { "Category", "Danh mục & Ngân sách" },
            new[] { "Wallet", "Ví và tài khoản" },
            new[] { "SavingGoal", "Mục tiêu tiết kiệm" }
        },

        ["Goal"] = new List<string[]> {
            new[] { "GoalOverview", "Tổng quan mục tiêu" },
            new[] { "GoalList", "Danh sách mục tiêu" },
            new[] { "KeyResult", "Kết quả then chốt" },
            new[] { "GoalProgress", "Tiến độ mục tiêu" },
            new[] { "GoalReview", "Đánh giá mục tiêu" }
        },

        ["Habit"] = new List<string[]> {
            new[] { "HabitOverview", "Tổng quan thói quen" },
            new[] { "HabitList", "Danh sách thói quen" },
            new[] { "Category", "Danh mục" },
            new[] { "Habittatistics", "Thống kê" }
        },

        ["Knowledge"] = new List<string[]> {
            new[] { "KnowledgeOverview", "Tổng quan kiến thức" },
            new[] { "NoteList", "Danh sách ghi chú" },
            new[] { "NoteCategory", "Danh mục ghi chú" },
            new[] { "Document", "Tài liệu" }
        },

        ["Lifestyle"] = new List<string[]> {
            new[] { "LifestyleOverview", "Tổng quan sinh hoạt" },
            new[] { "LifestyleLog", "Nhật ký sinh hoạt" },
            new[] { "HealthMonitor", "Theo dõi sức khỏe" },
            new[] { "LifestyleStatistics", "Thống kê sinh hoạt" }
        }
    };
}

<!DOCTYPE html>
<html lang="vi" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Tiêu đề tab -->
    <title>@ViewData["Title"] | LifeHub</title>

    <script>
        (function () {
            try {
                var t = localStorage.getItem("lifehub_theme");

                if (!t && window.matchMedia &&
                    matchMedia("(prefers-color-scheme: dark)").matches) {
                    t = "dark";
                }

                document.documentElement.dataset.theme =
                    t === "dark" ? "dark" : "light";
            } catch (e) {
                document.documentElement.dataset.theme = "light";
            }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <partial name="_IconSprite" />
    <div class="app">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <a asp-controller="Dashboard"
               asp-action="Index"
               class="logo">
                <span class="logo-mark">L</span>
                LifeHub
            </a>

            @foreach (var g in groups)
            {
                <div class="menu-label">@g.Title</div>

                <nav class="menu" aria-label="@g.Title">

                @foreach (var item in g.Items)
                {
                    <!-- Tìm danh sách menu con của menu cha hiện tại. -->
                    var kids = children.TryGetValue(item[0], out var childList)
                        ? childList
                        : null;

                    var hasKids = kids != null;
                    var isSelf = active == item[0];

                    var isChildActive = hasKids &&
                        kids!.Any(x => x[0] == active);

                    var isOpen = isSelf || isChildActive;

                    if (hasKids)
                    {
                        <details class="menu-group" open="@(isOpen ? "open" : null)">
                            <summary class="menu-parent @(isOpen ? "is-open" : "")">
                                <!-- Bấm vào tên mục cha: vào thẳng trang Tổng quan -->
                                <a asp-controller="@item[2]"
                                   asp-action="Index"
                                   class="menu-parent-link">
                                    <span class="menu-sym"
                                          style="color:var(--pastel-@(item[3])-accent)"
                                          aria-hidden="true">
                                        @item[4]
                                    </span>

                                    <span class="menu-text">@item[1]</span>
                                </a>

                                <!-- Chỉ mũi tên mới đóng/mở menu con -->
                                <span class="menu-chevron" aria-hidden="true">›</span>
                            </summary>

                            <div class="submenu">
                                @foreach (var sub in kids!)
                                {
                                    var isSubActive = active == sub[0];

                                    var childController = sub[0] switch
                                    {
                                        "Transaction" => "Transaction",
                                        "Category" => "Category",
                                        "Wallet" => "Wallet",
                                        "SavingGoal" => "SavingGoal",
                                        "Semester" or "Course" or "Schedule" or "Assignment" or "Grade" or "StudyDocument" => "Study",
                                        _ => item[2]
                                    };

                                    var childAction = sub[0] switch
                                    {
                                        "GoalOverview" or "HabitOverview" => "Index",
                                        "GoalList" => "GoalList",
                                        "KeyResult" => "KeyResult",
                                        "GoalProgress" => "GoalProgress",
                                        "GoalReview" => "GoalReview",
                                        "HabitList" => "HabitList",
                                        "HabitTracking" => "HabitTracking",
                                        "HabitStreak" => "HabitStreak",
                                        "HabitStatistics" => "HabitStatistics",
                                        "Semester" => "Semesters",
                                        "Course" => "Courses",
                                        "Schedule" => "Schedule",
                                        "Assignment" => "Assignments",
                                        "Grade" => "Grades",
                                        "StudyDocument" => "Documents",
                                        _ => "Index"
                                    };


                                    <a asp-controller="@childController"
                                    asp-action="@childAction"
                                    class="submenu-link @(isSubActive ? "active" : "")"
                                    aria-current="@(isSubActive ? "page" : null)">

                                        <span class="submenu-dot"></span>
                                        <span>@sub[1]</span>
                                    </a>
                                }
                            </div>
                        </details>
                    }
                    else
                    {
                        <a asp-controller="@item[2]"
                        asp-action="Index"
                        class="submenu-link @(isSelf ? "active" : "")"
                        aria-current="@(isSelf ? "page" : null)">

                            <span class="menu-sym"
                                style="color:var(--pastel-@(item[3])-accent)"
                                aria-hidden="true">
                                @item[4]
                            </span>

                            <span class="menu-text">@item[1]</span>
                        </a>
                    }
                }


                </nav>
            }

            <div class="sidebar-spacer"></div>

            <div class="sidebar-foot">
                <a asp-controller="Notification"
                   asp-action="Index"
                   class="menu-link @(active == "Notification" ? "active" : "")"
                   aria-current="@(active == "Notification" ? "page" : null)">

                    <span class="menu-sym" aria-hidden="true"><svg class="lh-ico"><use href="#i-bell"></use></svg></span>
                    <span class="menu-text">Thông báo</span>
                    <span class="lh-badge lh-badge-inline" data-lh-unread hidden>0</span>
                </a>

                <a asp-controller="Settings"
                   asp-action="Index"
                   class="sidebar-bottom"
                   aria-current="@(active == "Settings" ? "page" : null)">

                    <span class="menu-sym" aria-hidden="true"><svg class="lh-ico"><use href="#i-settings"></use></svg></span>
                    Cài đặt

                </a>
            </div>

        </aside>

        <!-- MAIN CONTENT -->
        <div class="main">

            <header class="topbar"
                    data-url-recent="@Url.Action("Recent", "Notification")"
                    data-url-markread="@Url.Action("MarkRead", "Notification")"
                    data-url-markall="@Url.Action("MarkAllRead", "Notification")"
                    data-url-search="@Url.Action("Query", "Search")">

                <!-- Tìm kiếm toàn hệ thống: bấm hoặc nhấn Ctrl + K để mở bảng tìm kiếm -->
                <button type="button" class="lh-search-trigger" id="lhSearchOpen"
                        aria-haspopup="dialog" aria-label="Tìm kiếm trong LifeHub (Ctrl + K)">
                    <svg class="lh-ico"><use href="#i-search"></use></svg>
                    <span class="lh-search-text">Tìm kiếm trong LifeHub...</span>
                    <kbd class="lh-kbd">Ctrl + K</kbd>
                </button>

                <div class="topbar-right">

                    <!-- Token chống giả mạo cho các thao tác POST bằng JS (đánh dấu đã đọc) -->
                    <form id="lhTokenForm" hidden>@Html.AntiForgeryToken()</form>

                    <!-- Thông báo -->
                    <div class="lh-menu" data-lh-menu="notifications">
                        <button type="button" class="lh-icon-btn" id="lhNotifBtn"
                                aria-haspopup="true" aria-expanded="false" aria-label="Thông báo">
                            <svg class="lh-ico"><use href="#i-bell"></use></svg>
                            <span class="lh-badge" data-lh-unread hidden>0</span>
                        </button>

                        <div class="lh-pop lh-pop-notif" id="lhNotifPop" hidden>
                            <div class="lh-pop-head">
                                <h3><svg class="lh-ico"><use href="#i-bell"></use></svg> Thông báo</h3>
                                <button type="button" class="lh-link-btn" id="lhNotifReadAll">Đánh dấu đã đọc</button>
                            </div>
                            <div class="lh-notif-list" id="lhNotifList">
                                <p class="lh-pop-empty">Đang tải thông báo...</p>
                            </div>
                            <a asp-controller="Notification" asp-action="Index" class="lh-pop-foot">
                                Xem tất cả thông báo
                                <svg class="lh-ico"><use href="#i-chevron-right"></use></svg>
                            </a>
                        </div>
                    </div>

                    <!-- Chuyển giao diện sáng / tối (giữ id themeToggle cho lifehub.js) -->
                    <button type="button" class="lh-icon-btn" id="themeToggle"
                            aria-pressed="false" aria-label="Chuyển sang chế độ tối" title="Chế độ tối">
                        <svg class="lh-ico lh-ico-moon"><use href="#i-moon"></use></svg>
                        <svg class="lh-ico lh-ico-sun"><use href="#i-sun"></use></svg>
                    </button>

                    <span class="lh-divider" aria-hidden="true"></span>

                    <!-- Menu Avatar -->
                    <div class="lh-menu" data-lh-menu="user">
                        <button type="button" class="lh-avatar-btn" id="lhUserBtn"
                                aria-haspopup="true" aria-expanded="false"
                                aria-label="Menu tài khoản của @userName">
                            <span class="avatar">@initial</span>
                            <svg class="lh-ico lh-ico-sm"><use href="#i-chevron-down"></use></svg>
                        </button>

                        <div class="lh-pop lh-pop-user" id="lhUserPop" hidden>
                            <div class="lh-user-card">
                                <span class="avatar">@initial</span>
                                <div>
                                    <strong class="user-name">@userName</strong>
                                    <small>@userEmail</small>
                                </div>
                            </div>

                            <a asp-controller="Settings" asp-action="Profile" class="lh-pop-item">
                                <svg class="lh-ico"><use href="#i-user"></use></svg> Hồ sơ cá nhân
                            </a>
                            <a asp-controller="Settings" asp-action="Achievements" class="lh-pop-item">
                                <svg class="lh-ico"><use href="#i-trophy"></use></svg> Thành tựu của tôi
                            </a>
                            <a asp-controller="Settings" asp-action="Index" class="lh-pop-item">
                                <svg class="lh-ico"><use href="#i-settings"></use></svg> Cài đặt tài khoản
                            </a>

                            <div class="lh-pop-sep"></div>

                            <a asp-controller="Settings" asp-action="Help" class="lh-pop-item">
                                <svg class="lh-ico"><use href="#i-help"></use></svg> Trợ giúp &amp; Hỗ trợ
                            </a>
                            <a asp-controller="Settings" asp-action="ActivityLog" class="lh-pop-item">
                                <svg class="lh-ico"><use href="#i-activity"></use></svg> Nhật ký hoạt động
                            </a>

                            <div class="lh-pop-sep"></div>

                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit" class="lh-pop-item lh-danger">
                                    <svg class="lh-ico"><use href="#i-logout"></use></svg> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>

                </div>

            </header>

            <!-- Bảng tìm kiếm nổi (Ctrl + K) -->
            <div class="lh-search" id="lhSearch" role="dialog" aria-modal="true" aria-label="Tìm kiếm trong LifeHub" hidden>
                <div class="lh-search-box">
                    <div class="lh-search-input">
                        <svg class="lh-ico"><use href="#i-search"></use></svg>
                        <input type="search" id="lhSearchInput" placeholder="Tìm kiếm trong LifeHub..."
                               autocomplete="off" maxlength="80" aria-label="Từ khóa tìm kiếm" />
                        <button type="button" class="lh-icon-btn lh-icon-btn-sm" id="lhSearchClose" aria-label="Đóng">
                            <svg class="lh-ico"><use href="#i-x"></use></svg>
                        </button>
                    </div>
                    <div class="lh-search-body" id="lhSearchBody"></div>
                    <div class="lh-search-foot">
                        <span><kbd class="lh-kbd">↑</kbd> <kbd class="lh-kbd">↓</kbd> chọn</span>
                        <span><kbd class="lh-kbd">Enter</kbd> mở</span>
                        <span><kbd class="lh-kbd">Esc</kbd> đóng</span>
                    </div>
                </div>
            </div>

            <main class="page-content">
                @RenderBody()
            </main>

        </div>

    </div>

    <script src="~/js/lifehub.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
