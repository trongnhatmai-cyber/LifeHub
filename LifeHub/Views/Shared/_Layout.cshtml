
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - LifeHub</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/lifehub.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="app">

        <aside class="sidebar">

            <div class="logo">
                <span class="logo-mark">L</span>
                <span>LIFEHUB</span>
            </div>

            <div class="menu-label">KHÔNG GIAN CỦA BẠN</div>

            <nav class="menu">

                <a asp-controller="Home" asp-action="Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")">
                    Tổng quan
                </a>

                <a asp-controller="Study" asp-action="Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Study" ? "active" : "")">
                    Học tập
                </a>

                <a asp-controller="Project" asp-action="Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Project" ? "active" : "")">
                    Dự án
                </a>

                <a asp-controller="Work" asp-action="Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Work" ? "active" : "")">
                    Công việc
                </a>

                <a asp-controller="Time" asp-action="Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Time" ? "active" : "")">
                    Thời gian
                </a>

                <a asp-controller="Goals" asp-action="Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Goals" ? "active" : "")">
                    Mục tiêu & thói quen
                </a>

                <a asp-controller="Finance" asp-action="Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Finance" ? "active" : "")">
                    Tài chính
                </a>

                <a asp-controller="Knowledge" asp-action="Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "Knowledge" ? "active" : "")">
                    Kiến thức & tài liệu
                </a>

                <a asp-controller="AI" asp-action="Index"
                   class="@(ViewData["ActivePage"]?.ToString() == "AI" ? "active" : "")">
                    AI Assistant
                </a>

            </nav>

            <div class="sidebar-spacer"></div>

            <a asp-controller="Profile" asp-action="Index"
               class="sidebar-bottom">
                Hồ sơ & cài đặt
            </a>

        </aside>

        <main class="main">

            <header class="topbar">

                <h2>@ViewData["Title"]</h2>

                <div class="topbar-right">

                    <span class="topbar-date" id="currentDate"></span>

                    <button class="theme-button" id="themeToggle" type="button">
                        Sáng / Tối
                    </button>

                    <span class="user-name">Người dùng Demo</span>

                    <div class="avatar">N</div>

                </div>

            </header>

            <div class="page-content">
                @RenderBody()
            </div>

        </main>

    </div>

    <script src="~/js/lifehub.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
