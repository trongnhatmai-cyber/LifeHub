@{
    var errors = ViewData.ModelState.Values
        .SelectMany(value => value.Errors)
        .Select(error => string.IsNullOrWhiteSpace(error.ErrorMessage) ? "Dữ liệu nhập không hợp lệ." : error.ErrorMessage)
        .Distinct()
        .ToList();
    var errorMessage = TempData["ErrorMessage"] as string;
    var successMessage = TempData["SuccessMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(errorMessage) || errors.Count > 0)
{
    <div class="global-form-message error" role="alert" aria-live="assertive">
        <strong>Chưa thể lưu thông tin.</strong>
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <span>@errorMessage</span>
        }
        @if (errors.Count > 0)
        {
            <ul>
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        }
    </div>
}
else if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="global-form-message success" role="status" aria-live="polite">@successMessage</div>
}

<style>
    .global-form-message{margin:0 0 18px;padding:12px 16px;border:1px solid;border-radius:10px;font-size:14px;line-height:1.5}
    .global-form-message strong{display:block;margin-bottom:3px}
    .global-form-message.error{color:#9f1239;background:#fff1f2;border-color:#fecdd3}
    .global-form-message.success{color:#166534;background:#f0fdf4;border-color:#bbf7d0}
    .global-form-message ul{margin:5px 0 0;padding-left:20px}
</style>
