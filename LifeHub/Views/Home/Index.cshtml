@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "LifeHub – Mọi khía cạnh cuộc sống, kết nối trong một nền tảng";
    ViewData["LandingPage"] = "home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-intro.css" asp-append-version="true" />
}

<main class="lhi-page">

    <!-- =====================================================================
         SECTION 1 — HERO: GIỚI THIỆU LIFEHUB
         ===================================================================== -->
    <section class="lhi-hero" aria-labelledby="heroTitle">
        <div class="lhi-wrap">

            <div class="lhi-hero-copy">
                <span class="lhi-hero-badge">YOUR PERSONAL LIFE HUB</span>

                <h1 class="lhi-hero-title" id="heroTitle">
                    Mọi khía cạnh cuộc sống, kết nối trong một nền tảng.
                </h1>

                <p class="lhi-hero-desc">
                    LifeHub là nền tảng quản lý và phát triển cá nhân all-in-one, giúp tổ chức học tập, công việc, dự án, thời gian, tài chính, mục tiêu, thói quen và các hoạt động cá nhân.
                </p>

                <div class="lhi-actions">
                    <a class="lhi-btn lhi-btn-primary" asp-controller="Auth" asp-action="Register">
                        Bắt đầu ngay
                        <span aria-hidden="true">→</span>
                    </a>
                    <a class="lhi-btn" asp-controller="Home" asp-action="Features">
                        Khám phá tính năng
                    </a>
                </div>
            </div>

            <!-- Mockup minh họa giao diện Dashboard tổng quan LifeHub -->
            <div class="lhi-mockup-frame" role="img" aria-label="Minh họa giao diện Dashboard tổng quan của ứng dụng LifeHub">
                <div class="lhi-mockup-window">
                    <div class="lhi-mockup-bar">
                        <div class="lhi-mockup-dots" aria-hidden="true">
                            <span></span><span></span><span></span>
                        </div>
                        <span class="lhi-mockup-caption">Giao diện minh họa · Bảng điều khiển tổng quan LifeHub</span>
                        <span class="lhi-mockup-caption">Sáng / Tối</span>
                    </div>

                    <div class="lhi-mockup-body">
                        <aside class="lhi-mockup-side" aria-hidden="true">
                            <div class="lhi-mockup-brand">
                                <img src="~/images/lifehub-logo.png" alt="" class="lh-logo-light" asp-append-version="true" />
                                <img src="~/images/lifehub-logo-dark.png" alt="" class="lh-logo-dark" asp-append-version="true" />
                            </div>

                            <div class="lhi-mockup-nav-lbl">Tổng quan</div>
                            <div class="lhi-mockup-nav-item is-active"><i style="color:var(--p-study-acc)">◧</i> Tổng quan</div>

                            <div class="lhi-mockup-nav-lbl">Học tập &amp; công việc</div>
                            <div class="lhi-mockup-nav-item"><i style="color:var(--p-study-acc)">✎</i> Học tập</div>
                            <div class="lhi-mockup-nav-item"><i style="color:var(--p-task-acc)">☑</i> Công việc</div>
                            <div class="lhi-mockup-nav-item"><i style="color:var(--p-project-acc)">❖</i> Dự án</div>
                            <div class="lhi-mockup-nav-item"><i style="color:var(--p-time-acc)">◷</i> Thời gian</div>

                            <div class="lhi-mockup-nav-lbl">Quản lý cá nhân</div>
                            <div class="lhi-mockup-nav-item"><i style="color:var(--p-finance-acc)">₫</i> Tài chính</div>
                            <div class="lhi-mockup-nav-item"><i style="color:var(--p-goal-acc)">◎</i> Mục tiêu</div>
                            <div class="lhi-mockup-nav-item"><i style="color:var(--p-habit-acc)">↻</i> Thói quen</div>
                        </aside>

                        <div class="lhi-mockup-main" aria-hidden="true">
                            <div class="lhi-mockup-top">
                                <div>
                                    <small>MY LIFE SPACE · PERSONAL HUB</small>
                                    <strong>Chào ngày mới, Minh</strong>
                                </div>
                                <span class="lhi-mockup-pill">Bức tranh trong ngày</span>
                            </div>

                            <div class="lhi-mockup-kpis">
                                <div class="lhi-mk-kpi k-task">
                                    <span>CÔNG VIỆC</span>
                                    <b>Nhiệm vụ ưu tiên</b>
                                    <small>Theo dõi việc cần làm</small>
                                </div>
                                <div class="lhi-mk-kpi k-proj">
                                    <span>DỰ ÁN</span>
                                    <b>Không gian nhóm</b>
                                    <small>Cột mốc &amp; tiến độ</small>
                                </div>
                                <div class="lhi-mk-kpi k-study">
                                    <span>HỌC TẬP</span>
                                    <b>Môn học &amp; GPA</b>
                                    <small>Lịch học trong kỳ</small>
                                </div>
                                <div class="lhi-mk-kpi k-fin">
                                    <span>TÀI CHÍNH</span>
                                    <b>Ví &amp; ngân sách</b>
                                    <small>Kiểm soát thu chi</small>
                                </div>
                            </div>

                            <div class="lhi-mockup-panels">
                                <div class="lhi-mk-panel">
                                    <h3>Ưu tiên hôm nay</h3>
                                    <div class="lhi-mk-row"><span>Hoàn thiện bài tập môn học</span><em>Học tập</em></div>
                                    <div class="lhi-mk-row"><span>Rà soát tiến độ dự án nhóm</span><em>Dự án</em></div>
                                    <div class="lhi-mk-row"><span>Cập nhật kế hoạch tuần</span><em>Cá nhân</em></div>
                                </div>

                                <div class="lhi-mk-panel">
                                    <h3>Lịch trình sắp tới</h3>
                                    <div class="lhi-mk-row"><span>Lịch học buổi sáng</span><em>08:00</em></div>
                                    <div class="lhi-mk-row"><span>Họp trao đổi nhóm</span><em>14:00</em></div>
                                    <div class="lhi-mk-row"><span>Phiên tập trung Pomodoro</span><em>20:00</em></div>
                                </div>

                                <div class="lhi-mk-panel">
                                    <h3>Mục tiêu &amp; thói quen</h3>
                                    <div class="lhi-mk-row"><span>Đọc tài liệu chuyên môn</span><em>Hằng ngày</em></div>
                                    <div class="lhi-mk-row"><span>Rèn luyện ngoại ngữ</span><em>Đang theo dõi</em></div>
                                    <div class="lhi-mk-row"><span>Vận động buổi chiều</span><em>Hằng ngày</em></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>

    <!-- =====================================================================
         SECTION 2 — 10 PHÂN HỆ CỦA LIFEHUB
         ===================================================================== -->
    <section class="lhi-sec" id="lh-phan-he" aria-labelledby="modulesTitle">
        <div class="lhi-wrap">

            <div class="lhi-sec-head">
                <span class="lhi-eyebrow">10 PHÂN HỆ QUẢN LÝ</span>
                <h2 id="modulesTitle">Một không gian cho toàn bộ cuộc sống</h2>
                <p>
                    10 phân hệ được tổ chức trong cùng một hệ thống, giúp bạn quản lý nhiều khía cạnh cuộc sống một cách thống nhất.
                </p>
            </div>

            <div class="lhi-mod-grid">
                <article class="lhi-mod-card m-study">
                    <div class="lhi-mod-ic"><svg class="lh-i"><use href="#lh-book" /></svg></div>
                    <h3>Học tập</h3>
                    <p>Quản lý môn học, lịch học, bài tập và kết quả học tập.</p>
                    <a class="lhi-mod-link" asp-controller="Home" asp-action="Features" asp-fragment="lh-f-study">
                        Tìm hiểu thêm <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="lhi-mod-card m-task">
                    <div class="lhi-mod-ic"><svg class="lh-i"><use href="#lh-check" /></svg></div>
                    <h3>Công việc</h3>
                    <p>Tổ chức nhiệm vụ, deadline và mức độ ưu tiên.</p>
                    <a class="lhi-mod-link" asp-controller="Home" asp-action="Features" asp-fragment="lh-f-tasks">
                        Tìm hiểu thêm <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="lhi-mod-card m-project">
                    <div class="lhi-mod-ic"><svg class="lh-i"><use href="#lh-folder" /></svg></div>
                    <h3>Dự án</h3>
                    <p>Quản lý dự án, tiến độ, thành viên và các cột mốc.</p>
                    <a class="lhi-mod-link" asp-controller="Home" asp-action="Features" asp-fragment="lh-f-projects">
                        Tìm hiểu thêm <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="lhi-mod-card m-time">
                    <div class="lhi-mod-ic"><svg class="lh-i"><use href="#lh-cal" /></svg></div>
                    <h3>Thời gian</h3>
                    <p>Quản lý lịch trình, sự kiện và thời gian tập trung.</p>
                    <a class="lhi-mod-link" asp-controller="Home" asp-action="Features" asp-fragment="lh-f-time">
                        Tìm hiểu thêm <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="lhi-mod-card m-finance">
                    <div class="lhi-mod-ic"><svg class="lh-i"><use href="#lh-wallet" /></svg></div>
                    <h3>Tài chính</h3>
                    <p>Theo dõi ví tiền, thu chi, ngân sách và mục tiêu tiết kiệm.</p>
                    <a class="lhi-mod-link" asp-controller="Home" asp-action="Features" asp-fragment="lh-f-money">
                        Tìm hiểu thêm <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="lhi-mod-card m-goal">
                    <div class="lhi-mod-ic"><svg class="lh-i"><use href="#lh-target" /></svg></div>
                    <h3>Mục tiêu</h3>
                    <p>Xây dựng mục tiêu và theo dõi kết quả cần đạt.</p>
                    <a class="lhi-mod-link" asp-controller="Home" asp-action="Features" asp-fragment="lh-f-goals">
                        Tìm hiểu thêm <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="lhi-mod-card m-habit">
                    <div class="lhi-mod-ic"><svg class="lh-i"><use href="#lh-flame" /></svg></div>
                    <h3>Thói quen</h3>
                    <p>Theo dõi và duy trì các thói quen cá nhân.</p>
                    <a class="lhi-mod-link" asp-controller="Home" asp-action="Features" asp-fragment="lh-f-habits">
                        Tìm hiểu thêm <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="lhi-mod-card m-knowledge">
                    <div class="lhi-mod-ic"><svg class="lh-i"><use href="#lh-note" /></svg></div>
                    <h3>Kiến thức &amp; tài liệu</h3>
                    <p>Lưu trữ, tổ chức ghi chú và tài liệu.</p>
                    <a class="lhi-mod-link" asp-controller="Home" asp-action="Features" asp-fragment="lh-f-notes">
                        Tìm hiểu thêm <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="lhi-mod-card m-lifestyle">
                    <div class="lhi-mod-ic"><svg class="lh-i"><use href="#lh-moon" /></svg></div>
                    <h3>Sinh hoạt cá nhân</h3>
                    <p>Ghi nhận các hoạt động và xu hướng sinh hoạt.</p>
                    <a class="lhi-mod-link" asp-controller="Home" asp-action="Features" asp-fragment="lh-f-life">
                        Tìm hiểu thêm <span aria-hidden="true">→</span>
                    </a>
                </article>

                <article class="lhi-mod-card m-report">
                    <div class="lhi-mod-ic"><svg class="lh-i"><use href="#lh-chart" /></svg></div>
                    <h3>Thống kê &amp; báo cáo</h3>
                    <p>Tổng hợp dữ liệu và theo dõi tiến trình.</p>
                    <a class="lhi-mod-link" asp-controller="Home" asp-action="Features" asp-fragment="lh-f-ai">
                        Tìm hiểu thêm <span aria-hidden="true">→</span>
                    </a>
                </article>
            </div>

        </div>
    </section>

    <!-- =====================================================================
         SECTION 3 — TIỆN ÍCH DÙNG CHUNG
         ===================================================================== -->
    <section class="lhi-sec lhi-sec-alt" aria-labelledby="utilitiesTitle">
        <div class="lhi-wrap">

            <div class="lhi-sec-head">
                <span class="lhi-eyebrow">TIỆN ÍCH HỆ THỐNG</span>
                <h2 id="utilitiesTitle">Không chỉ có các phân hệ</h2>
                <p>
                    Những tiện ích chung giúp bạn thao tác thuận tiện và kết nối trải nghiệm trên toàn hệ thống.
                </p>
            </div>

            <div class="lhi-util-grid">
                <article class="lhi-util-card">
                    <div class="lhi-util-top">
                        <div class="lhi-util-ic"><svg class="lh-i"><use href="#lh-grid" /></svg></div>
                    </div>
                    <h3>Dashboard tổng quan</h3>
                    <p>Tập hợp những thông tin quan trọng từ các phân hệ về chung một trang mở đầu.</p>
                </article>

                <article class="lhi-util-card">
                    <div class="lhi-util-top">
                        <div class="lhi-util-ic"><svg class="lh-i"><use href="#lh-bell" /></svg></div>
                    </div>
                    <h3>Thông báo</h3>
                    <p>Cập nhật các hoạt động dự án, lời mời tham gia và những thông tin cần chú ý.</p>
                </article>

                <article class="lhi-util-card">
                    <div class="lhi-util-top">
                        <div class="lhi-util-ic"><svg class="lh-i"><use href="#lh-sun" /></svg></div>
                    </div>
                    <h3>Giao diện sáng/tối</h3>
                    <p>Thay đổi chế độ hiển thị sáng hoặc tối linh hoạt theo sở thích sử dụng.</p>
                </article>

                <article class="lhi-util-card">
                    <div class="lhi-util-top">
                        <div class="lhi-util-ic"><svg class="lh-i"><use href="#lh-share" /></svg></div>
                    </div>
                    <h3>Chia sẻ và cộng tác</h3>
                    <p>Mời thành viên tham gia dự án, phân quyền vai trò và trao đổi trên từng nhiệm vụ.</p>
                </article>

                <article class="lhi-util-card">
                    <div class="lhi-util-top">
                        <div class="lhi-util-ic"><svg class="lh-i"><use href="#lh-cal" /></svg></div>
                        <span class="lhi-badge-soon">Sắp có</span>
                    </div>
                    <h3>Lịch tổng hợp</h3>
                    <p>Hướng tới quan sát đồng nhất lịch học, công việc và sự kiện cá nhân trên một lịch.</p>
                </article>

                <article class="lhi-util-card">
                    <div class="lhi-util-top">
                        <div class="lhi-util-ic"><svg class="lh-i"><use href="#lh-search" /></svg></div>
                        <span class="lhi-badge-soon">Sắp có</span>
                    </div>
                    <h3>Tìm kiếm toàn hệ thống</h3>
                    <p>Hỗ trợ tra cứu nhanh công việc, môn học, dự án và tài liệu từ một ô tìm kiếm chung.</p>
                </article>

                <article class="lhi-util-card">
                    <div class="lhi-util-top">
                        <div class="lhi-util-ic"><svg class="lh-i"><use href="#lh-bell" /></svg></div>
                        <span class="lhi-badge-soon">Sắp có</span>
                    </div>
                    <h3>Nhắc nhở</h3>
                    <p>Hỗ trợ ghi nhớ lịch trình, hạn hoàn thành và các cột mốc quan trọng đúng thời điểm.</p>
                </article>

                <article class="lhi-util-card">
                    <div class="lhi-util-top">
                        <div class="lhi-util-ic"><svg class="lh-i"><use href="#lh-award" /></svg></div>
                        <span class="lhi-badge-soon">Sắp có</span>
                    </div>
                    <h3>Huy hiệu và điểm thưởng</h3>
                    <p>Ghi nhận nỗ lực duy trì chuỗi thói quen và hoàn thành các cột mốc cá nhân.</p>
                </article>

                <article class="lhi-util-card">
                    <div class="lhi-util-top">
                        <div class="lhi-util-ic"><svg class="lh-i"><use href="#lh-download" /></svg></div>
                        <span class="lhi-badge-soon">Sắp có</span>
                    </div>
                    <h3>Xuất dữ liệu/báo cáo</h3>
                    <p>Hỗ trợ trích xuất báo cáo tổng hợp để lưu trữ hoặc chia sẻ khi cần thiết.</p>
                </article>

                <article class="lhi-util-card">
                    <div class="lhi-util-top">
                        <div class="lhi-util-ic">
                            <svg class="lh-i" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 3l2.2 5.8L20 11l-5.8 2.2L12 19l-2.2-5.8L4 11l5.8-2.2z" />
                            </svg>
                        </div>
                        <span class="lhi-badge-soon">Sắp có</span>
                    </div>
                    <h3>Trợ lý AI</h3>
                    <p>Hỗ trợ hội thoại tra cứu dữ liệu cá nhân và gợi ý sắp xếp kế hoạch mỗi ngày.</p>
                </article>
            </div>

        </div>
    </section>

    <!-- =====================================================================
         SECTION 4 — CÀI ĐẶT VÀ CÁ NHÂN HÓA
         ===================================================================== -->
    <section class="lhi-sec" aria-labelledby="personalizeTitle">
        <div class="lhi-wrap">

            <div class="lhi-pref-split">
                <div class="lhi-pref-copy">
                    <span class="lhi-eyebrow">CÁ NHÂN HÓA TRẢI NGHIỆM</span>
                    <h2 id="personalizeTitle">Không gian của riêng bạn</h2>
                    <p>
                        Tùy chỉnh LifeHub để phù hợp với cách bạn quản lý và tổ chức cuộc sống, kết hợp giữa các tùy chọn sẵn có và trung tâm cài đặt đang tiếp tục hoàn thiện.
                    </p>

                    <ul class="lhi-pref-list">
                        <li class="lhi-pref-item">
                            <div class="lhi-pref-ic"><svg class="lh-i"><use href="#lh-sun" /></svg></div>
                            <div>
                                <div class="lhi-pref-title">
                                    Giao diện sáng/tối
                                    <span class="lhi-badge-ready">Đã sẵn sàng</span>
                                </div>
                                <p>Chuyển đổi trực tiếp trên thanh công cụ ứng dụng và ghi nhớ chế độ hiển thị yêu thích trên trình duyệt.</p>
                            </div>
                        </li>

                        <li class="lhi-pref-item">
                            <div class="lhi-pref-ic"><svg class="lh-i"><use href="#lh-shield" /></svg></div>
                            <div>
                                <div class="lhi-pref-title">
                                    Bảo mật tài khoản
                                    <span class="lhi-badge-ready">Đã sẵn sàng</span>
                                </div>
                                <p>Đăng nhập xác thực mật khẩu mã hóa, tùy chọn ghi nhớ phiên làm việc và bảo vệ quyền riêng tư theo tài khoản.</p>
                            </div>
                        </li>

                        <li class="lhi-pref-item">
                            <div class="lhi-pref-ic"><svg class="lh-i"><use href="#lh-user" /></svg></div>
                            <div>
                                <div class="lhi-pref-title">
                                    Thông tin tài khoản &amp; hồ sơ cá nhân
                                    <span class="lhi-badge-soon">Sắp có</span>
                                </div>
                                <p>Định hướng quản lý tập trung thông tin cá nhân, số điện thoại liên hệ và cập nhật mật khẩu.</p>
                            </div>
                        </li>

                        <li class="lhi-pref-item">
                            <div class="lhi-pref-ic"><svg class="lh-i"><use href="#lh-bell" /></svg></div>
                            <div>
                                <div class="lhi-pref-title">
                                    Tùy chọn thông báo, nhắc nhở &amp; trải nghiệm
                                    <span class="lhi-badge-soon">Sắp có</span>
                                </div>
                                <p>Định hướng tùy chỉnh kênh nhận thông báo, thời lượng chu kỳ Pomodoro và ẩn/hiện phân hệ theo nhu cầu.</p>
                            </div>
                        </li>
                    </ul>
                </div>

                <!-- Mockup minh họa không gian tùy chỉnh -->
                <div class="lhi-settings-mock" role="img" aria-label="Minh họa không gian cài đặt và cá nhân hóa trong LifeHub">
                    <div class="lhi-sm-window" aria-hidden="true">
                        <div class="lhi-sm-head">
                            <div>
                                <strong>Tùy chỉnh không gian cá nhân</strong>
                                <span>Minh họa giao diện cài đặt &amp; định hướng cá nhân hóa</span>
                            </div>
                            <span class="lhi-badge-soon">Đang phát triển</span>
                        </div>

                        <div class="lhi-sm-group">
