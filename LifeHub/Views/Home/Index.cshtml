var d=document;
d.querySelectorAll('.lh-split').forEach(function(s){s.querySelectorAll('.lh-copy>*').forEach(function(e,i){e.classList.add('lh-rv');if(e.tagName!=='H2')e.classList.add('lh-r');e.style.setProperty('--lh-d',i*.1+'s')});s.querySelector('.lh-vis').classList.add('lh-rv','lh-l')});
d.querySelectorAll('.lh-head,.lh-who span,.lh-mod,.lh-step,.lh-end').forEach(function(e,i){e.classList.add('lh-rv');e.style.setProperty('--lh-d',(i%5)*.08+'s')});
var h=d.querySelector('.lh-hero h1');
if(h){h.innerHTML=h.textContent.split(' ').map(function(w,i){return '<span class="lh-w" style="--lh-i:'+i+'">'+w+'</span>'}).join(' ')}
var pg=d.createElement('div');pg.className='lh-prog';d.body.appendChild(pg);
addEventListener('scroll',function(){var m=d.documentElement.scrollHeight-innerHeight;pg.style.transform='scaleX('+(m>0?scrollY/m:0)+')'},{passive:true});
var app=d.querySelector('.lh-app'),hero=d.querySelector('.lh-hero');
if(app&&hero&&!matchMedia('(prefers-reduced-motion:reduce)').matches){
hero.addEventListener('mousemove',function(e){var r=app.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;app.style.transform='perspective(1400px) rotateY('+x*6+'deg) rotateX('+(-y*5)+'deg)'});
hero.addEventListener('mouseleave',function(){app.style.transform=''})}
var els=d.querySelectorAll('.lh-rv');
if(!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('lh-in')});return}
var o=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('lh-in');o.unobserve(x.target)}})},{threshold:.15});
els.forEach(function(e){o.observe(e)});
})();
</script>
</body>
</html>