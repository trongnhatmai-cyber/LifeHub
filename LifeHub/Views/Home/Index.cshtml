@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "LifeHub – Make space for everything that matters";
    ViewData["LandingPage"] = "home";
    var signedIn = User.Identity?.IsAuthenticated == true;

    // Danh sách phân hệ dùng cho sidebar minh họa
    var mods = new (string Key, string Name, string Icon)[] {
        ("study", "Học tập", "lh-book"), ("task", "Công việc", "lh-check"), ("project", "Dự án", "lh-folder"),
        ("time", "Thời gian", "lh-cal"), ("finance", "Tài chính", "lh-wallet"), ("goal", "Mục tiêu", "lh-target"),
        ("habit", "Thói quen", "lh-flame"), ("knowledge", "Kiến thức", "lh-note"), ("life", "Sinh hoạt", "lh-heart"),
        ("report", "Báo cáo", "lh-chart")
    };
}

<main>
    <!-- 1. HERO -->
    <section class="hero" aria-labelledby="heroTitle">
        <div class="lp-wrap">
            <span class="lp-kicker">Không gian quản lý cuộc sống cá nhân</span>
            <h1 id="heroTitle"><span class="ln">Make space for</span> <span class="ln">everything that matters.</span></h1>
            <p class="lp-lead">LifeHub kết nối học tập, công việc, dự án và cuộc sống cá nhân trong một không gian thống nhất — để bạn dễ dàng sắp xếp, theo dõi và tiến về phía trước.</p>
            <div class="hero-cta">
                @if (signedIn)
                {
                    <a class="lp-btn lp-btn-primary lp-btn-lg" asp-controller="Dashboard" asp-action="Index">Vào ứng dụng</a>
                }
                else
                {
                    <a class="lp-btn lp-btn-primary lp-btn-lg" asp-controller="Auth" asp-action="Register">Bắt đầu miễn phí</a>
                }
                <a class="lp-btn lp-btn-lg" asp-controller="Home" asp-action="HowItWorks">Khám phá cách hoạt động</a>
            </div>
            <p class="hero-line">Một không gian · Nhiều lĩnh vực · Một tầm nhìn tổng thể</p>
        </div>

        <div class="lp-wrap hero-stage" aria-hidden="true">
            <div class="mk">
                <div class="mk-bar"><i></i><i></i><i></i><b>LifeHub · Tổng quan</b></div>
                <div class="mk-app">
                    <div class="mk-side">
                        <div class="mk-brand"><i>L</i>LifeHub</div>
                        <div class="mk-nav is-on"><svg class="ic"><use href="#lh-grid" /></svg>Tổng quan</div>
                        @foreach (var m in mods)
                        {
                            <div class="mk-nav"><svg class="ic"><use href="#@m.Icon" /></svg>@m.Name</div>
                        }
                    </div>
                    <div class="mk-main">
                        <div class="mk-hi"><div><h4>Chào buổi sáng, Minh Anh 👋</h4><small>Hôm nay bạn có vài việc cần chú ý</small></div><span class="mk-tag">Hôm nay</span></div>
                        <div class="mk-stats">
                            <div class="mk-stat"><small>Việc hôm nay</small><b>05</b></div>
                            <div class="mk-stat"><small>Sự kiện</small><b>03</b></div>
                            <div class="mk-stat"><small>Thói quen còn lại</small><b>02</b></div>
                            <div class="mk-stat"><small>Sắp đến hạn</small><b>04</b></div>
                        </div>
                        <div class="mk-grid">
                            <div class="mk-card"><h5>Việc ưu tiên hôm nay</h5>
                                <div class="mk-row"><span class="mk-cb on"></span><span>Nộp báo cáo môn Cơ sở dữ liệu</span><em class="mk-tag" style="--c:#DC2626">Cao</em></div>
                                <div class="mk-row"><span class="mk-cb"></span><span>Họp nhóm đồ án</span><em class="mk-tag" style="--c:#D97706">Vừa</em></div>
                                <div class="mk-row"><span class="mk-cb"></span><span>Ôn tập chương 4</span><em class="mk-tag">Thấp</em></div>
                                <div class="mk-row"><span class="mk-cb"></span><span>Ghi chi tiêu trong ngày</span><em class="mk-tag">Thấp</em></div>
                            </div>
                            <div class="mk-card"><h5>Lịch trình sắp tới</h5>
                                <div class="mk-row"><i class="mk-dot"></i><span>Lớp Lập trình web</span><time>09:00</time></div>
                                <div class="mk-row"><i class="mk-dot" style="--c:#7C3AED"></i><span>Họp nhóm</span><time>14:00</time></div>
                                <div class="mk-row"><i class="mk-dot" style="--c:#0D9488"></i><span>Tập thể dục</span><time>18:00</time></div>
                            </div>
                            <div class="mk-card"><h5>Tuần này của bạn</h5>
                                <div class="mk-bars"><i style="--h:40%"></i><i style="--h:65%"></i><i style="--h:50%"></i><i class="on" style="--h:85%"></i><i style="--h:30%"></i><i style="--h:20%"></i><i style="--h:45%"></i></div>
                                <div class="mk-axis"><span>T2</span><span>T3</span><span>T4</span><span>T5</span><span>T6</span><span>T7</span><span>CN</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. PRODUCT PREVIEW -->
    <section class="lp-sec" aria-labelledby="pvTitle">
        <div class="lp-wrap pv">
            <div class="rv">
                <span class="lp-kicker">Trang tổng quan</span>
                <h2 id="pvTitle">A clearer view of your day.</h2>
                <p class="lp-lead" style="margin-top:16px">Tất cả những điều cần quan tâm được đưa về một trang tổng quan, giúp bạn nhanh chóng nhận ra việc cần làm và tiến độ hiện tại.</p>
                <ul class="pv-list">
                    <li><svg class="ic"><use href="#lh-check" /></svg><span>Việc cần ưu tiên và các deadline sắp đến hạn.</span></li>
                    <li><svg class="ic"><use href="#lh-cal" /></svg><span>Lịch trình trong ngày, gom từ lịch học và sự kiện cá nhân.</span></li>
                    <li><svg class="ic"><use href="#lh-target" /></svg><span>Tóm tắt dự án, mục tiêu và thói quen đang theo dõi.</span></li>
                    <li><svg class="ic"><use href="#lh-chart" /></svg><span>Biểu đồ tiến độ của cả tuần trong một cái nhìn.</span></li>
                </ul>
            </div>
            <div class="pv-stack rv" style="--d:.1s" aria-hidden="true">
                <div class="mk-card pv-a"><h5>Dự án đang chạy</h5>
                    <div class="mk-row"><span>Đồ án tốt nghiệp</span><b style="color:var(--lp-h)">72%</b></div>
                    <div class="mk-meter"><i style="--w:72%"></i></div>
                    <div class="mk-row" style="margin-top:10px"><span>Website CLB</span><b style="color:var(--lp-h)">40%</b></div>
                    <div class="mk-meter"><i style="--w:40%;--c:#0D9488"></i></div>
                </div>
                <div class="mk-card pv-b"><h5>Lịch hôm nay</h5>
                    <div class="mk-row"><i class="mk-dot"></i><span>Lớp Lập trình web</span><time>09:00</time></div>
                    <div class="mk-row"><i class="mk-dot" style="--c:#7C3AED"></i><span>Họp nhóm</span><time>14:00</time></div>
                    <div class="mk-row"><i class="mk-dot" style="--c:#DC2626"></i><span>Hạn nộp bài tập</span><time>23:59</time></div>
                </div>
                <div class="mk-card pv-c"><h5>Tuần này của bạn</h5>
                    <div class="mk-bars" style="height:74px"><i style="--h:40%"></i><i style="--h:65%"></i><i style="--h:50%"></i><i class="on" style="--h:90%"></i><i style="--h:35%"></i><i style="--h:25%"></i><i style="--h:50%"></i></div>
                    <div class="mk-axis"><span>T2</span><span>T3</span><span>T4</span><span>T5</span><span>T6</span><span>T7</span><span>CN</span></div>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. PROBLEM & SOLUTION -->
    <section class="lp-sec lp-sec-soft" aria-labelledby="psTitle">
        <div class="lp-wrap">
            <div class="lp-head is-center rv">
                <h2 id="psTitle">Less scattered. More in control.</h2>
                <p class="lp-lead">Khi mọi thứ nằm ở nhiều nơi, bạn phải nhớ thay cho công cụ. LifeHub gom chúng về một chỗ để bạn nhìn thấy toàn cảnh.</p>
            </div>
            <div class="ps rv">
                <div class="ps-col">
                    <h3>Khi dùng nhiều công cụ rời rạc</h3>
                    <div class="ps-item">Lịch học và deadline nằm riêng</div>
                    <div class="ps-item">Việc cá nhân và việc dự án khó theo dõi cùng nhau</div>
                    <div class="ps-item">Ghi chú khó tìm lại</div>
                    <div class="ps-item">Mục tiêu khó theo dõi lâu dài</div>
                </div>
                <div class="ps-mid" aria-hidden="true">
                    <span class="ps-mid-h"></span>
                    @for (var i = 0; i < 4; i++) { <span><svg class="ic"><use href="#lh-arrow" /></svg></span> }
                </div>
                <div class="ps-col is-after">
                    <h3>Khi quản lý trong LifeHub</h3>
                    <div class="ps-item"><svg class="ic"><use href="#lh-check" /></svg>Lịch được tổ chức trong một nơi</div>
                    <div class="ps-item"><svg class="ic"><use href="#lh-check" /></svg>Có thể nhìn tổng quan công việc</div>
                    <div class="ps-item"><svg class="ic"><use href="#lh-check" /></svg>Kiến thức và tài liệu được phân loại</div>
                    <div class="ps-item"><svg class="ic"><use href="#lh-check" /></svg>Có tiến độ và phần đánh giá</div>
                </div>
            </div>
        </div>
    </section>

    <!-- 4. CONNECTED WORKSPACE -->
    <section class="lp-sec" aria-labelledby="cwTitle">
        <div class="lp-wrap">
            <div class="lp-head is-center rv">
                <h2 id="cwTitle">Everything you manage, connected in one workspace.</h2>
                <p class="lp-lead">10 phân hệ cùng nằm trong một hệ thống. Bạn chỉ dùng những phần cần thiết, phần còn lại luôn sẵn sàng khi cần.</p>
            </div>
            <div class="cw-top">
                <article class="cw-big rv" style="--c:#2563EB">
                    <span class="cw-ico"><svg class="ic"><use href="#lh-book" /></svg></span>
                    <h3>Học tập</h3>
                    <p>Môn học, thời khóa biểu, bài tập, lịch thi và điểm số trong từng học kỳ.</p>
                    <div class="mk-tags"><span class="mk-tag">Thời khóa biểu</span><span class="mk-tag">Bài tập</span><span class="mk-tag">Điểm số</span></div>
                </article>
                <article class="cw-big rv" style="--c:#0D9488;--d:.08s">
                    <span class="cw-ico"><svg class="ic"><use href="#lh-check" /></svg></span>
                    <h3>Công việc</h3>
                    <p>Việc cần làm, deadline và mức ưu tiên — chia nhỏ thành việc con và checklist.</p>
                    <div class="mk-tags"><span class="mk-tag">Deadline</span><span class="mk-tag">Ưu tiên</span><span class="mk-tag">Checklist</span></div>
                </article>
                <article class="cw-big rv" style="--c:#7C3AED;--d:.16s">
                    <span class="cw-ico"><svg class="ic"><use href="#lh-folder" /></svg></span>
                    <h3>Dự án</h3>
                    <p>Thành viên, phân công và tiến độ của các dự án làm việc nhóm.</p>
                    <div class="mk-tags"><span class="mk-tag">Kanban</span><span class="mk-tag">Phân công</span><span class="mk-tag">Tiến độ</span></div>
                </article>
            </div>
            <div class="cw-rest rv">
                <div class="cw-item" style="--c:#D97706"><span class="cw-ico"><svg class="ic"><use href="#lh-cal" /></svg></span><div><h3>Thời gian</h3><p>Lịch chung, nhắc nhở và Pomodoro.</p></div></div>
                <div class="cw-item" style="--c:#16A34A"><span class="cw-ico"><svg class="ic"><use href="#lh-wallet" /></svg></span><div><h3>Tài chính</h3><p>Ví, thu chi và ngân sách.</p></div></div>
                <div class="cw-item" style="--c:#DC2626"><span class="cw-ico"><svg class="ic"><use href="#lh-target" /></svg></span><div><h3>Mục tiêu</h3><p>Kết quả chính và tiến độ.</p></div></div>
                <div class="cw-item" style="--c:#EA580C"><span class="cw-ico"><svg class="ic"><use href="#lh-flame" /></svg></span><div><h3>Thói quen</h3><p>Theo dõi và duy trì thói quen.</p></div></div>
                <div class="cw-item" style="--c:#2563EB"><span class="cw-ico"><svg class="ic"><use href="#lh-note" /></svg></span><div><h3>Kiến thức &amp; tài liệu</h3><p>Ghi chú, thư mục, tài liệu.</p></div></div>
                <div class="cw-item" style="--c:#DB2777"><span class="cw-ico"><svg class="ic"><use href="#lh-heart" /></svg></span><div><h3>Sinh hoạt cá nhân</h3><p>Giấc ngủ, vận động, tâm trạng.</p></div></div>
                <div class="cw-item" style="--c:#0891B2"><span class="cw-ico"><svg class="ic"><use href="#lh-chart" /></svg></span><div><h3>Thống kê &amp; báo cáo</h3><p>Nhìn lại dữ liệu và xu hướng từ các lĩnh vực khác nhau.</p></div></div>
            </div>
            <div class="cw-more"><a class="lp-textlink" asp-controller="Home" asp-action="Features">Khám phá tất cả tính năng <svg class="ic"><use href="#lh-arrow" /></svg></a></div>
        </div>
    </section>

    <!-- 4B. BUILT FOR DIFFERENT RHYTHMS (PERSONAS) -->
    <section class="lp-sec lp-sec-soft" aria-labelledby="perTitle">
        <div class="lp-wrap">
            <div class="lp-head is-center rv">
                <span class="lp-kicker">Phù hợp nhiều nhu cầu</span>
                <h2 id="perTitle">Designed for how you actually live and work.</h2>
                <p class="lp-lead">Dù bạn đang quản lý kỳ học bận rộn, cân bằng công việc văn phòng hay điều phối một nhóm nhỏ, LifeHub đều có sẵn cấu trúc phù hợp.</p>
            </div>
            <div class="per-grid">
                <article class="per-card rv" style="--c:#2563EB">
                    <span class="cw-ico" style="--c:#2563EB"><svg class="ic"><use href="#lh-book" /></svg></span>
                    <h3>Sinh viên &amp; Học tập</h3>
                    <p>Gom thời khóa biểu, bài tập, lịch thi và điểm số theo từng học kỳ để không bỏ sót deadline.</p>
                    <ul class="lp-ticks">
                        <li>Theo dõi tiến độ từng môn học và học kỳ.</li>
                        <li>Ghi nhận phiên Pomodoro khi ôn thi.</li>
                        <li>Lưu trữ ghi chú môn học theo thư mục.</li>
                    </ul>
                    <div class="per-tags">
                        <span class="mk-tag">Học tập</span>
                        <span class="mk-tag">Thời gian</span>
                        <span class="mk-tag">Kiến thức</span>
                    </div>
                </article>
                <article class="per-card rv" style="--c:#0D9488;--d:.08s">
                    <span class="cw-ico" style="--c:#0D9488"><svg class="ic"><use href="#lh-target" /></svg></span>
                    <h3>Người đi làm &amp; Cá nhân</h3>
                    <p>Giữ nhịp công việc hằng ngày, kiểm soát chi tiêu và duy trì thói quen sinh hoạt đều đặn.</p>
                    <ul class="lp-ticks">
                        <li>Sắp xếp việc ưu tiên và mục tiêu theo quý.</li>
                        <li>Theo dõi thu chi, nhiều ví và ngân sách tháng.</li>
                        <li>Ghi nhận giấc ngủ, vận động và tâm trạng.</li>
                    </ul>
                    <div class="per-tags">
                        <span class="mk-tag" style="--c:#0D9488">Công việc</span>
                        <span class="mk-tag" style="--c:#16A34A">Tài chính</span>
                        <span class="mk-tag" style="--c:#DB2777">Sinh hoạt</span>
                    </div>
                </article>
                <article class="per-card rv" style="--c:#7C3AED;--d:.16s">
                    <span class="cw-ico" style="--c:#7C3AED"><svg class="ic"><use href="#lh-kanban" /></svg></span>
                    <h3>Nhóm dự án &amp; Đồ án</h3>
                    <p>Phối hợp rõ ràng trên cùng một bảng Kanban, phân công thành viên và theo dõi cột mốc.</p>
                    <ul class="lp-ticks">
                        <li>Phân quyền Quản lý, Thành viên và Người xem.</li>
                        <li>Chia sẻ tài liệu, ghi chú theo quyền xem/sửa.</li>
                        <li>Xem nhật ký hoạt động và báo cáo tiến độ.</li>
                    </ul>
                    <div class="per-tags">
                        <span class="mk-tag" style="--c:#7C3AED">Dự án</span>
                        <span class="mk-tag">Chia sẻ</span>
                        <span class="mk-tag" style="--c:#0891B2">Báo cáo</span>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- 5. ONE SYSTEM, MANY CONNECTIONS (khu vực nền tối duy nhất của trang) -->
    <section class="lp-sec lp-sec-dark" aria-labelledby="cnTitle">
        <div class="lp-wrap">
            <div class="lp-head rv">
                <h2 id="cnTitle">Your information works better together.</h2>
                <p class="lp-lead" style="color:#94a3b8">Dữ liệu ở một phân hệ không nằm yên một chỗ. Chúng được nối với nhau để bạn không phải nhập lại và luôn nhìn thấy bức tranh đầy đủ.</p>
            </div>
            <div class="cn">
                <div class="cn-row rv">
                    <div><h3>Học tập</h3><small>Bài tập có hạn được đưa vào lịch.</small></div>
                    <div class="cn-chain">
                        <span class="cn-node"><svg class="ic"><use href="#lh-book" /></svg>Bài tập &amp; deadline</span><span class="cn-link"><em>hiện trên</em></span>
                        <span class="cn-node"><svg class="ic"><use href="#lh-cal" /></svg>Lịch chung</span><span class="cn-link"><em>kèm</em></span>
                        <span class="cn-node is-end"><svg class="ic"><use href="#lh-bell" /></svg>Nhắc nhở</span>
                    </div>
                </div>
                <div class="cn-row rv" style="--d:.06s">
                    <div><h3>Công việc</h3><small>Một việc có thể gắn với nhiều đối tượng.</small></div>
                    <div class="cn-chain">
                        <span class="cn-node"><svg class="ic"><use href="#lh-check" /></svg>Công việc</span><span class="cn-link"><em>thuộc về</em></span>
                        <div class="cn-node-multi"><span class="cn-node is-end">Môn học</span><span class="cn-node is-end">Dự án</span><span class="cn-node is-end">Mục tiêu</span></div>
                    </div>
                </div>
                <div class="cn-row rv" style="--d:.12s">
                    <div><h3>Tập trung</h3><small>Mỗi phiên Pomodoro gắn với việc đang làm.</small></div>
                    <div class="cn-chain">
                        <span class="cn-node"><svg class="ic"><use href="#lh-timer" /></svg>Phiên Pomodoro</span><span class="cn-link"><em>gắn với</em></span>
                        <span class="cn-node"><svg class="ic"><use href="#lh-check" /></svg>Công việc</span><span class="cn-link"><em>tính vào</em></span>
                        <span class="cn-node is-end"><svg class="ic"><use href="#lh-clock" /></svg>Thời gian tập trung</span>
                    </div>
                </div>
                <div class="cn-row rv" style="--d:.18s">
                    <div><h3>Tài chính</h3><small>Giao dịch cập nhật dữ liệu tài chính liên quan.</small></div>
                    <div class="cn-chain">
                        <span class="cn-node"><svg class="ic"><use href="#lh-wallet" /></svg>Giao dịch</span><span class="cn-link"><em>ghi vào</em></span>
                        <span class="cn-node"><svg class="ic"><use href="#lh-folder" /></svg>Ví / Danh mục</span><span class="cn-link"><em>so với</em></span>
                        <span class="cn-node is-end"><svg class="ic"><use href="#lh-chart" /></svg>Ngân sách</span>
                    </div>
                </div>
            </div>
            <div class="cw-more" style="text-align:left"><a class="lp-textlink" style="color:#93c5fd" asp-controller="Home" asp-action="HowItWorks">Xem cách dữ liệu được liên kết <svg class="ic"><use href="#lh-arrow" /></svg></a></div>
        </div>
    </section>

    <!-- 6. BUILT AROUND YOUR LIFE -->
    <section class="lp-sec lp-sec-tint" aria-labelledby="pzTitle">
        <div class="lp-wrap pz">
            <div class="rv">
                <span class="lp-kicker">Cá nhân hóa</span>
                <h2 id="pzTitle">Make LifeHub work your way.</h2>
                <ul class="lp-ticks">
                    <li>Chỉ hiển thị những phân hệ bạn thường dùng.</li>
                    <li>Tùy chỉnh cách tổ chức dữ liệu của riêng bạn.</li>
                    <li>Chọn giao diện sáng hoặc tối.</li>
                    <li>Theo dõi những thông tin quan trọng ngay trên Dashboard.</li>
                </ul>
            </div>
            <div class="pz-demo rv" style="--d:.1s">
                <div class="pz-panel">
                    <h4>Phân hệ hiển thị</h4>
                    <p>Thử bật hoặc tắt để xem thanh bên thay đổi.</p>
                    @foreach (var m in mods.Take(7))
                    {
                        <label class="pz-opt"><span>@m.Name</span>
                            <input type="checkbox" data-mod="@m.Key" checked /><span class="pz-sw" aria-hidden="true"></span></label>
                    }
                </div>
                <div class="pz-view">
                    <div class="mk-side" aria-hidden="true">
                        @foreach (var m in mods.Take(7))
                        {
                            <div class="mk-nav @(m.Key == "task" ? "is-on" : "")" data-mod="@m.Key"><svg class="ic"><use href="#@m.Icon" /></svg>@m.Name</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 7. DESIGNED FOR EVERYDAY USE -->
    <section class="lp-sec" aria-labelledby="edTitle">
        <div class="lp-wrap ed">
            <div class="rv">
                <h2 id="edTitle" style="margin-bottom:36px">A workspace that fits your routine.</h2>
                <div class="ed-pts">
                    <div class="ed-pt"><span class="cw-ico"><svg class="ic"><use href="#lh-grid" /></svg></span><div><h3>Easy to navigate</h3><p>Điều hướng rõ ràng, các chức năng được nhóm hợp lý theo từng lĩnh vực.</p></div></div>
                    <div class="ed-pt"><span class="cw-ico"><svg class="ic"><use href="#lh-bell" /></svg></span><div><h3>Stay informed</h3><p>Thông báo và nhắc nhở hỗ trợ bạn theo dõi công việc và các mốc quan trọng.</p></div></div>
                    <div class="ed-pt"><span class="cw-ico"><svg class="ic"><use href="#lh-search" /></svg></span><div><h3>Work across screens</h3><p>Bố cục tương thích máy tính, máy tính bảng và điện thoại — chỉ cần mở trình duyệt.</p></div></div>
                </div>
            </div>
            <div class="dv rv" style="--d:.1s" aria-hidden="true">
                <div class="dv-d"><div class="mk-bar"><i></i><i></i><i></i></div>
                    <div class="dv-in"><div class="dv-line b"></div><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px"><div class="dv-blk"></div><div class="dv-blk"></div><div class="dv-blk"></div></div>
                        <div class="mk-row"><span class="mk-cb on"></span><span>Nộp báo cáo</span></div><div class="mk-row"><span class="mk-cb"></span><span>Họp nhóm đồ án</span></div></div></div>
                <div class="dv-t"><div class="dv-in"><div class="dv-line b"></div><div class="dv-blk"></div><div class="mk-row"><span class="mk-cb on"></span><span>Ôn tập</span></div><div class="mk-row"><span class="mk-cb"></span><span>Đi chợ</span></div></div></div>
                <div class="dv-p"><div class="dv-in" style="padding:10px"><div class="dv-line b"></div><div class="dv-blk" style="height:34px"></div><div class="dv-line"></div><div class="dv-line"></div></div></div>
            </div>
        </div>
    </section>

    <!-- 7B. WHY LIFEHUB (HIGHLIGHTS) -->
    <section class="lp-sec lp-sec-soft" aria-labelledby="hlTitle">
        <div class="lp-wrap">
            <div class="lp-head is-center rv">
                <span class="lp-kicker">Triết lý thiết kế</span>
                <h2 id="hlTitle">Built to stay calm, fast, and dependable.</h2>
                <p class="lp-lead">LifeHub không cố gắng nhồi nhét hiệu ứng phức tạp. Mọi thành phần đều hướng đến việc giúp bạn nhìn rõ việc cần làm và bắt tay vào làm ngay.</p>
            </div>
            <div class="hl-grid">
                <article class="hl-card rv">
                    <div class="hl-num">10+</div>
                    <h3>Phân hệ trong một tài khoản</h3>
                    <p>Từ học tập, công việc, dự án đến tài chính và sinh hoạt — bạn chỉ bật những phân hệ mình thực sự dùng, giữ giao diện luôn gọn gàng.</p>
                </article>
                <article class="hl-card rv" style="--d:.08s">
                    <div class="hl-num">01</div>
                    <h3>Nguồn dữ liệu thống nhất</h3>
                    <p>Deadline bài tập tự hiện trên lịch, phiên Pomodoro cộng vào giờ tập trung, giao dịch cập nhật ngân sách — không cần nhập lặp lại.</p>
                </article>
                <article class="hl-card rv" style="--d:.16s">
                    <div class="hl-num">100%</div>
                    <h3>Riêng tư &amp; chủ động</h3>
                    <p>Mỗi tài khoản có không gian dữ liệu độc lập, phân quyền rõ ràng khi cộng tác và hỗ trợ xuất báo cáo CSV bất cứ lúc nào.</p>
                </article>
            </div>
        </div>
    </section>

    <!-- 8. FINAL CTA -->
    <section class="cta" aria-labelledby="ctaTitle">
        <div class="lp-wrap">
            <div class="cta-box is-tint rv">
                <h2 id="ctaTitle">Start building a more organized life.</h2>
                <p>Đưa những kế hoạch, công việc và mục tiêu của bạn về cùng một không gian.</p>
                @if (signedIn)
                {
                    <a class="lp-btn lp-btn-primary lp-btn-lg" asp-controller="Dashboard" asp-action="Index">Vào ứng dụng</a>
                }
                else
                {
                    <a class="lp-btn lp-btn-primary lp-btn-lg" asp-controller="Auth" asp-action="Register">Bắt đầu với LifeHub</a>
                }
            </div>
        </div>
    </section>
</main>
