@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Bảo mật & Điều khoản – LifeHub";
    ViewData["LandingPage"] = "privacy";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
}

<main class="lh-home">

    <!-- BANNER CHÍNH SÁCH BẢO MẬT & ĐIỀU KHOẢN -->
    <section class="lh-banner">
        <div class="lh-wrap">
            <div class="lh-banner-top" style="margin-bottom:8px">
                <div class="lh-eyebrow-pill">
                    <b>✦ AN TOÀN &amp; MINH BẠCH</b>
                    Cam kết bảo vệ quyền riêng tư và dữ liệu người dùng
                </div>

                <h1 class="lh-banner-title">
                    Không gian riêng tư của bạn,<br />
                    <span class="lh-grad-text">được bảo vệ ở mức cao nhất.</span>
                </h1>

                <p class="lh-banner-intro">
                    Tại <strong>LifeHub</strong>, lịch học, bảng điểm, kế hoạch tài chính hay nhật ký sinh hoạt đều là những thông tin cá nhân đáng trân trọng. Chúng tôi xây dựng hệ thống dựa trên nguyên tắc minh bạch, bảo mật nhiều lớp và tôn trọng tuyệt đối quyền làm chủ dữ liệu của bạn.
                </p>
            </div>
        </div>
    </section>

    <!-- 4 TRỤ CỘT BẢO MẬT ĐA SẮC -->
    <section style="padding-bottom:36px">
        <div class="lh-wrap">
            <div class="lh-persona-grid">
                <div class="lh-persona-card">
                    <div class="lh-persona-emo" style="background:#eff6ff;color:#2563eb">🔒</div>
                    <h3>Mã hóa &amp; Xác thực</h3>
                    <p>Mật khẩu luôn được mã hóa an toàn; phiên đăng nhập được bảo vệ nhiều lớp giúp ngăn chặn truy cập trái phép.</p>
                </div>
                <div class="lh-persona-card">
                    <div class="lh-persona-emo" style="background:#f0fdf4;color:#16a34a">🛡️</div>
                    <h3>Tách biệt tuyệt đối</h3>
                    <p>Dữ liệu cá nhân ở cả 10 phân hệ được cô lập hoàn toàn theo tài khoản của bạn; không hiển thị công khai dưới mọi hình thức.</p>
                </div>
                <div class="lh-persona-card">
                    <div class="lh-persona-emo" style="background:#faf5ff;color:#7c3aed">🤝</div>
                    <h3>Chia sẻ có kiểm soát</h3>
                    <p>Chỉ những dự án hoặc tài liệu bạn chủ động mời thành viên mới được phép truy cập đúng theo vai trò đã cấp.</p>
                </div>
                <div class="lh-persona-card">
                    <div class="lh-persona-emo" style="background:#fff0f3;color:#e11d48">📦</div>
                    <h3>Toàn quyền sở hữu</h3>
                    <p>Bạn có toàn quyền chỉnh sửa, xuất báo cáo hoặc xóa vĩnh viễn bất kỳ bản ghi nào trong không gian của mình.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CHI TIẾT CHÍNH SÁCH & ĐIỀU KHOẢN -->
    <section class="lh-sync-sec">
        <div class="lh-wrap">
            <div class="lh-policy-grid">

                <article class="lh-policy-card">
                    <h3><span style="color:#2563eb">01.</span> Thông tin chúng tôi lưu trữ</h3>
                    <p>LifeHub chỉ thu thập và lưu trữ những dữ liệu cần thiết trực tiếp phục vụ cho các phân hệ bạn sử dụng:</p>
                    <ul>
                        <li>Thông tin định danh tài khoản: Họ tên, địa chỉ Email và mật khẩu đã mã hóa.</li>
                        <li>Dữ liệu nghiệp vụ do chính bạn tạo: Môn học, công việc, dự án, lịch hẹn, giao dịch tài chính, mục tiêu, thói quen, ghi chú và sinh hoạt.</li>
                        <li>Tùy chọn giao diện (chế độ Sáng / Tối) và trạng thái thông báo nhắc hẹn.</li>
                    </ul>
                </article>

                <article class="lh-policy-card">
                    <h3><span style="color:#16a34a">02.</span> Mục đích sử dụng dữ liệu</h3>
                    <p>Mọi thông tin bạn nhập vào hệ thống chỉ được xử lý tự động nhằm mang lại trải nghiệm quản lý tốt nhất cho bạn:</p>
                    <ul>
                        <li>Đồng bộ lịch trình, tính toán điểm GPA, hạn mức ngân sách và chuỗi thói quen.</li>
                        <li>Tổng hợp biểu đồ thống kê năng suất trên Bảng điều khiển cá nhân.</li>
                        <li>Tuyệt đối không bán, trao đổi hoặc chia sẻ dữ liệu cá nhân cho bên thứ ba vì mục đích quảng cáo.</li>
                    </ul>
                </article>

                <article class="lh-policy-card">
                    <h3><span style="color:#ea580c">03.</span> Bảo vệ tài khoản &amp; Phiên làm việc</h3>
                    <p>Chúng tôi duy trì các lớp bảo vệ tự động để bạn yên tâm sử dụng mỗi ngày:</p>
                    <ul>
                        <li>Xác minh an toàn trên mọi thao tác thêm mới, cập nhật hoặc xóa thông tin.</li>
                        <li>Tự động phát hiện và ngăn chặn các lượt thử đăng nhập bất thường liên tiếp.</li>
                        <li>Tự động kết thúc phiên làm việc khi hết thời hạn ghi nhớ đăng nhập.</li>
                    </ul>
                </article>

                <article class="lh-policy-card">
                    <h3><span style="color:#7c3aed">04.</span> Điều khoản sử dụng lành mạnh</h3>
                    <p>Khi đồng hành cùng cộng đồng người dùng LifeHub, bạn cam kết:</p>
                    <ul>
                        <li>Cung cấp địa chỉ email hợp lệ và tự bảo quản thông tin đăng nhập cá nhân.</li>
                        <li>Không tải lên các tệp đính kèm chứa mã độc hoặc nội dung vi phạm pháp luật trong không gian dự án chung.</li>
                        <li>Tôn trọng quyền riêng tư và vai trò phân quyền của các thành viên cùng cộng tác trong dự án nhóm.</li>
                    </ul>
                </article>

            </div>
        </div>
    </section>

    <!-- CTA CUỐI TRANG -->
    <section>
        <div class="lh-wrap">
            <div class="lh-final-cta">
                <h2>An tâm sắp xếp trọn vẹn cuộc sống cùng LifeHub</h2>
                <p>Không gian cá nhân minh bạch, an toàn và luôn sẵn sàng đồng hành cùng bạn mỗi ngày.</p>
                <div class="lh-banner-actions">
                    @if (isSignedIn)
                    {
                        <a class="lh-hero-btn primary" asp-controller="Dashboard" asp-action="Index">
                            Quay lại Bảng điều khiển <span>→</span>
                        </a>
                    }
                    else
                    {
                        <a class="lh-hero-btn primary" asp-controller="Auth" asp-action="Register">
                            Tạo tài khoản ngay <span>→</span>
                        </a>
                        <a class="lh-hero-btn" asp-controller="Home" asp-action="Index">
                            Về Trang chủ
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

</main>
