@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Tính năng – LifeHub";
    ViewData["LandingPage"] = "features";
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<main>
    <!-- 1. FEATURES HERO -->
    <section class="fh" aria-labelledby="fhTitle">
        <div class="lp-wrap">
            <h1 id="fhTitle">Everything you need to move forward.</h1>
            <p class="lp-lead">Một hệ thống kết nối các công cụ quản lý cá nhân, từ học tập và công việc đến tài chính, mục tiêu và sinh hoạt.</p>
            <div class="hero-cta">
                <a class="lp-btn lp-btn-primary lp-btn-lg" href="#tasks">Khám phá các phân hệ</a>
                @if (signedIn)
                {
                    <a class="lp-btn lp-btn-lg" asp-controller="Dashboard" asp-action="Index">Vào ứng dụng</a>
                }
                else
                {
                    <a class="lp-btn lp-btn-lg" asp-controller="Auth" asp-action="Register">Bắt đầu miễn phí</a>
                }
            </div>
            <p class="hero-line">10 lĩnh vực quản lý · Một không gian thống nhất</p>

            <div class="fh-collage" aria-hidden="true">
                <div class="mk-card fc-1"><h5>Việc hôm nay</h5>
                    <div class="mk-row"><span class="mk-cb on"></span><span>Nộp báo cáo</span></div>
                    <div class="mk-row"><span class="mk-cb"></span><span>Họp nhóm</span></div>
                    <div class="mk-row"><span class="mk-cb"></span><span>Ôn tập</span></div></div>
                <div class="mk-card fc-2"><h5>Pomodoro</h5>
                    <div class="mk-ring" style="width:118px;height:118px"><div style="width:94px;height:94px"><strong style="font-size:22px">17:42</strong></div></div></div>
                <div class="mk-card fc-3"><h5>Ngân sách tháng</h5>
                    <div class="mk-meter"><i style="--w:64%"></i></div>
                    <div class="mk-row" style="margin-top:8px"><span>Ăn uống</span><b style="color:var(--lp-h)">64%</b></div>
                    <div class="mk-meter"><i style="--w:38%;--c:#0D9488"></i></div>
                    <div class="mk-row" style="margin-top:8px"><span>Đi lại</span><b style="color:var(--lp-h)">38%</b></div></div>
                <div class="mk-card fc-4"><h5>Thói quen</h5>
                    <div class="mk-heat" style="grid-template-columns:repeat(7,1fr)"><i class="c"></i><i class="c"></i><i class="b"></i><i class="c"></i><i></i><i class="c"></i><i class="a"></i><i class="c"></i><i class="c"></i><i class="c"></i><i class="b"></i><i class="c"></i><i class="c"></i><i class="a"></i></div></div>
            </div>
        </div>
    </section>

    <!-- 2. FEATURE NAVIGATOR -->
    <nav class="fn" aria-label="Khám phá theo lĩnh vực">
        <div class="lp-wrap">
            <span class="fn-t">Khám phá theo lĩnh vực</span>
            <a href="#tasks">Công việc</a><a href="#time">Thời gian</a><a href="#focus">Tập trung</a><a href="#projects">Dự án</a>
            <a href="#study">Học tập</a><a href="#finance">Tài chính</a><a href="#goals">Mục tiêu &amp; thói quen</a><a href="#knowledge">Kiến thức</a>
            <a href="#lifestyle">Sinh hoạt</a><a href="#reports">Báo cáo</a><a href="#utilities">Tiện ích</a>
        </div>
    </nav>

    <!-- 3. CORE MODULES -->
    <section class="fx" id="tasks" aria-labelledby="t-tasks">
        <div class="lp-wrap fx-in">
            <div class="fx-copy rv" style="--c:#0D9488">
                <span class="cw-ico"><svg class="ic"><use href="#lh-check" /></svg></span>
                <span class="fx-label">Công việc</span>
                <h2 id="t-tasks">Take control of your tasks.</h2>
                <p>Ghi lại mọi việc cần làm, đặt hạn và mức ưu tiên để biết nên bắt đầu từ đâu mỗi ngày.</p>
                <ul class="lp-ticks">
                    <li>Tạo công việc, deadline và mức ưu tiên.</li>
                    <li>Chia việc lớn thành việc con và checklist.</li>
                    <li>Gắn nhãn, lọc và theo dõi trạng thái.</li>
                    <li>Bình luận, tệp đính kèm và sắp xếp.</li>
                </ul>
                <div class="fx-usecase">
                    <strong>Ví dụ thực tế</strong>
                    Gắn một công việc vào môn học hoặc dự án nhóm để vừa theo dõi trên danh sách cá nhân, vừa cập nhật tiến độ chung.
                </div>
            </div>
            <div class="fx-vis rv" style="--d:.1s" aria-hidden="true"><div class="mk"><div class="mk-bar"><i></i><i></i><i></i><b>Công việc</b></div><div class="fx-pad">
                <div class="mk-tabs"><span class="on" data-filter="all">Tất cả</span><span data-filter="today">Hôm nay</span><span data-filter="done">Đã hoàn thành</span></div>
                <div class="mk-card">
                    <div class="mk-row done" data-cat="today done"><span class="mk-cb on"></span><span>Nộp báo cáo môn Cơ sở dữ liệu</span><em class="mk-tag" style="--c:#DC2626">Cao</em><time>Hôm nay</time></div>
                    <div class="mk-row" data-cat="today"><span class="mk-cb"></span><span>Chuẩn bị slide thuyết trình</span><em class="mk-tag" style="--c:#7C3AED">Đồ án</em><time>Thứ 5</time></div>
                    <div class="mk-row" data-cat=""><span class="mk-cb"></span><span>Đọc tài liệu chương 5 <small style="color:var(--lp-muted)">· 2/4 việc con</small></span><em class="mk-tag" style="--c:#D97706">Vừa</em><time>Thứ 6</time></div>
                    <div class="mk-row" data-cat=""><span class="mk-cb"></span><span>Mua tài liệu ôn thi</span><em class="mk-tag">Thấp</em><time>Tuần sau</time></div>
                </div></div></div></div>
        </div>
    </section>

    <section class="fx is-rev is-alt" id="time" aria-labelledby="t-time">
        <div class="lp-wrap fx-in">
            <div class="fx-copy rv" style="--c:#D97706">
                <span class="cw-ico"><svg class="ic"><use href="#lh-cal" /></svg></span>
                <span class="fx-label">Thời gian &amp; lịch</span>
                <h2 id="t-time">See your time more clearly.</h2>
                <p>Lịch học, deadline và sự kiện cá nhân cùng xuất hiện trên một lịch chung.</p>
                <ul class="lp-ticks">
                    <li>Lịch ngày, tuần, tháng.</li>
                    <li>Lịch học, deadline và sự kiện cá nhân.</li>
                    <li>Sự kiện lặp lại.</li>
                    <li>Nhắc nhở theo thời gian bạn thiết lập.</li>
                </ul>
            </div>
            <div class="fx-vis rv" style="--d:.1s" aria-hidden="true"><div class="mk"><div class="mk-bar"><i></i><i></i><i></i><b>Lịch chung · Tuần này</b></div><div class="fx-pad">
                <div class="mk-week">
                    <div><h6>T2</h6><div class="mk-ev" style="--c:#2563EB">Lập trình web<small>07:30</small></div><div class="mk-ev" style="--c:#0D9488">Tập gym<small>18:00</small></div></div>
                    <div><h6>T3</h6><div class="mk-ev" style="--c:#7C3AED">Họp nhóm<small>14:00</small></div></div>
                    <div><h6>T4</h6><div class="mk-ev" style="--c:#2563EB">Cơ sở dữ liệu<small>09:00</small></div><div class="mk-ev" style="--c:#D97706">Sinh nhật Lan<small>19:00</small></div></div>
                    <div><h6>T5</h6><div class="mk-ev" style="--c:#DC2626">Hạn nộp báo cáo<small>23:59</small></div></div>
                    <div><h6>T6</h6><div class="mk-ev" style="--c:#2563EB">Mạng máy tính<small>13:00</small></div><div class="mk-ev" style="--c:#0D9488">Học nhóm<small>16:00</small></div></div>
                </div></div></div></div>
        </div>
    </section>

    <section class="fx" id="focus" aria-labelledby="t-focus">
        <div class="lp-wrap fx-in">
            <div class="fx-copy rv" style="--c:#DC2626">
                <span class="cw-ico"><svg class="ic"><use href="#lh-timer" /></svg></span>
                <span class="fx-label">Tập trung · Pomodoro</span>
                <h2 id="t-focus">Make focused time count.</h2>
                <p>Làm việc theo từng phiên ngắn, nghỉ đúng lúc và nhìn lại mình đã tập trung được bao lâu.</p>
                <ul class="lp-ticks">
                    <li>Tùy chỉnh thời gian tập trung và nghỉ.</li>
                    <li>Gắn phiên tập trung với công việc hoặc môn học.</li>
                    <li>Ghi nhận phiên đã hoàn thành hoặc bỏ dở.</li>
                    <li>Thống kê thời gian tập trung.</li>
                </ul>
            </div>
            <div class="fx-vis rv" style="--d:.1s" aria-hidden="true"><div class="mk"><div class="mk-bar"><i></i><i></i><i></i><b>Pomodoro</b></div><div class="fx-pad" style="text-align:center">
                <div class="mk-ring"><div><strong>17:42</strong><small>Đang tập trung</small></div></div>
                <div class="mk-card" style="max-width:340px;margin:0 auto"><div class="mk-row"><svg class="ic" style="color:var(--lp-p)"><use href="#lh-check" /></svg><span>Nộp báo cáo môn Cơ sở dữ liệu</span><em class="mk-tag">Phiên 2/4</em></div></div>
                <div style="display:flex;gap:10px;justify-content:center;margin-top:16px"><span class="lp-btn" style="height:38px;font-size:13.5px">Tạm dừng</span><span class="lp-btn lp-btn-primary" style="height:38px;font-size:13.5px">Hoàn thành</span></div>
            </div></div></div>
        </div>
    </section>

    <section class="fx is-rev is-alt" id="projects" aria-labelledby="t-projects">
        <div class="lp-wrap fx-in">
            <div class="fx-copy rv" style="--c:#7C3AED">
                <span class="cw-ico"><svg class="ic"><use href="#lh-kanban" /></svg></span>
                <span class="fx-label">Dự án</span>
                <h2 id="t-projects">Bring projects into focus.</h2>
                <p>Làm việc nhóm rõ ràng hơn khi ai làm gì, đến đâu đều nằm trên cùng một bảng.</p>
                <ul class="lp-ticks">
                    <li>Bảng Kanban theo trạng thái.</li>
                    <li>Phân công thành viên.</li>
                    <li>Vai trò và quyền trong dự án.</li>
                    <li>Cột mốc và tiến độ.</li>
                    <li>Bình luận, tệp và nhật ký hoạt động.</li>
                </ul>
            </div>
            <div class="fx-vis rv" style="--d:.1s" aria-hidden="true"><div class="mk"><div class="mk-bar"><i></i><i></i><i></i><b>Đồ án tốt nghiệp</b></div><div class="fx-pad">
                <div class="mk-kb">
                    <div><h6>Cần làm <span>2</span></h6><div class="mk-kc">Thiết kế CSDL<div class="mk-av"><i style="--c:#2563EB"></i><i style="--c:#0D9488"></i></div></div><div class="mk-kc">Viết đề cương<div class="mk-av"><i style="--c:#7C3AED"></i></div></div></div>
                    <div><h6>Đang làm <span>2</span></h6><div class="mk-kc">Giao diện trang chủ<div class="mk-av"><i style="--c:#0D9488"></i><i style="--c:#D97706"></i></div></div><div class="mk-kc">API đăng nhập<div class="mk-av"><i style="--c:#2563EB"></i></div></div></div>
                    <div><h6>Hoàn thành <span>1</span></h6><div class="mk-kc" style="opacity:.7">Khảo sát yêu cầu<div class="mk-av"><i style="--c:#7C3AED"></i><i style="--c:#2563EB"></i></div></div></div>
                </div></div></div></div>
        </div>
    </section>

    <section class="fx" id="study" aria-labelledby="t-study">
        <div class="lp-wrap fx-in">
            <div class="fx-copy rv" style="--c:#2563EB">
                <span class="cw-ico"><svg class="ic"><use href="#lh-book" /></svg></span>
                <span class="fx-label">Học tập</span>
                <h2 id="t-study">Make learning easier to manage.</h2>
                <p>Mỗi học kỳ có môn học, lịch học, bài tập và điểm số được sắp xếp gọn gàng.</p>
                <ul class="lp-ticks">
                    <li>Quản lý học kỳ và môn học.</li>
                    <li>Thời khóa biểu.</li>
                    <li>Bài tập, kiểm tra và lịch thi.</li>
                    <li>Điểm số và tiến độ môn học.</li>
                    <li>Tài liệu theo từng môn.</li>
                </ul>
            </div>
            <div class="fx-vis rv" style="--d:.1s" aria-hidden="true"><div class="mk"><div class="mk-bar"><i></i><i></i><i></i><b>Học kỳ 1 · Môn học</b></div><div class="fx-pad"><div class="mk-split">
                <div class="mk-card"><div class="mk-row"><i class="mk-dot"></i><span>Lập trình web</span><time>3 bài tập</time></div><div class="mk-meter"><i style="--w:78%"></i></div>
                    <div class="mk-row" style="margin-top:6px"><i class="mk-dot" style="--c:#7C3AED"></i><span>Cơ sở dữ liệu</span><time>Thi 12/01</time></div><div class="mk-meter"><i style="--w:55%;--c:#7C3AED"></i></div>
                    <div class="mk-row" style="margin-top:6px"><i class="mk-dot" style="--c:#0D9488"></i><span>Mạng máy tính</span><time>1 bài tập</time></div><div class="mk-meter"><i style="--w:90%;--c:#0D9488"></i></div></div>
                <div class="mk-card"><h5>Bài tập sắp đến hạn</h5><div class="mk-row"><span>Bài tập lớn – Lập trình web</span><em class="mk-tag" style="--c:#DC2626">2 ngày</em></div><div class="mk-row"><span>Báo cáo thực hành CSDL</span><em class="mk-tag" style="--c:#D97706">5 ngày</em></div></div>
            </div></div></div></div>
        </div>
    </section>

    <section class="fx is-rev is-alt" id="finance" aria-labelledby="t-finance">
        <div class="lp-wrap fx-in">
            <div class="fx-copy rv" style="--c:#16A34A">
                <span class="cw-ico"><svg class="ic"><use href="#lh-wallet" /></svg></span>
                <span class="fx-label">Tài chính</span>
                <h2 id="t-finance">Understand your money.</h2>
                <p>Biết tiền đến từ đâu, đi đâu và còn lại bao nhiêu trong ngân sách của bạn.</p>
                <ul class="lp-ticks">
                    <li>Nhiều ví.</li>
                    <li>Giao dịch thu chi.</li>
                    <li>Danh mục.</li>
                    <li>Ngân sách.</li>
                    <li>Mục tiêu tiết kiệm và biểu đồ.</li>
                </ul>
            </div>
            <div class="fx-vis rv" style="--d:.1s" aria-hidden="true"><div class="mk"><div class="mk-bar"><i></i><i></i><i></i><b>Tài chính</b></div><div class="fx-pad"><div class="mk-split">
                <div class="mk-stats" style="grid-template-columns:repeat(3,1fr)"><div class="mk-stat"><small>Tổng số dư</small><b>12,4tr</b></div><div class="mk-stat"><small>Thu tháng này</small><b style="color:var(--lp-ok)">8,0tr</b></div><div class="mk-stat"><small>Chi tháng này</small><b>3,6tr</b></div></div>
                <div class="mk-card mk-flex"><div class="mk-donut"><div><b>3,6tr</b>đã chi</div></div>
                    <div class="mk-leg"><span><i class="mk-dot"></i>Ăn uống<b>42%</b></span><span><i class="mk-dot" style="--c:#60a5fa"></i>Đi lại<b>26%</b></span><span><i class="mk-dot" style="--c:#a5b4fc"></i>Học tập<b>16%</b></span><span><i class="mk-dot" style="--c:#e2e8f0"></i>Khác<b>16%</b></span></div></div>
            </div></div></div></div>
        </div>
    </section>

    <section class="fx" id="goals" aria-labelledby="t-goals">
        <div class="lp-wrap fx-in">
            <div class="fx-copy rv" style="--c:#EA580C">
                <span class="cw-ico"><svg class="ic"><use href="#lh-target" /></svg></span>
                <span class="fx-label">Mục tiêu &amp; thói quen</span>
                <h2 id="t-goals">Turn intentions into progress.</h2>
                <p>Đặt mục tiêu dài hạn, chia thành kết quả chính và duy trì bằng những thói quen nhỏ mỗi ngày.</p>
                <ul class="lp-ticks">
                    <li>Tạo mục tiêu và kết quả chính.</li>
                    <li>Theo dõi tiến độ.</li>
                    <li>Liên kết công việc với mục tiêu.</li>
                    <li>Ghi nhận thói quen theo tần suất.</li>
                    <li>Xem chuỗi ngày và đánh giá kết quả.</li>
                </ul>
            </div>
            <div class="fx-vis rv" style="--d:.1s" aria-hidden="true"><div class="mk"><div class="mk-bar"><i></i><i></i><i></i><b>Mục tiêu &amp; thói quen</b></div><div class="fx-pad"><div class="mk-split">
                <div class="mk-card"><h5>Đạt IELTS 7.0 trong năm nay</h5><div class="mk-meter"><i style="--w:58%;--c:#EA580C"></i></div>
                    <div class="mk-row" style="margin-top:8px"><span>Hoàn thành 20 đề Reading</span><b style="color:var(--lp-h)">14/20</b></div>
                    <div class="mk-row"><span>Học 300 từ vựng mới</span><b style="color:var(--lp-h)">180/300</b></div></div>
                <div class="mk-card"><div class="mk-row" style="border:0;padding-top:0"><svg class="ic" style="color:#EA580C"><use href="#lh-flame" /></svg><span>Đọc sách 20 phút</span><em class="mk-tag" style="--c:#EA580C">12 ngày liên tiếp</em></div>
                    <div class="mk-heat"><i class="c"></i><i class="c"></i><i class="c"></i><i class="b"></i><i class="c"></i><i class="c"></i><i></i><i class="c"></i><i class="c"></i><i class="c"></i><i class="c"></i><i class="b"></i><i class="c"></i><i class="a"></i></div></div>
            </div></div></div></div>
        </div>
    </section>

    <section class="fx is-rev is-alt" id="knowledge" aria-labelledby="t-knowledge">
        <div class="lp-wrap fx-in">
            <div class="fx-copy rv" style="--c:#2563EB">
                <span class="cw-ico"><svg class="ic"><use href="#lh-note" /></svg></span>
                <span class="fx-label">Kiến thức &amp; tài liệu</span>
                <h2 id="t-knowledge">Keep what matters within reach.</h2>
                <p>Ghi chú và tài liệu được phân loại để bạn tìm lại nhanh khi cần.</p>
                <ul class="lp-ticks">
                    <li>Ghi chú.</li>
                    <li>Thư mục và nhãn.</li>
                    <li>Tài liệu đính kèm.</li>
                    <li>Tìm kiếm và lọc.</li>
                    <li>Chia sẻ với quyền xem hoặc sửa.</li>
                </ul>
            </div>
            <div class="fx-vis rv" style="--d:.1s" aria-hidden="true"><div class="mk"><div class="mk-bar"><i></i><i></i><i></i><b>Kiến thức</b></div><div class="fx-pad"><div class="mk-doc">
                <div class="mk-fl"><span class="on"><svg class="ic"><use href="#lh-folder" /></svg>Tất cả ghi chú</span><span><svg class="ic"><use href="#lh-folder" /></svg>Học tập</span><span><svg class="ic"><use href="#lh-folder" /></svg>Dự án</span><span><svg class="ic"><use href="#lh-folder" /></svg>Cá nhân</span></div>
                <div class="mk-card mk-prev"><h5>Ghi chú: Chuẩn hóa cơ sở dữ liệu</h5><div class="mk-av" style="display:flex;gap:6px;margin-bottom:10px"><em class="mk-tag">Học tập</em><em class="mk-tag" style="--c:#7C3AED">Ôn thi</em></div><div class="dv-line" style="width:100%"></div><div class="dv-line" style="width:92%"></div><div class="dv-line" style="width:70%"></div><div class="mk-row" style="margin-top:8px"><svg class="ic" style="color:var(--lp-p)"><use href="#lh-share" /></svg><span>Chia sẻ · Quyền xem</span></div></div>
            </div></div></div></div>
        </div>
    </section>

    <section class="fx" id="lifestyle" aria-labelledby="t-life">
        <div class="lp-wrap fx-in">
            <div class="fx-copy rv" style="--c:#DB2777">
                <span class="cw-ico"><svg class="ic"><use href="#lh-heart" /></svg></span>
                <span class="fx-label">Sinh hoạt cá nhân</span>
                <h2 id="t-life">Make room for your everyday life.</h2>
                <p>Ghi lại nhịp sinh hoạt hằng ngày để tự nhìn lại thói quen của mình. LifeHub dùng để ghi nhận và tự quan sát, không đưa ra chẩn đoán sức khỏe.</p>
                <ul class="lp-ticks">
                    <li>Nhật ký sinh hoạt.</li>
                    <li>Theo dõi giấc ngủ.</li>
                    <li>Lượng nước và thời gian vận động.</li>
                    <li>Tâm trạng.</li>
                    <li>Tổng hợp xu hướng theo tuần hoặc tháng.</li>
                </ul>
            </div>
            <div class="fx-vis rv" style="--d:.1s" aria-hidden="true"><div class="mk"><div class="mk-bar"><i></i><i></i><i></i><b>Nhật ký hôm nay</b></div><div class="fx-pad"><div class="mk-split">
                <div class="mk-stats" style="grid-template-columns:repeat(3,1fr)"><div class="mk-stat"><small>Giấc ngủ</small><b>7h 20</b></div><div class="mk-stat"><small>Nước uống</small><b>1,5 L</b></div><div class="mk-stat"><small>Vận động</small><b>35 ph</b></div></div>
                <div class="mk-card"><h5>Tâm trạng hôm nay</h5><div class="mk-mood"><span>Căng thẳng</span><span>Bình thường</span><span class="on">Vui</span><span>Rất vui</span></div></div>
                <div class="mk-card"><h5>Giấc ngủ 7 ngày qua</h5><div class="mk-bars" style="height:64px"><i style="--h:70%"></i><i style="--h:60%"></i><i style="--h:80%"></i><i style="--h:55%"></i><i style="--h:75%"></i><i class="on" style="--h:85%"></i><i style="--h:72%"></i></div></div>
            </div></div></div></div>
        </div>
    </section>

    <section class="fx is-rev is-alt" id="reports" aria-labelledby="t-reports">
        <div class="lp-wrap fx-in">
            <div class="fx-copy rv" style="--c:#0891B2">
                <span class="cw-ico"><svg class="ic"><use href="#lh-chart" /></svg></span>
                <span class="fx-label">Thống kê &amp; báo cáo</span>
                <h2 id="t-reports">See your progress over time.</h2>
                <p>Nhìn lại dữ liệu từ nhiều phân hệ theo từng kỳ để điều chỉnh kế hoạch cho phù hợp.</p>
                <ul class="lp-ticks">
                    <li>Tổng quan hoạt động.</li>
                    <li>Báo cáo học tập.</li>
                    <li>Báo cáo công việc và dự án.</li>
                    <li>Báo cáo tài chính.</li>
                    <li>Mục tiêu và thói quen.</li>
                    <li>Xuất số liệu báo cáo ra tệp CSV (mở được bằng Excel).</li>
                </ul>
            </div>
            <div class="fx-vis rv" style="--d:.1s" aria-hidden="true"><div class="mk"><div class="mk-bar"><i></i><i></i><i></i><b>Báo cáo</b></div><div class="fx-pad"><div class="mk-split">
                <div class="mk-tabs" style="margin:0"><span>7 ngày</span><span class="on">30 ngày</span><span>Học kỳ</span></div>
                <div class="mk-stats" style="grid-template-columns:repeat(3,1fr)"><div class="mk-stat"><small>Việc hoàn thành</small><b>86%</b></div><div class="mk-stat"><small>Giờ tập trung</small><b>42 h</b></div><div class="mk-stat"><small>Thói quen đạt</small><b>74%</b></div></div>
                <div class="mk-card"><h5>Giờ tập trung theo tuần</h5><div class="mk-bars"><i style="--h:35%"></i><i style="--h:55%"></i><i style="--h:48%"></i><i style="--h:70%"></i><i style="--h:62%"></i><i style="--h:80%"></i><i class="on" style="--h:92%"></i></div></div>
            </div></div></div></div>
        </div>
    </section>

    <!-- 4. CONNECTED FEATURES -->
    <section class="lp-sec" id="utilities" aria-labelledby="utTitle">
        <div class="lp-wrap">
            <div class="lp-head is-center rv">
                <h2 id="utTitle">The little things that make everything work together.</h2>
                <p class="lp-lead">Những tiện ích dùng chung cho mọi phân hệ.</p>
            </div>
            <div class="ut">
                <div class="ut-i rv"><span class="cw-ico"><svg class="ic"><use href="#lh-search" /></svg></span><h3>Tìm kiếm toàn hệ thống</h3><p>Tìm công việc, dự án, môn học, ghi chú.</p></div>
                <div class="ut-i rv" style="--d:.05s"><span class="cw-ico"><svg class="ic"><use href="#lh-bell" /></svg></span><h3>Thông báo</h3><p>Theo dõi sự kiện và hoạt động.</p></div>
                <div class="ut-i rv" style="--d:.1s"><span class="cw-ico"><svg class="ic"><use href="#lh-clock" /></svg></span><h3>Nhắc nhở</h3><p>Nhắc trước thời điểm quan trọng.</p></div>
                <div class="ut-i rv" style="--d:.15s"><span class="cw-ico"><svg class="ic"><use href="#lh-share" /></svg></span><h3>Chia sẻ</h3><p>Chia sẻ ghi chú, tài liệu và dự án theo quyền.</p></div>
                <div class="ut-i rv"><span class="cw-ico"><svg class="ic"><use href="#lh-user" /></svg></span><h3>Hồ sơ &amp; cài đặt</h3><p>Quản lý tài khoản và tùy chỉnh.</p></div>
                <div class="ut-i rv" style="--d:.05s"><span class="cw-ico"><svg class="ic"><use href="#lh-award" /></svg></span><h3>Thành tựu</h3><p>Huy hiệu và điểm thưởng.</p></div>
                <div class="ut-i rv" style="--d:.1s"><span class="cw-ico"><svg class="ic"><use href="#lh-moon" /></svg></span><h3>Giao diện sáng/tối</h3><p>Chọn giao diện phù hợp với bạn.</p></div>
                <div class="ut-i rv" style="--d:.15s"><span class="cw-ico"><svg class="ic"><use href="#lh-download" /></svg></span><h3>Xuất dữ liệu</h3><p>Xuất báo cáo ra CSV; lưu PDF bằng chức năng in của trình duyệt.</p></div>
            </div>
        </div>
    </section>

    <!-- 4B. MODULE COMBOS -->
    <section class="lp-sec lp-sec-soft" aria-labelledby="cbTitle">
        <div class="lp-wrap">
            <div class="lp-head is-center rv">
                <span class="lp-kicker">Phối hợp đa phân hệ</span>
                <h2 id="cbTitle">Stronger when used together.</h2>
                <p class="lp-lead">Mỗi phân hệ đều hoạt động độc lập, nhưng khi kết hợp lại sẽ tạo thành quy trình khép kín rất tự nhiên.</p>
            </div>
            <div class="combo-grid">
                <article class="combo-card rv">
                    <div class="combo-flow">
                        <span class="combo-pill">Học tập</span><span class="combo-plus">+</span>
                        <span class="combo-pill">Thời gian</span><span class="combo-plus">+</span>
                        <span class="combo-pill">Pomodoro</span>
                    </div>
                    <h3>Mùa thi &amp; Đồ án không bị quá tải</h3>
                    <p>Bài tập và lịch thi tự đồng bộ vào Lịch chung; khi vào giờ ôn tập, mở Pomodoro gắn thẳng với môn học để đo thời gian thực tế.</p>
                </article>
                <article class="combo-card rv" style="--d:.08s">
                    <div class="combo-flow">
                        <span class="combo-pill">Công việc</span><span class="combo-plus">+</span>
                        <span class="combo-pill">Mục tiêu</span><span class="combo-plus">+</span>
                        <span class="combo-pill">Thói quen</span>
                    </div>
                    <h3>Biến mục tiêu lớn thành nhịp hằng ngày</h3>
                    <p>Gắn các công việc ưu tiên vào Kết quả chính của mục tiêu, kết hợp theo dõi thói quen mỗi ngày để duy trì đà tiến độ dài hạn.</p>
                </article>
                <article class="combo-card rv" style="--d:.16s">
                    <div class="combo-flow">
                        <span class="combo-pill">Tài chính</span><span class="combo-plus">+</span>
                        <span class="combo-pill">Sinh hoạt</span><span class="combo-plus">+</span>
                        <span class="combo-pill">Báo cáo</span>
                    </div>
                    <h3>Nhìn lại bức tranh cân bằng cuối tháng</h3>
                    <p>Tổng hợp chi tiêu theo danh mục, nhịp ngủ và thời gian vận động trên cùng trang Báo cáo để điều chỉnh thói quen tháng tiếp theo.</p>
                </article>
            </div>
        </div>
    </section>

    <!-- 5. PERSONALIZATION & ACCESSIBILITY -->
    <section class="lp-sec lp-sec-tint" aria-labelledby="ywTitle">
        <div class="lp-wrap yw">
            <div class="rv">
                <h2 id="ywTitle" style="margin-bottom:30px">Your workspace. Your way.</h2>
                <ul class="yw-list">
                    <li><span class="cw-ico"><svg class="ic"><use href="#lh-grid" /></svg></span><div><h3>Chọn phân hệ muốn hiển thị</h3><p>Chỉ giữ những phần bạn dùng hằng ngày.</p></div></li>
                    <li><span class="cw-ico"><svg class="ic"><use href="#lh-sun" /></svg></span><div><h3>Light hoặc Dark mode</h3><p>Đổi giao diện sáng hoặc tối theo thói quen của bạn.</p></div></li>
                    <li><span class="cw-ico"><svg class="ic"><use href="#lh-search" /></svg></span><div><h3>Thích ứng nhiều màn hình</h3><p>Giao diện co giãn trên desktop, tablet và mobile.</p></div></li>
                </ul>
            </div>
            <div class="dv rv" style="--d:.1s;height:340px" aria-hidden="true">
                <div class="dv-d" style="width:80%;height:300px"><div class="mk-bar"><i></i><i></i><i></i></div>
                    <div class="dv-in"><div class="dv-line b"></div><div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px"><div class="dv-blk"></div><div class="dv-blk"></div><div class="dv-blk"></div></div><div class="mk-row"><span class="mk-cb on"></span><span>Nộp báo cáo</span></div><div class="mk-row"><span class="mk-cb"></span><span>Họp nhóm đồ án</span></div></div></div>
                <div class="dv-p" style="width:22%;height:250px;top:auto;bottom:0"><div class="dv-in" style="padding:10px"><div class="dv-line b"></div><div class="dv-blk" style="height:34px"></div><div class="dv-line"></div><div class="dv-line"></div></div></div>
            </div>
        </div>
    </section>

    <!-- 6. COMING SOON & CTA -->
    <section class="lp-sec" aria-labelledby="soonTitle">
        <div class="lp-wrap">
            <div class="lp-head rv">
                <span class="lp-kicker">Định hướng phát triển</span>
                <h2 id="soonTitle">Đang được chuẩn bị cho LifeHub.</h2>
                <p class="lp-lead">Những tính năng dưới đây chưa có trong phiên bản hiện tại và được tách riêng khỏi danh sách tính năng đang dùng được.</p>
            </div>
            <div class="soon">
                <div class="soon-i rv"><span class="lp-chip is-soon">Dự kiến</span><h3>Trợ lý AI</h3><p>Hỗ trợ gợi ý và lập kế hoạch dựa trên dữ liệu của bạn.</p></div>
                <div class="soon-i rv" style="--d:.06s"><span class="lp-chip is-soon">Dự kiến</span><h3>Sao lưu và khôi phục</h3><p>Lưu bản sao dữ liệu và khôi phục khi cần.</p></div>
                <div class="soon-i rv" style="--d:.12s"><span class="lp-chip is-soon">Dự kiến</span><h3>Đồng bộ lịch ngoài</h3><p>Kết nối lịch LifeHub với các dịch vụ lịch khác.</p></div>
            </div>
            <div class="cta-box rv">
                <h2>One workspace. More possibilities.</h2>
                <p>Bắt đầu với những gì LifeHub đã có, và cùng phát triển theo cách bạn sử dụng.</p>
                @if (signedIn)
                {
                    <a class="lp-btn lp-btn-light lp-btn-lg" asp-controller="Dashboard" asp-action="Index">Vào ứng dụng</a>
                }
                else
                {
                    <a class="lp-btn lp-btn-light lp-btn-lg" asp-controller="Auth" asp-action="Register">Bắt đầu với LifeHub</a>
                }
            </div>
        </div>
    </section>
</main>
