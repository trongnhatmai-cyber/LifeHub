@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Tính năng – LifeHub";
    ViewData["LandingPage"] = "features";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
}

@section Styles {
    <link rel="stylesheet" href="~/css/home-index.css" asp-append-version="true" />
}

<main class="lh-home">

    <!-- =====================================================================
         1. BANNER GIỚI THIỆU TỔNG QUAN TÍNH NĂNG
         ===================================================================== -->
    <section class="lh-banner">
        <div class="lh-wrap">
            <div class="lh-banner-top" style="margin-bottom:8px">
                <div class="lh-eyebrow-pill">
                    <b>✦ BỘ CÔNG CỤ TOÀN DIỆN</b>
                    Mọi tính năng bạn cần để Lập kế hoạch · Tập trung · Bứt phá
                </div>

                <h1 class="lh-banner-title">
                    Khám phá chi tiết từng tính năng<br />
                    <span class="lh-grad-text">bên trong hệ sinh thái LifeHub.</span>
                </h1>

                <p class="lh-banner-intro">
                    Từ việc cần làm, lịch trình tổng hợp, đồng hồ Pomodoro và bảng Kanban dự án nhóm cho đến quản lý đa ví, mục tiêu OKR, chuỗi thói quen và Trợ lý AI — mỗi tính năng đều mang màu sắc nhận diện trực quan và tự động liên kết mượt mà với nhau.
                </p>

                <div class="lh-banner-actions">
                    @if (isSignedIn)
                    {
                        <a class="lh-hero-btn primary" asp-controller="Dashboard" asp-action="Index">
                            Vào Bảng điều khiển <span>→</span>
                        </a>
                        <a class="lh-hero-btn" asp-controller="Home" asp-action="Index" asp-fragment="lh-phan-he">
                            Xem 10 phân hệ
                        </a>
                    }
                    else
                    {
                        <a class="lh-hero-btn primary" asp-controller="Auth" asp-action="Register">
                            Trải nghiệm miễn phí ngay <span>→</span>
                        </a>
                        <a class="lh-hero-btn" asp-controller="Home" asp-action="Index" asp-fragment="lh-phan-he">
                            Xem 10 phân hệ
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- =====================================================================
         2. THANH CHUYỂN NHANH ĐA SẮC GIỮA CÁC NHÓM TÍNH NĂNG
         ===================================================================== -->
    <nav class="lh-subnav lh-color-subnav" aria-label="Nhóm tính năng">
        <div class="lh-wrap">
            <a href="#lh-f-study" style="--pill-color:#2563eb;--pill-bg:#eff6ff;--pill-border:#bfdbfe"><i></i>Học tập</a>
            <a href="#lh-f-tasks" style="--pill-color:#ea580c;--pill-bg:#fff7ed;--pill-border:#fed7aa"><i></i>Công việc</a>
            <a href="#lh-f-projects" style="--pill-color:#16a34a;--pill-bg:#f0fdf4;--pill-border:#bbf7d0"><i></i>Dự án</a>
            <a href="#lh-f-time" style="--pill-color:#0d9488;--pill-bg:#f0fdfa;--pill-border:#99f6e4"><i></i>Lịch &amp; Pomodoro</a>
            <a href="#lh-f-money" style="--pill-color:#e11d48;--pill-bg:#fff0f3;--pill-border:#fed5df"><i></i>Tài chính</a>
            <a href="#lh-f-goals" style="--pill-color:#ca8a04;--pill-bg:#fefce8;--pill-border:#fde047"><i></i>Mục tiêu OKR</a>
            <a href="#lh-f-habits" style="--pill-color:#4f46e5;--pill-bg:#eef2ff;--pill-border:#c7d2fe"><i></i>Thói quen</a>
            <a href="#lh-f-notes" style="--pill-color:#7c3aed;--pill-bg:#faf5ff;--pill-border:#e9d5ff"><i></i>Kiến thức</a>
            <a href="#lh-f-life" style="--pill-color:#059669;--pill-bg:#ecfdf5;--pill-border:#a7f3d0"><i></i>Sinh hoạt</a>
            <a href="#lh-f-ai" style="--pill-color:#0284c7;--pill-bg:#f0f9ff;--pill-border:#bae6fd"><i></i>Báo cáo &amp; AI</a>
            <a href="#lh-f-more" style="--pill-color:#0f172a;--pill-bg:#f1f5f9;--pill-border:#cbd5e1"><i></i>Tiện ích chung</a>
        </div>
    </nav>

    <!-- =====================================================================
         3. CHI TIẾT TỪNG NHÓM TÍNH NĂNG THEO MÀU QUẢN LÝ
         ===================================================================== -->
    <section>
        <div class="lh-wrap">
            <div class="lh-modules-stack">

                <!-- 1. HỌC TẬP -->
                <article class="lh-mod-showcase mod-theme-study" id="lh-f-study">
                    <div class="lh-mod-info">
                        <div class="lh-mod-badge-row">
                            <div class="lh-mod-icon"><svg class="lh-i"><use href="#lh-book" /></svg></div>
                            <span class="lh-mod-eyebrow">Tính năng Học tập</span>
                            <span class="lh-mod-color-chip">Xanh Dương Học Thuật</span>
                        </div>
                        <h3>Biết ngay mình đang học tới đâu, không lo sót lịch thi</h3>
                        <p class="lh-mod-desc">
                            Nhập môn học, tín chỉ và bài tập một lần duy nhất. LifeHub tự động tính điểm trung bình môn, ước tính GPA học kỳ và đếm ngược đến ngày thi gần nhất.
                        </p>
                        <ul class="lh-mod-features">
                            <li>Thời khóa biểu lặp lại theo tuần kèm phòng học và giảng viên</li>
                            <li>Điểm từng bài thành phần tự cộng theo trọng số thành điểm môn &amp; GPA</li>
                            <li>Lưu trữ giáo trình, đề cương và tài liệu gắn trực tiếp vào từng môn học</li>
                        </ul>
                        <div class="lh-feat-extra">
                            <strong>Còn có:</strong>
                            <span>Đặt GPA mục tiêu</span>
                            <span>Quản lý nhiều học kỳ</span>
                            <span>Đếm ngược ngày thi</span>
                            <span>% Tiến độ bài tập</span>
                        </div>
                    </div>

                    <div class="lh-mod-preview">
                        <div class="lh-pv-head">
                            <strong>Bảng điểm &amp; Tiến độ học kỳ</strong>
                            <span class="lh-pv-pill">GPA: 3.65 / 4.0</span>
                        </div>
                        <div class="lh-pv-list">
                            <div class="lh-pv-row">
                                <div class="lh-pv-row-main"><b>Cơ sở dữ liệu (3 TC)</b><small>Đã có điểm giữa kỳ &amp; chuyên cần</small></div>
                                <div class="lh-pv-bar"><i style="width:85%"></i></div>
                                <span class="lh-pv-val">8,5</span>
                            </div>
                            <div class="lh-pv-row">
                                <div class="lh-pv-row-main"><b>Lập trình C# nâng cao (4 TC)</b><small>Hoàn thành 7/8 Lab thực hành</small></div>
                                <div class="lh-pv-bar"><i style="width:88%"></i></div>
                                <span class="lh-pv-val">8,8</span>
                            </div>
                            <div class="lh-pv-row">
                                <div class="lh-pv-row-main"><b>Toán rời rạc (3 TC)</b><small>Đã hoàn tất kiểm tra định kỳ</small></div>
                                <div class="lh-pv-bar"><i style="width:91%"></i></div>
                                <span class="lh-pv-val">9,1</span>
                            </div>
                            <div class="lh-pv-row">
                                <div class="lh-pv-row-main"><b>Tiếng Anh học thuật</b><small>Còn 2 bài luận cần nộp tuần này</small></div>
                                <div class="lh-pv-bar"><i style="width:60%;background:#d97706"></i></div>
                                <span class="lh-pv-val" style="color:#b45309">60%</span>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- 2. CÔNG VIỆC -->
                <article class="lh-mod-showcase mod-theme-task is-reverse" id="lh-f-tasks">
                    <div class="lh-mod-info">
                        <div class="lh-mod-badge-row">
                            <div class="lh-mod-icon"><svg class="lh-i"><use href="#lh-check" /></svg></div>
                            <span class="lh-mod-eyebrow">Tính năng Công việc</span>
                            <span class="lh-mod-color-chip">Cam Năng Lượng</span>
                        </div>
                        <h3>Việc nào cũng có chỗ của nó, ưu tiên rõ từng phút</h3>
                        <p class="lh-mod-desc">
                            Ghi nhanh mọi đầu việc cá nhân hoặc nhóm, gắn hạn hoàn thành và cấp độ ưu tiên để hệ thống nhắc bạn đúng thời điểm cần tập trung nhất.
                        </p>
                        <ul class="lh-mod-features">
                            <li>Bốn mức ưu tiên trực quan: Thấp, Trung bình, Cao và Khẩn cấp</li>
                            <li>Chuyển đổi mượt mà giữa Danh sách kiểm và Bảng trạng thái Todo / Doing / Done</li>
                            <li>Tạo danh mục màu sắc riêng, lọc nhanh theo môn học, dự án hoặc mục tiêu</li>
                        </ul>
                        <div class="lh-feat-extra">
                            <strong>Còn có:</strong>
                            <span>Cảnh báo việc quá hạn</span>
                            <span>Giao việc thành viên</span>
                            <span>Bình luận trao đổi</span>
                            <span>Thống kê tỷ lệ xong</span>
                        </div>
                    </div>

                    <div class="lh-mod-preview">
                        <div class="lh-pv-head">
                            <strong>Việc cần làm hôm nay</strong>
                            <span class="lh-pv-pill">04 việc trọng tâm</span>
                        </div>
                        <div class="lh-pv-list">
                            <div class="lh-pv-row">
                                <i class="lh-mini-check done">✓</i>
                                <div class="lh-pv-row-main"><b style="text-decoration:line-through;color:#94a3b8">Nộp bài tập Cơ sở dữ liệu</b><small>Danh mục: Học tập</small></div>
                                <span class="lh-pv-pill soft">Đã xong</span>
                            </div>
                            <div class="lh-pv-row">
                                <i class="lh-mini-check" style="border-color:#ea580c"></i>
                                <div class="lh-pv-row-main"><b>Họp chốt tiến độ đồ án nhóm</b><small>15:00 hôm nay · Dự án</small></div>
                                <span class="lh-pv-pill" style="background:#dc2626">Khẩn cấp</span>
                            </div>
                            <div class="lh-pv-row">
                                <i class="lh-mini-check" style="border-color:#ea580c"></i>
                                <div class="lh-pv-row-main"><b>Viết báo cáo tổng kết tuần</b><small>17:30 hôm nay · Cá nhân</small></div>
                                <span class="lh-pv-pill soft">Cao</span>
                            </div>
                            <div class="lh-pv-row">
                                <i class="lh-mini-check" style="border-color:#ea580c"></i>
                                <div class="lh-pv-row-main"><b>Ôn 30 từ vựng IELTS chủ đề Tech</b><small>20:30 tối nay · Mục tiêu</small></div>
                                <span class="lh-pv-pill soft">Trung bình</span>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- 3. DỰ ÁN NHÓM -->
                <article class="lh-mod-showcase mod-theme-project" id="lh-f-projects">
                    <div class="lh-mod-info">
                        <div class="lh-mod-badge-row">
                            <div class="lh-mod-icon"><svg class="lh-i"><use href="#lh-folder" /></svg></div>
                            <span class="lh-mod-eyebrow">Tính năng Dự án</span>
                            <span class="lh-mod-color-chip">Xanh Lá Cộng Tác</span>
                        </div>
                        <h3>Làm việc nhóm mạch lạc, không còn cảnh hỏi tiến độ từng người</h3>
                        <p class="lh-mod-desc">
                            Chia dự án lớn thành từng hạng mục nhỏ, giao đúng thành viên phụ trách và quan sát tiến độ thực tế trên bảng Kanban theo thời gian thực.
                        </p>
                        <ul class="lh-mod-features">
                            <li>Bảng Kanban kéo thả trực quan với nhãn màu và hạn hoàn thành</li>
                            <li>Mời thành viên qua email, phân vai trò Quản lý (Manager) hoặc Thành viên</li>
                            <li>Theo dõi Cột mốc (Milestones), bình luận, đính kèm tệp và nhật ký hoạt động</li>
                        </ul>
                        <div class="lh-feat-extra">
                            <strong>Còn có:</strong>
                            <span>Cảnh báo dự án sắp trễ</span>
                            <span>Tiến độ % tự tính</span>
                            <span>Duyệt nhiệm vụ</span>
                            <span>Timeline dự án</span>
                        </div>
                    </div>

                    <div class="lh-mod-preview">
                        <div class="lh-pv-head">
                            <strong>Bảng Kanban · Dự án Website</strong>
                            <span class="lh-pv-pill">05 Thành viên</span>
                        </div>
                        <div class="lh-pv-kanban">
                            <div class="lh-pv-kcol">
                                <h5>CẦN LÀM <span>2</span></h5>
                                <div class="lh-pv-kcard">Thiết kế API Báo cáo<small>👤 Bình · Ưu tiên cao</small></div>
                                <div class="lh-pv-kcard">Kiểm thử bảo mật<small>👤 An · Tuần tới</small></div>
                            </div>
                            <div class="lh-pv-kcol">
                                <h5>ĐANG LÀM <span>1</span></h5>
                                <div class="lh-pv-kcard" style="border-color:#16a34a">Đồng bộ bộ nhận diện Logo<small>👤 Minh · Đang xử lý</small></div>
                            </div>
                            <div class="lh-pv-kcol">
                                <h5>HOÀN THÀNH <span>2</span></h5>
                                <div class="lh-pv-kcard">Thiết kế CSDL chuẩn<small>✓ Minh</small></div>
                                <div class="lh-pv-kcard">Khảo sát người dùng<small>✓ Chi</small></div>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- 4. LỊCH & POMODORO -->
                <article class="lh-mod-showcase mod-theme-time is-reverse" id="lh-f-time">
                    <div class="lh-mod-info">
                        <div class="lh-mod-badge-row">
                            <div class="lh-mod-icon"><svg class="lh-i"><use href="#lh-cal" /></svg></div>
                            <span class="lh-mod-eyebrow">Lịch &amp; Tập trung Pomodoro</span>
                            <span class="lh-mod-color-chip">Xanh Ngọc Tập Trung</span>
                        </div>
                        <h3>Một dòng thời gian chung &amp; đồng hồ giữ nhịp tập trung sâu</h3>
                        <p class="lh-mod-desc">
                            Lịch học, kỳ thi, deadline công việc và cuộc họp dự án tự động gộp chung vào một lịch duy nhất. Khi bắt đầu làm việc, bật ngay Pomodoro để loại bỏ sự phân tâm.
                        </p>
                        <ul class="lh-mod-features">
                            <li>Chế độ xem linh hoạt theo Ngày, Tuần, Tháng với mã màu theo phân hệ</li>
                            <li>Tùy chỉnh chu kỳ tập trung sâu (25 phút) cùng phiên nghỉ ngắn và nghỉ dài</li>
                            <li>Gắn phiên Pomodoro với môn học / đầu việc để tự cộng điểm năng suất</li>
                        </ul>
                        <div class="lh-feat-extra">
                            <strong>Còn có:</strong>
                            <span>Sự kiện lặp lại</span>
                            <span>Nhắc trước giờ thi</span>
                            <span>Lịch sử phiên tập trung</span>
                            <span>Đồng bộ lịch ngoài <i class="lh-soon-badge" style="font-style:normal">Sắp có</i></span>
                        </div>
                    </div>

                    <div class="lh-mod-preview">
                        <div class="lh-pv-head">
                            <strong>Phiên tập trung đang chạy</strong>
                            <span class="lh-pv-pill">Chu kỳ 3 / 4</span>
                        </div>
                        <div class="lh-pv-time-split">
                            <div class="lh-pv-pomo">
                                <div>
                                    <strong>18:42</strong>
                                    <span>Ôn Cơ sở dữ liệu</span>
                                </div>
                            </div>
                            <div class="lh-pv-list">
                                <div class="lh-pv-row"><div class="lh-pv-row-main"><b>07:30 · Lớp Mạng máy tính</b><small>Tự động lấy từ Thời khóa biểu</small></div></div>
                                <div class="lh-pv-row"><div class="lh-pv-row-main"><b>14:00 · Thi giữa kỳ Toán rời rạc</b><small>Đã bật nhắc trước 60 phút</small></div></div>
                                <div class="lh-pv-row"><div class="lh-pv-row-main"><b>23:59 · Hạn nộp báo cáo nhóm</b><small>Tự động lấy từ Dự án</small></div></div>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- 5. TÀI CHÍNH -->
                <article class="lh-mod-showcase mod-theme-finance" id="lh-f-money">
                    <div class="lh-mod-info">
                        <div class="lh-mod-badge-row">
                            <div class="lh-mod-icon"><svg class="lh-i"><use href="#lh-wallet" /></svg></div>
                            <span class="lh-mod-eyebrow">Tính năng Tài chính</span>
                            <span class="lh-mod-color-chip">Hồng Ngọc Thịnh Vượng</span>
                        </div>
                        <h3>Quản lý đa ví, cảnh báo ngân sách và nuôi dưỡng quỹ tiết kiệm</h3>
                        <p class="lh-mod-desc">
                            Ghi mỗi khoản thu chi vào đúng ví và danh mục chỉ trong vài giây. Hệ thống tự động đối chiếu hạn mức tháng để cảnh báo ngay khi bạn chi tiêu gần chạm trần.
                        </p>
                        <ul class="lh-mod-features">
                            <li>Quản lý song song Tiền mặt, Tài khoản ngân hàng và Ví điện tử</li>
                            <li>Chuyển tiền nội bộ giữa các ví không làm sai lệch thống kê chi tiêu</li>
                            <li>Theo dõi tiến độ từng Mục tiêu tiết kiệm với biểu tượng và màu sắc riêng</li>
                        </ul>
                        <div class="lh-feat-extra">
                            <strong>Còn có:</strong>
                            <span>Biểu đồ dòng tiền 6 tháng</span>
                            <span>Danh mục thu chi tùy biến</span>
                            <span>Lọc lịch sử theo tháng</span>
                        </div>
                    </div>

                    <div class="lh-mod-preview">
                        <div class="lh-pv-head">
                            <strong>Ngân sách &amp; Quỹ tiết kiệm</strong>
                            <span class="lh-pv-pill">An toàn dòng tiền</span>
                        </div>
                        <div class="lh-pv-list">
                            <div class="lh-pv-row">
                                <div class="lh-pv-row-main"><b>Ăn uống hàng ngày</b><small>2,4 / 3,0 triệu · Chạm ngưỡng cảnh báo</small></div>
                                <div class="lh-pv-bar"><i style="width:80%;background:#d97706"></i></div>
                                <span class="lh-pv-val" style="color:#b45309">80%</span>
                            </div>
                            <div class="lh-pv-row">
                                <div class="lh-pv-row-main"><b>Đi lại &amp; Di chuyển</b><small>0,6 / 1,0 triệu · Trong kế hoạch</small></div>
                                <div class="lh-pv-bar"><i style="width:60%;background:#10b981"></i></div>
                                <span class="lh-pv-val" style="color:#059669">60%</span>
                            </div>
                            <div class="lh-pv-row">
                                <div class="lh-pv-row-main"><b>Mua sắm cá nhân</b><small>1,2 / 1,0 triệu · Đã vượt hạn mức</small></div>
                                <div class="lh-pv-bar"><i style="width:100%;background:#e11d48"></i></div>
                                <span class="lh-pv-val">Vượt</span>
                            </div>
                            <div class="lh-pv-row">
                                <div class="lh-pv-row-main"><b>🎯 Quỹ mua Laptop học tập</b><small>Đã gom 15,0 / 20,0 triệu</small></div>
                                <div class="lh-pv-bar"><i style="width:75%"></i></div>
                                <span class="lh-pv-val">75%</span>
                            </div>
                        </div>
                    </div>
                </article>

                <!-- 6. MỤC TIÊU OKR -->
                <article class="lh-mod-showcase mod-theme-goal is-reverse" id="lh-f-goals">
                    <div class="lh-mod-info">
