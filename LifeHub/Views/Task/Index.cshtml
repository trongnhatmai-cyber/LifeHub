
@model LifeHub.Models.ViewModels.TaskManagement.TaskOverviewViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Tổng quan công việc";
    ViewData["ActivePage"] = "TaskOverview";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/task.css"
          asp-append-version="true" />
}

<div class="task-page task-overview-page">

    <!-- PAGE HEADER -->
    <header class="task-page-header">
        <div>
            <span class="task-eyebrow">WORK MANAGEMENT</span>
            <h1>Tổng quan công việc</h1>
            <p>Theo dõi tiến độ và tình hình công việc của bạn.</p>
        </div>

        <div class="task-page-header__actions">
            <button type="button"
                    class="task-btn task-btn-primary"
                    data-open-task-modal
                    data-modal-mode="create">
                <i class="bi bi-plus-lg"></i>
                + Thêm công việc
            </button>

            <a asp-controller="Task"
            asp-action="Task"
            class="task-btn task-btn-secondary">
                Xem danh sách công việc
            </a>
        </div>
    </header>

    <!-- SUMMARY -->
    <section class="task-summary-grid">

        <article class="task-summary-card">
            <div class="task-summary-card__top">
                <span>Tổng công việc</span>
                <span class="task-summary-badge">TOTAL</span>
            </div>

            <strong>@Model.TotalTasks</strong>
            <small>Tất cả công việc</small>
        </article>

        <article class="task-summary-card">
            <div class="task-summary-card__top">
                <span>Đang thực hiện</span>
                <span class="task-summary-badge">IN PROGRESS</span>
            </div>

            <strong>@Model.InProgressTasksCount</strong>
            <small>Công việc đang xử lý</small>
        </article>

        <article class="task-summary-card">
            <div class="task-summary-card__top">
                <span>Đã hoàn thành</span>
                <span class="task-summary-badge">DONE</span>
            </div>

            <strong>@Model.CompletedTasksCount</strong>
            <small>Công việc đã hoàn tất</small>
        </article>

        <article class="task-summary-card">
            <div class="task-summary-card__top">
                <span>Quá hạn</span>
                <span class="task-summary-badge">OVERDUE</span>
            </div>

            <strong>@Model.OverdueTasksCount</strong>
            <small>Cần được chú ý</small>
        </article>

    </section>

    <!-- TASK SCOPE -->
    <section class="task-panel">
        <div class="task-panel-heading">
            <div>
                <h2>Phạm vi công việc</h2>
                <p>Các nhóm công việc bạn đang quản lý.</p>
            </div>
        </div>

        <div class="task-scope-grid">

            <a asp-controller="Task"
               asp-action="Task"
               asp-route-scope="personal"
               class="task-scope-card">
                <span class="task-scope-card__icon">♧</span>

                <span class="task-scope-card__content">
                    <strong>Cá nhân</strong>
                    <small>Công việc do bạn quản lý</small>
                </span>

                <b>@Model.PersonalTasksCount</b>
            </a>

            <a asp-controller="Task"
               asp-action="Task"
               asp-route-scope="assigned"
               class="task-scope-card">
                <span class="task-scope-card__icon">↙</span>

                <span class="task-scope-card__content">
                    <strong>Được giao cho tôi</strong>
                    <small>Công việc do người khác giao</small>
                </span>

                <b>@Model.AssignedToMeCount</b>
            </a>

            <a asp-controller="Task"
               asp-action="Task"
               asp-route-scope="project"
               class="task-scope-card">
                <span class="task-scope-card__icon">▦</span>

                <span class="task-scope-card__content">
                    <strong>Dự án</strong>
                    <small>Công việc thuộc dự án</small>
                </span>

                <b>@Model.ProjectTasksCount</b>
            </a>

        </div>
    </section>

    <!-- OVERVIEW CONTENT -->
    <div class="task-overview-grid">

        <!-- PROGRESS -->
        <section class="task-panel">
            <div class="task-panel-heading">
                <div>
                    <h2>Tiến độ hoàn thành</h2>
                    <p>Tình trạng các công việc hiện tại.</p>
                </div>
            </div>

            <div class="task-completion-overview">
                <div class="task-completion-number">
                    <strong>@Model.CompletionPercent%</strong>
                    <span>Đã hoàn thành</span>
                </div>

                <div class="task-progress-track">
                    <div class="task-progress-fill"
                         style="width: @Model.CompletionPercent%">
                    </div>
                </div>
            </div>

            <div class="task-status-list">

                @{
                    var statuses = new[]
                    {
                        new { Key = "todo", Label = "Cần làm" },
                        new { Key = "in_progress", Label = "Đang làm" },
                        new { Key = "review", Label = "Chờ duyệt" },
                        new { Key = "done", Label = "Đã hoàn thành" }
                    };
                }

                @foreach (var status in statuses)
                {
                    var count = Model.Tasks.Count(
                        t => t.Status == status.Key);

                    var percent = Model.TotalTasks == 0
                        ? 0
                        : (int)Math.Round(
                            count * 100.0 / Model.TotalTasks);

                    <div class="task-status-item">
                        <div class="task-status-item__heading">
                            <span>@status.Label</span>
                            <strong>@count</strong>
                        </div>

                        <div class="task-progress-track">
                            <div class="task-progress-fill"
                                 style="width: @percent%">
                            </div>
                        </div>
                    </div>
                }

            </div>

            <div class="task-on-time-rate">
                <span>Hoàn thành đúng hạn</span>

                <strong>
                    @(Model.OnTimeCompletionRate.HasValue
                        ? $"{Model.OnTimeCompletionRate}%"
                        : "Chưa có dữ liệu")
                </strong>
            </div>
        </section>

        <!-- RECENT TASKS -->
        <section class="task-panel">
            <div class="task-panel-heading">
                <div>
                    <h2>Công việc gần đây</h2>
                    <p>Những công việc được tạo gần nhất.</p>
                </div>

                <a asp-controller="Task"
                   asp-action="Task"
                   class="task-text-link">
                    Xem tất cả &#8594;
                </a>
            </div>

            <div class="task-recent-list">

                @foreach (var task in Model.RecentTasks)
                {
                    <button type="button"
                            class="task-recent-item"
                            data-open-task-modal
                            data-modal-mode="detail"
                            data-task-id="@task.Id">

                        <span class="task-status-dot @task.Status"></span>

                        <span class="task-recent-item__content">
                            <strong>@task.Title</strong>

                            <small>
                                @task.StatusLabel

                                @if (task.Deadline.HasValue)
                                {
                                    <span>
                                        · Hạn @task.Deadline.Value.ToString("dd/MM/yyyy")
                                    </span>
                                }
                            </small>
                        </span>

                        <span class="task-priority @task.Priority">
                            @task.PriorityLabel
                        </span>
                    </button>
                }

                @if (!Model.RecentTasks.Any())
                {
                    <div class="task-empty-state">
                        <p>Chưa có công việc gần đây.</p>
                    </div>
                }

            </div>
        </section>
    </div>

    <!-- ATTENTION TASKS -->
    <div class="task-overview">
        <section class="task-panel">
            <div class="task-panel-heading">
                <div>
                    <h2>Công việc cần chú ý</h2>
                    <p>Các công việc quá hạn, sắp đến hạn hoặc có ưu tiên cao.</p>
                </div>
            </div>
    
        <div class="task-attention-list">

            @foreach (var task in Model.AttentionTasks)
            {
                <button type="button"
                        class="task-attention-item"
                        data-open-task-modal
                        data-modal-mode="detail"
                        data-task-id="@task.Id">

                    <span class="task-attention-indicator
                        @(task.IsOverdue ? "overdue" : "upcoming")">
                    </span>

                    <span class="task-attention-item__content">
                        <strong>@task.Title</strong>

                        <small>
                            @if (task.IsOverdue)
                            {
                                <span>Đã quá hạn</span>
                            }
                            else if (task.Deadline.HasValue)
                            {
                                <span>
                                    Hạn @task.Deadline.Value.ToString("dd/MM/yyyy")
                                </span>
                            }
                            else
                            {
                                <span>Ưu tiên cao</span>
                            }
                        </small>
                    </span>

                    <span class="task-priority @task.Priority">
                        @task.PriorityLabel
                    </span>
                </button>
            }

            @if (!Model.AttentionTasks.Any())
            {
                <div class="task-empty-state">
                    <p>Hiện không có công việc cần chú ý.</p>
                </div>
            }

        </div>
    </section>

    <!-- SHARED TASK MODAL -->
    @await Html.PartialAsync(
        "_TaskModal",
        new LifeHub.Models.ViewModels.TaskManagement.TaskInputModels(),
        new ViewDataDictionary(ViewData)
        {
            ["Projects"] = Model.Projects,
            ["Categories"] = Model.Categories,
            ["Tasks"] = Model.Tasks
        })
    </div>
</div>

@section Scripts {
    <script src="~/js/task.js" asp-append-version="true"></script>
}
