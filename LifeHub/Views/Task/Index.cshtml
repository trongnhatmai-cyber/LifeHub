@model LifeHub.Models.ViewModels.TaskManagement.TaskViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý công việc";
    ViewData["ActivePage"] = "Task";

    var columns = new[]
    {
        (Key: "todo", Icon: "📋", Label: "Cần làm"),
        (Key: "in_progress", Icon: "⚡", Label: "Đang làm"),
        (Key: "review", Icon: "🔍", Label: "Chờ duyệt"),
        (Key: "done", Icon: "✓", Label: "Đã xong")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/task.css" asp-append-version="true" />
}

<div class="task-page">
    <!-- TIÊU ĐỀ PHÂN HỆ CÔNG VIỆC -->
    <header class="task-heading">
        <div>
            <span class="task-label">TASK MANAGEMENT · KANBAN & PRODUCTIVITY</span>
            <h1>Công việc của bạn</h1>
            <p>Sắp xếp danh sách việc cần làm, kéo thả trạng thái và kiểm soát tiến độ hoàn thành.</p>
        </div>

        <div class="heading-actions">
            <button type="button" class="task-btn primary" id="createTaskBtn">+ Thêm công việc</button>
        </div>
    </header>

    <!-- 4 THẺ CHỈ SỐ -->
    <section class="task-summary">
        <div class="summary-card">
            <div class="summary-top"><span>Tổng số việc</span><span class="summary-badge">TỔNG CỘNG</span></div>
            <h2 data-summary="total">@Model.TotalTasks</h2>
            <p>Nhiệm vụ trên hệ thống</p>
        </div>

        <div class="summary-card">
            <div class="summary-top"><span>Cần làm ngay</span><span class="summary-badge">CẦN LÀM</span></div>
            <h2 data-summary="todo">@Model.TodoTasksCount.ToString("00")</h2>
            <p>Chưa bắt đầu thực hiện</p>
        </div>

        <div class="summary-card">
            <div class="summary-top"><span>Đang thực hiện</span><span class="summary-badge">TIẾN HÀNH</span></div>
            <h2 data-summary="in_progress">@Model.InProgressTasksCount.ToString("00")</h2>
            <p>Đang trong quy trình</p>
        </div>

        <div class="summary-card">
            <div class="summary-top"><span>Đã hoàn thành</span><span class="summary-badge">XONG</span></div>
            <h2 data-summary="done">@Model.CompletedTasksCount.ToString("00")</h2>
            <p>Đã nghiệm thu kết quả</p>
        </div>
    </section>

    <!-- THANH TÌM KIẾM VÀ BỘ LỌC -->
    <section class="task-toolbar" aria-label="Tìm kiếm và lọc công việc">
        <input type="search" id="taskSearch" placeholder="Tìm công việc, dự án..." aria-label="Tìm công việc" autocomplete="off" />

        <select id="taskPriorityFilter" aria-label="Lọc theo mức ưu tiên">
            <option value="">Mọi mức ưu tiên</option>
            <option value="urgent">Khẩn cấp</option>
            <option value="high">Cao</option>
            <option value="medium">Trung bình</option>
            <option value="low">Thấp</option>
        </select>

        <select id="taskProjectFilter" aria-label="Lọc theo dự án">
            <option value="">Mọi dự án</option>
            @foreach (var project in Model.ProjectNames)
            {
                <option value="@project">@project</option>
            }
        </select>
    </section>

    <!-- BẢNG KANBAN 4 CỘT -->
    <div class="kanban-board">
        @foreach (var col in columns)
        {
            var items = Model.Tasks.Where(t => t.Status == col.Key).ToList();

            <section class="kanban-column" data-column="@col.Key" aria-label="@col.Label">
                <div class="column-head">
                    <span>@col.Icon @col.Label</span>
                    <span class="summary-badge" data-column-count>@items.Count</span>
                </div>

                <div class="column-body" data-dropzone="@col.Key">
                    @foreach (var t in items)
                    {
                        var search = $"{t.Title} {t.Description} {t.ProjectName}".ToLowerInvariant();

                        <article class="task-card-item @(t.IsDone ? "is-done" : "")" draggable="true"
                                 data-id="@t.Id" data-status="@t.Status" data-priority="@t.Priority"
                                 data-project="@t.ProjectName" data-search="@search">
                            <div class="task-card-top">
                                <span class="task-project">@t.ProjectName</span>
                                <span class="badge-priority @t.Priority">@t.PriorityLabel</span>
                            </div>

                            <h4>@t.Title</h4>
                            <p>@t.Description</p>

                            @if (t.Tags.Any())
                            {
                                <div class="task-tags">
                                    @foreach (var tag in t.Tags)
                                    {
                                        <span class="task-tag" style="--tag-color:@tag.Color">@tag.Name</span>
                                    }
                                </div>
                            }

                            @if (t.SubtaskTotal > 0)
                            {
                                <div class="task-progress" title="Việc con đã hoàn thành">
                                    <div class="bar"><i style="width:@t.SubtaskPercent%"></i></div>
                                    <span>@(t.SubtaskDone + "/" + t.SubtaskTotal)</span>
                                </div>
                            }

                            <div class="task-foot">
                                <span class="task-meta">
                                    @if (t.CommentCount > 0) { <span>💬 @t.CommentCount</span> }
                                    @if (t.EstimatedMinutes.HasValue) { <span>⏱ @t.EstimateLabel</span> }
                                </span>
                                <span class="task-deadline @(t.IsOverdue ? "overdue" : "")">@(t.Deadline.HasValue ? t.Deadline.Value.ToString("dd/MM") : "—")</span>
                            </div>
                        </article>
                    }

                    <div class="column-empty" hidden="@items.Any()">Không có công việc</div>
                </div>
            </section>
        }
    </div>

    <!-- HỘP THOẠI (chỉ mô phỏng giao diện, chưa lưu dữ liệu) -->
    <partial name="_TaskModals" model="Model" />
    <div class="task-toast" id="taskToast" role="status" hidden></div>
</div>

@section Scripts {
    <script src="~/js/task.js" asp-append-version="true"></script>
}
