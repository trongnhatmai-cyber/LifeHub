@model string
@* Hộp thoại xác nhận xóa dùng chung. Model là tên action POST, VD: DeleteCourse. Nút mở truyền data-id và data-name. *@
<div class="study-modal" id="deleteModal" role="dialog" aria-modal="true" aria-labelledby="deleteModalTitle" hidden>
    <div class="study-modal-box">
        <div class="study-modal-head">
            <h3 id="deleteModalTitle">Xác nhận xóa</h3>
            <button type="button" class="study-modal-close" data-close aria-label="Đóng">&times;</button>
        </div>
        <p class="study-note">Bạn có chắc muốn xóa <strong data-text="name"></strong>? Thao tác này không thể hoàn tác.</p>
        <form asp-action="@Model" method="post" data-simulate>
            <input type="hidden" name="Id" />
            <p class="study-note">Bản mô phỏng giao diện: dữ liệu chưa được lưu.</p>
            <div class="study-modal-foot">
                <button type="button" class="study-btn" data-close>Hủy</button>
                <button type="submit" class="study-btn danger">Xóa</button>
            </div>
        </form>
    </div>
</div>
