@model LifeHub.Models.ViewModels.StudyManagement.StudyViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Quản lý học tập";
    ViewData["ActivePage"] = "Study";

    // Khởi tạo dữ liệu mẫu nếu Controller chưa truyền Model (chuẩn Front-End)
    var m = Model ?? new LifeHub.Models.ViewModels.StudyManagement.StudyViewModel
    {
        CurrentGpa = 3.42m,
        ActiveCoursesCount = 5,
        TotalCredits = 16,
        PendingAssignmentsCount = 3,
        NextExamDays = 3,
        NextExamName = "Toán rời rạc",
        Courses = new List<LifeHub.Models.ViewModels.StudyManagement.StudyCourseItem>
        {
            new() { Id = 1, Code = "NET108", Name = "Lập trình C# nâng cao", Credits = 3, Instructor = "ThS. Nguyễn Văn A", Room = "P.B2-304", AssignmentProgressPercent = 70, Status = "Đang học" },
            new() { Id = 2, Code = "DBI202", Name = "Cơ sở dữ liệu", Credits = 3, Instructor = "TS. Trần Văn B", Room = "P.A1-201", AssignmentProgressPercent = 55, Status = "Đang học" },
            new() { Id = 3, Code = "SWE301", Name = "Kiểm thử phần mềm", Credits = 3, Instructor = "ThS. Lê Thị C", Room = "Lab 2", AssignmentProgressPercent = 40, Status = "Đang học" },
            new() { Id = 4, Code = "NW201", Name = "Mạng máy tính", Credits = 3, Instructor = "ThS. Hoàng Văn D", Room = "P.B1-105", AssignmentProgressPercent = 85, Status = "Đang học" },
            new() { Id = 5, Code = "ENG202", Name = "Tiếng Anh chuyên ngành", Credits = 4, Instructor = "ThS. Phạm Thu E", Room = "P.C3-402", AssignmentProgressPercent = 60, Status = "Đang học" }
        },
        Schedule = new List<LifeHub.Models.ViewModels.StudyManagement.StudyScheduleDay>
        {
            new() { DayName = "T2", Events = new() { new() { Subject = "Mạng máy tính", Time = "07:30 - 10:00", Room = "B1-105" }, new() { Subject = "Tiếng Anh", Time = "13:00 - 15:00", Room = "C3-402" } } },
            new() { DayName = "T3", Events = new() { new() { Subject = "Cơ sở dữ liệu", Time = "09:00 - 11:30", Room = "A1-201" } } },
            new() { DayName = "T4", Events = new() { new() { Subject = "Lập trình C#", Time = "07:30 - 11:00", Room = "B2-304" } } },
            new() { DayName = "T5", Events = new() { new() { Subject = "Kiểm thử phần mềm", Time = "13:30 - 16:00", Room = "Lab 2" } } },
            new() { DayName = "T6", Events = new() { new() { Subject = "Tự học & Thư viện", Time = "08:00 - 11:00", Room = "Thư viện" } } },
            new() { DayName = "T7", Events = new() { new() { Subject = "Họp nhóm đồ án", Time = "14:00 - 16:00", Room = "Online" } } },
            new() { DayName = "CN", Events = new() }
        },
        Assignments = new List<LifeHub.Models.ViewModels.StudyManagement.StudyAssignmentItem>
        {
            new() { Id = 1, Title = "Lab 4 - Xây dựng View và ViewModel", CourseName = "Lập trình C#", DueDate = DateTime.Now.AddDays(2), WeightPercent = 10, IsSubmitted = false },
            new() { Id = 2, Title = "Assignment 1 - Thiết kế Database", CourseName = "Cơ sở dữ liệu", DueDate = DateTime.Now.AddDays(4), WeightPercent = 20, IsSubmitted = false },
            new() { Id = 3, Title = "Quiz 2 - Kiểm thử hộp đen", CourseName = "Kiểm thử", DueDate = DateTime.Now.AddDays(1), WeightPercent = 10, IsSubmitted = false },
            new() { Id = 4, Title = "Bài tập Lab 3 - Thiết lập Routing", CourseName = "Mạng máy tính", DueDate = DateTime.Now.AddDays(-2), WeightPercent = 10, IsSubmitted = true, Score = 9.5m }
        }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/study.css" asp-append-version="true" />
}

<div class="study-page">
    <!-- TIÊU ĐỀ PHÂN HỆ HỌC TẬP -->
    <header class="study-heading">
        <div>
            <span class="study-label">STUDY MANAGEMENT · HỌC KỲ 1 · 2026-2027</span>
            <h1>Học tập của bạn</h1>
            <p>Môn học, thời khóa biểu, bài tập và theo dõi điểm số trong một nơi.</p>
        </div>

        <div class="heading-actions">
            <button type="button" class="study-btn" id="addSubjectBtn">
                + Thêm môn học
            </button>
            <button type="button" class="study-btn primary" id="addAssignmentBtn">
                + Thêm bài tập
            </button>
        </div>
    </header>

    <!-- 4 THẺ CHỈ SỐ PASTEL XANH DƯƠNG -->
    <section class="study-summary">
        <div class="summary-card">
            <div class="summary-top">
                <span>Điểm trung bình (GPA)</span>
                <span class="summary-badge">HỌC KỲ NÀY</span>
            </div>
            <h2>@m.CurrentGpa.ToString("F2")</h2>
            <p>Thang điểm 4 · Mục tiêu 3.6</p>
        </div>

        <div class="summary-card">
            <div class="summary-top">
                <span>Môn đang học</span>
                <span class="summary-badge">TÍN CHỈ</span>
            </div>
            <h2>0@m.ActiveCoursesCount</h2>
            <p>Tổng cộng @m.TotalCredits tín chỉ</p>
        </div>

        <div class="summary-card">
            <div class="summary-top">
                <span>Bài tập chưa nộp</span>
                <span class="summary-badge">DEADLINE</span>
            </div>
            <h2>@m.PendingAssignmentsCount</h2>
            <p>Cần hoàn thành trong tuần</p>
        </div>

        <div class="summary-card">
            <div class="summary-top">
                <span>Kỳ thi gần nhất</span>
                <span class="summary-badge">LỊCH THI</span>
            </div>
            <h2>@m.NextExamDays ngày</h2>
            <p>Môn @m.NextExamName</p>
        </div>
    </section>

    <!-- KHỐI LƯỚI NỘI DUNG CHÍNH (2 CỘT CHUẨN) -->
    <div class="study-grid">
        <!-- CỘT TRÁI: THỜI KHÓA BIỂU TUẦN -->
        <div class="study-card">
            <div class="section-heading">
                <div>
                    <h3>Thời khóa biểu tuần</h3>
                    <p>Lịch học lặp lại theo tuần</p>
                </div>
                <span class="summary-badge">HK1 2026-2027</span>
            </div>

            <div class="timetable-grid">
                @foreach (var day in m.Schedule)
                {
                    <div class="timetable-day">
                        <div class="day-head">@day.DayName</div>
                        @if (day.Events.Any())
                        {
                            @foreach (var ev in day.Events)
                            {
                                <div class="timetable-event">
                                    @ev.Subject
                                    <small>@ev.Time · @ev.Room</small>
                                </div>
                            }
                        }
                        else
                        {
                            <span style="font-size:10px;color:var(--study-muted);text-align:center;margin:auto;">Nghỉ</span>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- CỘT PHẢI: MÔN HỌC & TIẾN ĐỘ -->
        <div class="study-card">
            <div class="section-heading">
                <div>
                    <h3>Tiến độ môn học</h3>
                    <p>Hoàn thành bài tập & đánh giá</p>
                </div>
                <button type="button" class="study-btn" style="padding:4px 10px;font-size:12px;min-height:30px;">
                    Chi tiết
                </button>
            </div>

            <div>
                @foreach (var course in m.Courses)
                {
                    <div class="course-item">
                        <div>
                            <div class="course-code">@course.Code – @course.Name</div>
                            <div style="font-size:11px;color:var(--study-muted);">@course.Credits tín chỉ · @course.Instructor</div>
                        </div>

                        <div class="course-progress">
                            <div style="display:flex;justify-content:space-between;font-size:11px;font-weight:700;">
                                <span>Tiến độ</span>
                                <span style="color:var(--study-accent);">@course.AssignmentProgressPercent%</span>
                            </div>
                            <div class="bar">
                                <i style="width:@course.AssignmentProgressPercent%;"></i>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- DANH SÁCH BÀI TẬP VÀ LỊCH THI -->
    <section class="study-card" style="margin-top: 18px;">
        <div class="section-heading">
            <div>
                <h3>Bài tập & Nhiệm vụ học tập</h3>
                <p>Theo dõi hạn nộp bài và kết quả điểm số</p>
            </div>
            <button type="button" class="study-btn primary" id="addAssignmentBtn2">
                + Thêm bài tập
            </button>
        </div>

        <div style="overflow-x:auto;">
            <table class="study-table">
                <thead>
                    <tr>
                        <th>TÊN BÀI TẬP / NHIỆM VỤ</th>
                        <th>MÔN HỌC</th>
                        <th>HẠN NỘP</th>
                        <th>TRỌNG SỐ</th>
                        <th>TRẠNG THÁI</th>
                        <th style="text-align:right;">ĐIỂM SỐ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var asg in m.Assignments)
                    {
                        <tr>
                            <td style="font-weight:600;">@asg.Title</td>
                            <td><span class="summary-badge">@asg.CourseName</span></td>
                            <td style="color:var(--study-muted);">@asg.DueDate.ToString("dd/MM/yyyy")</td>
                            <td>@asg.WeightPercent%</td>
                            <td>
                                @if (asg.IsSubmitted)
                                {
                                    <span style="font-size:11px;font-weight:700;color:#10b981;">✓ Đã nộp</span>
                                }
                                else
                                {
                                    <span style="font-size:11px;font-weight:700;color:var(--study-accent);">Chưa nộp</span>
                                }
                            </td>
                            <td style="text-align:right;font-weight:750;">
                                @(asg.Score.HasValue ? asg.Score.Value.ToString("F1") + " / 10" : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>
