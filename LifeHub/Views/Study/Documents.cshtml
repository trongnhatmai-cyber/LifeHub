@model LifeHub.Models.ViewModels.StudyManagement.StudyDocumentsPageViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Tài liệu học tập";
    ViewData["ActivePage"] = "StudyDocument";
}

@section Styles {
    <link rel="stylesheet" href="~/css/study.css" asp-append-version="true" />
}

<div class="study-page" data-module="documents">
    <header class="study-heading">
        <div>
            <span class="study-label">TÀI LIỆU HỌC TẬP</span>
            <h1>Tài liệu theo môn học</h1>
            <p>Giáo trình, slide, liên kết và ghi chú được gom theo từng môn.</p>
        </div>
        <div class="heading-actions">
            <button type="button" class="study-btn primary" data-open="documentModal" data-mode="create" data-title="Thêm tài liệu">+ Thêm tài liệu</button>
        </div>
    </header>

    <section class="study-card">
        <form method="get" asp-action="Documents" class="study-toolbar">
            <input type="search" name="q" value="@Model.Q" placeholder="Tìm tài liệu..." aria-label="Tìm tài liệu" />
            <select name="courseId" aria-label="Lọc môn học" data-autosubmit>
                <option value="">Mọi môn học</option>
                @foreach (var c in Model.Courses) { <option value="@c.Id" selected="@(Model.CourseId == c.Id)">@c.Code - @c.Name</option> }
            </select>
            <select name="kind" aria-label="Lọc loại tài liệu" data-autosubmit>
                <option value="all" selected="@(Model.Kind == "all")">Mọi loại</option>
                <option value="pdf" selected="@(Model.Kind == "pdf")">PDF</option>
                <option value="slide" selected="@(Model.Kind == "slide")">Slide</option>
                <option value="link" selected="@(Model.Kind == "link")">Liên kết</option>
                <option value="video" selected="@(Model.Kind == "video")">Video</option>
                <option value="note" selected="@(Model.Kind == "note")">Ghi chú</option>
            </select>
            <button type="submit" class="study-btn">Lọc</button>
            @if (Model.HasFilter) { <a asp-action="Documents" class="study-btn">Xóa lọc</a> }
        </form>

        <p class="study-count">Hiển thị @Model.Items.Count / @Model.TotalCount tài liệu</p>

        <div class="doc-grid">
            @foreach (var d in Model.Items)
            {
                <article class="doc-card" style="--course-color:@d.CourseColor">
                    <div class="course-card-top"><span class="summary-badge">@d.CourseCode</span><span class="doc-kind">@d.KindLabel · @d.SourceLabel</span></div>
                    <h3>@d.Title</h3>
                    @if (!string.IsNullOrEmpty(d.Note)) { <p class="course-meta">@d.Note</p> }
                    <p class="course-meta">Thêm ngày @d.AddedAt.ToString("dd/MM/yyyy")@(string.IsNullOrEmpty(d.SizeLabel) ? "" : " · " + d.SizeLabel)</p>
                    <div class="card-actions">
                        @if (d.Source == "content")
                        {
                            <a class="study-btn small" href="@d.Url">Đọc</a>
                            <a class="study-btn small" asp-action="ExportDocument" asp-route-id="@d.Id">Tải .doc</a>
                        }
                        else if (d.Source == "file")
                        {
                            <a class="study-btn small" href="@d.Url" target="_blank" rel="noopener noreferrer">Mở</a>
                            <a class="study-btn small" asp-action="OpenDocument" asp-route-id="@d.Id" asp-route-download="true">Tải về</a>
                        }
                        else
                        {
                            <a class="study-btn small" href="@d.Url" target="_blank" rel="noopener noreferrer">Mở</a>
                        }
                        <button type="button" class="study-btn small" data-open="deleteModal" data-mode="delete" data-id="@d.Id" data-name="@d.Title">Xóa</button>
                    </div>
                </article>
            }
        </div>
        @if (!Model.Items.Any()) { <div class="study-empty">Không có tài liệu phù hợp.</div> }
    </section>

    <div class="study-modal" id="documentModal" role="dialog" aria-modal="true" aria-labelledby="documentModalTitle" hidden>
        <div class="study-modal-box wide">
            <div class="study-modal-head">
                <h3 id="documentModalTitle" data-modal-title>Thêm tài liệu</h3>
                <button type="button" class="study-modal-close" data-close aria-label="Đóng">&times;</button>
            </div>
            <form asp-action="CreateDocument" method="post" enctype="multipart/form-data">
                <div class="study-form-grid">
                    <div class="field full"><label for="dTitle">Tên tài liệu</label><input id="dTitle" name="Title" maxlength="200" required /></div>
                    <div class="field">
                        <label for="dCourse">Môn học</label>
                        <select id="dCourse" name="CourseId" required>
                            <option value="" disabled selected>Chọn môn học</option>
                            @foreach (var c in Model.Courses) { <option value="@c.Id">@c.Code - @c.Name</option> }
                        </select>
                    </div>
                    <div class="field">
                        <label for="dKind">Loại</label>
                        <select id="dKind" name="Kind" required>
                            <option value="pdf">PDF</option><option value="slide">Slide</option><option value="link">Liên kết</option>
                            <option value="video">Video</option><option value="note">Ghi chú</option>
                        </select>
                    </div>
                    <div class="field full">
                        <label for="dFile">Tệp từ máy tính</label>
                        <input id="dFile" name="File" type="file" data-max-mb="20"
                               accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.md,.png,.jpg,.jpeg,.webp,.mp4" />
                        <small>PDF, Word, PowerPoint, Excel, ảnh, văn bản hoặc MP4 · tối đa 20 MB.</small>
                    </div>
                    <div class="field full">
                        <label id="dContentLabel">Nội dung (soạn như một tệp Word)</label>
                        <partial name="_StudyEditor" model='"d"' />
                        <small>Không bắt buộc. Có thể đọc lại trong web hoặc tải về dạng .doc.</small>
                    </div>
                    <div class="field full"><label for="dUrl">Hoặc đường dẫn trực tuyến</label><input id="dUrl" name="Url" maxlength="500" placeholder="https://..." /><small>Cần ít nhất một trong ba: tệp, nội dung hoặc đường dẫn.</small></div>
                    <div class="field full"><label for="dNote">Ghi chú ngắn</label><input id="dNote" name="Note" maxlength="255" /></div>
                </div>
                <div class="study-modal-foot">
                    <button type="button" class="study-btn" data-close>Hủy</button>
                    <button type="submit" class="study-btn primary">Thêm tài liệu</button>
                </div>
            </form>
        </div>
    </div>

    <partial name="_StudyDeleteModal" model='"DeleteDocument"' />
</div>

@section Scripts {
    <script src="~/js/study.js" asp-append-version="true"></script>
}
